{
    "name": "capell-app/theme-agency",
    "description": "Agency is a first-party Capell theme for portfolio directories, award-style collections, creator profiles, filters, galleries, and portfolio education.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "capell-app/core": "^1.0.12",
        "capell-app/theme-foundation": "^1.0",
        "capell-app/frontend": "^1.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^1.0 || ^4.0 || ^5.0",
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Capell\\ThemeAgency\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\ThemeAgency\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\ThemeAgency\\AgencyThemeServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "homepage": "https://github.com/capell-app/theme-agency",
    "keywords": [
        "capell",
        "cms",
        "laravel",
        "theme"
    ],
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/theme-agency"
    }
}
