{
    "name": "capell-app/capell-packages",
    "description": "Capell 4 Packages",
    "home": "https://capell.app",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Howdu",
            "email": "capell.app26@gmail.com",
            "role": "Developer"
        }
    ],
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare",
            "CACHE_STORE=array \"$PHP_BINARY\" vendor/bin/testbench package:discover --ansi",
            "@patch:pest-shards"
        ],
        "patch:pest-shards": "@php scripts/patch-pest-shards.php",
        "rector": "@php vendor/bin/rector",
        "rector:changed": "bash ./scripts/rector-changed.sh",
        "rector:all": "XDEBUG_MODE=off \"$PHP_BINARY\" vendor/bin/rector --no-progress-bar",
        "rector:all:check": "XDEBUG_MODE=off \"$PHP_BINARY\" vendor/bin/rector --no-progress-bar --dry-run",
        "rector:check": "bash ./scripts/rector-changed.sh --dry-run",
        "lint": "@php vendor/bin/pint --parallel packages tests",
        "cs:fix": "@lint",
        "cs:check": "@php vendor/bin/pint --parallel --test packages tests",
        "lint:changed": "zsh ./scripts/lint-changed.sh",
        "analyze": "@php -d opcache.enable_cli=1 vendor/bin/phpstan analyse --memory-limit=4G --configuration=phpstan.neon",
        "phpstan": "@analyze",
        "phpstan:baseline-check": "bash scripts/check-phpstan-baseline-growth.sh",
        "phpstan:deprecations": "@php -d opcache.enable_cli=1 vendor/bin/phpstan analyse --memory-limit=4G --configuration=phpstan/deprecations.neon",
        "prettier": "npx prettier --write \"packages/**/*.{css,js,yml,json,md,blade.php}\"",
        "prettier:check": "npx prettier --check \"packages/**/*.{css,js,yml,json,md,blade.php}\"",
        "eslint": "npx eslint 'packages/**/resources/js/**/*.js' --max-warnings=0",
        "docs:check": "@php scripts/audit-package-docs.php",
        "docs:check:strict": "@php scripts/audit-package-docs.php --strict-structure",
        "docs:rewrite-readmes": "@php scripts/generate-package-readmes.php",
        "docs:rewrite-readmes:check": "@php scripts/generate-package-readmes.php --check",
        "manifest:check": "@php scripts/audit-manifest-v3.php",
        "check:composer-paths": "@php scripts/check-composer-local-paths.php",
        "check:composer-lock": "composer validate --no-check-publish",
        "security:audit": "composer audit --locked",
        "security:package-audit": "@php scripts/audit-package-security.php",
        "security:secrets": "@php scripts/scan-secrets.php",
        "security:dependencies": [
            "@security:audit",
            "npm audit --audit-level=high",
            "if [ -f packages/frontend-optimizer/package-lock.json ]; then npm --prefix packages/frontend-optimizer audit --audit-level=high; fi"
        ],
        "security:contracts": [
            "@php scripts/audit-package-security.php",
            "@php -d memory_limit=1536M vendor/bin/pest tests/Packages/Security --configuration=phpunit.xml",
            "@security:surface-report:check"
        ],
        "security:surface-report": "@php scripts/generate-package-security-surface-report.php",
        "security:surface-report:check": "@php scripts/generate-package-security-surface-report.php --check",
        "security:all": [
            "@security:dependencies",
            "@security:secrets",
            "@security:contracts"
        ],
        "skill:inspect": "bash scripts/php-modernization-skill.sh inspect --format json",
        "skill:verify": "bash scripts/php-modernization-skill.sh verify --format json --summary --no-cache",
        "skill:verify:sarif": "bash scripts/php-modernization-skill.sh verify --format sarif --no-cache",
        "skill:modernize:dry-run": "bash scripts/php-modernization-skill.sh modernize --mode dry-run --tools rector,phpstan",
        "skill:qa": [
            "@skill:inspect",
            "@cs:check",
            "@phpstan",
            "@security:audit",
            "@skill:verify"
        ],
        "preflight": [
            "@check:composer-paths",
            "@lint:changed"
        ],
        "preflight:all": [
            "@php -r \"echo PHP_EOL . 'Checking Composer path repositories...' . PHP_EOL;\"",
            "@check:composer-paths",
            "@php -r \"echo PHP_EOL . 'Checking Composer lock file...' . PHP_EOL;\"",
            "@check:composer-lock",
            "@php -r \"echo PHP_EOL . 'Checking Rector...' . PHP_EOL;\"",
            "@rector:all:check",
            "@php -r \"echo PHP_EOL . 'Checking Pint...' . PHP_EOL;\"",
            "@cs:check",
            "@php -r \"echo PHP_EOL . 'Checking Prettier...' . PHP_EOL;\"",
            "@prettier:check",
            "@php -r \"echo PHP_EOL . 'Running ESLint...' . PHP_EOL;\"",
            "@eslint",
            "@php -r \"echo PHP_EOL . 'Running PHPStan...' . PHP_EOL;\"",
            "@analyze",
            "@php -r \"echo PHP_EOL . 'Checking PHPStan baseline...' . PHP_EOL;\"",
            "@phpstan:baseline-check",
            "@php -r \"echo PHP_EOL . 'Running Composer audit...' . PHP_EOL;\"",
            "@security:audit",
            "@php -r \"echo PHP_EOL . 'Running package security contracts...' . PHP_EOL;\"",
            "@security:contracts",
            "@check:pest-shards",
            "@php -r \"echo PHP_EOL . 'Running Pest...' . PHP_EOL;\"",
            "@test:preflight"
        ],
        "quality:all": [
            "@preflight:all",
            "@coverage",
            "@test:mutate:ci"
        ],
        "test:unit": "@php -d memory_limit=1536M -d max_execution_time=0 -d pcov.enabled=0 vendor/bin/pest --colors=always --compact --configuration=phpunit.xml",
        "test:group": "@php -d memory_limit=1536M -d max_execution_time=0 -d pcov.enabled=0 vendor/bin/pest --colors=always --compact --group=${PEST_GROUP:-unit} --configuration=phpunit.xml",
        "test:debug": "@php -d memory_limit=1536M -d max_execution_time=0 -d pcov.enabled=0 vendor/bin/pest --colors=always --debug --stop-on-defect --configuration=phpunit.xml",
        "test:debug:group": "@php -d memory_limit=1536M -d max_execution_time=0 -d pcov.enabled=0 vendor/bin/pest --colors=always --debug --stop-on-defect --group=${PEST_GROUP:-unit} --configuration=phpunit.xml",
        "test:fast": "@php -d memory_limit=1536M -d max_execution_time=0 -d pcov.enabled=0 vendor/bin/pest --colors=always --compact --shard=${PEST_SHARD:-1/1} --stop-on-error --stop-on-failure --configuration=phpunit.xml",
        "test:fast:ci": "@php -d memory_limit=1536M -d max_execution_time=0 -d pcov.enabled=0 vendor/bin/pest --colors=always --compact --shard=${PEST_SHARD:-1/1} --configuration=phpunit.xml",
        "test:preflight": "@php scripts/run-pest-shards.php",
        "test:preflight:full": "@php scripts/run-pest-shards.php full",
        "test:preflight:serial": "@php -d memory_limit=1536M -d max_execution_time=0 -d pcov.enabled=0 vendor/bin/pest --colors=always --compact --stop-on-error --stop-on-failure --configuration=phpunit.xml",
        "test:all": "@php -d memory_limit=1536M -d max_execution_time=0 -d pcov.enabled=0 vendor/bin/pest --colors=always --compact --stop-on-error --stop-on-failure --configuration=phpunit.xml",
        "test:all:ci": "@php -d memory_limit=1536M -d max_execution_time=0 -d pcov.enabled=0 vendor/bin/pest --colors=always --compact --configuration=phpunit.xml",
        "test:shards": "@php -d memory_limit=1536M -d max_execution_time=0 -d pcov.enabled=0 vendor/bin/pest --colors=always --compact --update-shards --configuration=phpunit.xml",
        "test:profile": "@php scripts/profile-pest-tests.php",
        "check:pest-shards": "@php -r \"return file_exists('tests/.pest/shards.json') ? 0 : 1;\"",
        "test:types": "@php vendor/bin/pest --configuration=phpunit.xml --type-coverage",
        "test": [
            "@clear",
            "@prepare",
            "@test:preflight"
        ],
        "coverage:blade": "@php -d memory_limit=4G -d max_execution_time=0 vendor/bin/pest --blade-coverage --parallel --processes=${PEST_PROCESSES:-4} --colors=always --configuration=phpunit.xml",
        "coverage": [
            "@prepare",
            "CACHE_STORE=array \"$PHP_BINARY\" vendor/bin/testbench optimize --except=routes --ansi",
            "@php -d memory_limit=4G -d pcov.enabled=1 -d pcov.directory=packages vendor/bin/pest --coverage --min=90 --colors=always --configuration=phpunit.xml"
        ],
        "coverage-report": [
            "rm -rf .cache/phpunit/code-coverage",
            "@prepare",
            "CACHE_STORE=array \"$PHP_BINARY\" vendor/bin/testbench optimize --except=routes --ansi",
            "@php -d memory_limit=4G -d pcov.enabled=1 -d pcov.directory=packages vendor/bin/pest --coverage --coverage-html=coverage --colors=always --configuration=phpunit.xml"
        ],
        "test:mutate": "@php -d memory_limit=4G -d pcov.enabled=1 -d pcov.directory=packages vendor/bin/pest --mutate --covered-only --class='Capell' --parallel --processes=${PEST_PROCESSES:-4} --colors=always --configuration=phpunit.xml",
        "test:mutate:ci": "@php -d memory_limit=4G -d pcov.enabled=1 -d pcov.directory=packages vendor/bin/pest --mutate --covered-only --class='Capell' --parallel --processes=${PEST_PROCESSES:-4} --min=${PEST_MUTATION_MIN:-60} --bail --colors=always --configuration=phpunit.xml",
        "clear": [
            "CACHE_STORE=array \"$PHP_BINARY\" vendor/bin/testbench package:purge-skeleton --ansi",
            "@clear:views"
        ],
        "clear:views": "@php scripts/clear-phpunit-views.php",
        "prepare": "CACHE_STORE=array \"$PHP_BINARY\" vendor/bin/testbench package:discover --ansi",
        "build": "CACHE_STORE=array \"$PHP_BINARY\" vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "CACHE_STORE=array \"$PHP_BINARY\" vendor/bin/testbench serve --ansi"
        ]
    },
    "repositories": [
