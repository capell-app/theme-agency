    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare",
            "CACHE_STORE=array \"$PHP_BINARY\" vendor/bin/testbench package:discover --ansi",
            "@patch:pest-shards"
        ],
        "patch:pest-shards": "@php scripts/patch-pest-shards.php",
        "rector": "@php vendor/bin/rector",
        "lint": "@php vendor/bin/pint --parallel packages tests",
        "lint:changed": "zsh ./scripts/lint-changed.sh",
        "analyze": "@php vendor/bin/phpstan analyse --memory-limit=-1 --configuration=phpstan.neon",
        "prettier": "npx prettier --write \"packages/**/*.{css,js,yml,json,md,blade.php}\"",
        "eslint": "npx eslint 'packages/**/resources/js/**/*.js' --max-warnings=0",
        "check:composer-paths": "@php scripts/check-composer-local-paths.php",
        "check:composer-lock": "composer validate --no-check-publish",
        "preflight": [
            "@check:composer-paths",
            "@lint:changed"
        ],
        "preflight:all": [
            "@php -r \"echo PHP_EOL . 'Checking Composer path repositories...' . PHP_EOL;\"",
            "@check:composer-paths",
            "@php -r \"echo PHP_EOL . 'Checking Composer lock file...' . PHP_EOL;\"",
            "@check:composer-lock",
            "@php -r \"echo PHP_EOL . 'Running Rector...' . PHP_EOL;\"",
            "@rector",
            "@php -r \"echo PHP_EOL . 'Running Pint...' . PHP_EOL;\"",
            "@lint",
            "@php -r \"echo PHP_EOL . 'Running Prettier...' . PHP_EOL;\"",
            "@prettier",
            "@php -r \"echo PHP_EOL . 'Running ESLint...' . PHP_EOL;\"",
            "@eslint",
            "@php -r \"echo PHP_EOL . 'Running PHPStan...' . PHP_EOL;\"",
            "@analyze",
            "@php -r \"echo PHP_EOL . 'Running Pest...' . PHP_EOL;\"",
            "@test"
        ],
        "test:unit": "@php -d memory_limit=-1 -d max_execution_time=0 -d pcov.enabled=0 vendor/bin/pest --colors=always --parallel --configuration=phpunit.xml",
        "test:group": "@php -d memory_limit=-1 -d max_execution_time=0 -d pcov.enabled=0 vendor/bin/pest --colors=always --parallel --group=${PEST_GROUP:-unit} --configuration=phpunit.xml",
        "test:debug": "@php -d memory_limit=-1 -d max_execution_time=0 -d pcov.enabled=0 vendor/bin/pest --colors=always --debug --stop-on-defect --configuration=phpunit.xml",
        "test:debug:group": "@php -d memory_limit=-1 -d max_execution_time=0 -d pcov.enabled=0 vendor/bin/pest --colors=always --debug --stop-on-defect --group=${PEST_GROUP:-unit} --configuration=phpunit.xml",
        "test:fast": "@php -d memory_limit=-1 -d max_execution_time=0 -d pcov.enabled=0 vendor/bin/pest --colors=always --shard=${PEST_SHARD:-1/1} --stop-on-error --stop-on-failure --configuration=phpunit.xml",
        "test:fast:ci": "@php -d memory_limit=-1 -d max_execution_time=0 -d pcov.enabled=0 vendor/bin/pest --colors=always --shard=${PEST_SHARD:-1/1} --configuration=phpunit.xml",
        "test:all": "@php -d memory_limit=-1 -d max_execution_time=0 -d pcov.enabled=0 vendor/bin/pest --colors=always --parallel --stop-on-error --stop-on-failure --configuration=phpunit.xml",
        "test:all:ci": "@php -d memory_limit=-1 -d max_execution_time=0 -d pcov.enabled=0 vendor/bin/pest --colors=always --parallel --configuration=phpunit.xml",
        "test": [
            "@clear",
            "@test:unit"
        ],
        "clear": [
            "CACHE_STORE=array \"$PHP_BINARY\" vendor/bin/testbench package:purge-skeleton --ansi",
            "@clear:views"
        ],
        "clear:views": "@php scripts/clear-phpunit-views.php",
        "prepare": "CACHE_STORE=array \"$PHP_BINARY\" vendor/bin/testbench package:discover --ansi",
        "build": "CACHE_STORE=array \"$PHP_BINARY\" vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "CACHE_STORE=array \"$PHP_BINARY\" vendor/bin/testbench serve --ansi"
        ]
    },
