{
    "manifest-version": 3,
    "name": "capell-app/theme-agency",
    "slug": "theme-agency",
    "displayName": "Theme Agency",
    "kind": "theme",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "launchStatus": "hidden",
    "description": "Award-style portfolios and design-education picks with a best-seat-in-the-house presentation. Includes the playful curated \"Hand Picked\" preset for lighter, taste-led indexes.",
    "product": {
        "group": "Capell Themes",
        "tier": "free",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeAgency",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": [
            "capell-app/core",
            "capell-app/theme-foundation",
            "capell-app/frontend"
        ],
        "supports": ["capell-app/form-builder", "capell-app/newsletter"],
        "conflicts": []
    },
    "providers": {
        "metadata": ["Capell\\ThemeAgency\\AgencyThemeServiceProvider"],
        "install": ["Capell\\ThemeAgency\\Providers\\ConsoleServiceProvider"],
        "runtime": ["Capell\\ThemeAgency\\AgencyThemeServiceProvider"],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeAgency\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "agency"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-agency-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["frontend-surface", "frontend-assets"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-agency"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-agency.package-health",
            "label": "Agency package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeAgency\\Health\\ThemeAgencyHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Award-style portfolios and design-education picks with a best-seat-in-the-house presentation.",
        "description": "Agency provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for portfolio collections that need large previews, award labels, creator metadata, taxonomy filters, and educational upsells.",
        "problem": "Design educators find it difficult to present portfolios and recognition together on their site.",
        "outcome": "A portfolio site presents creative work alongside its makers and recognition.",
        "faq": [
            {
                "question": "What kind of site is Agency for?",
                "answer": "Portfolio and design-education sites. It brings featured portfolios, newest entries, winner labels, creator profiles and newsletter sections, and your text and images stay yours."
            },
            {
                "question": "Can I preview Agency before applying it?",
                "answer": "Yes. Preview the theme on existing content before applying it to the selected site, and its current theme stays selected until you choose Apply."
            },
            {
                "question": "Can I go back to my old theme after applying Agency?",
                "answer": "Yes. Reapply the site's previous theme to restore its selection. Saving shared Theme Studio settings can still change public pages that use the theme, so treat those edits as live."
            }
        ],
        "screenshots": [
            {
                "path": "docs/screenshots/agency-homepage.webp",
                "alt": "Portfolio homepage with a dark opening, featured collections, discipline filters, award winners and a newsletter panel",
                "caption": "A homepage built from featured portfolios, award winners and a weekly shortlist."
            },
            {
                "path": "docs/screenshots/agency-landing.webp",
                "alt": "Page for one designer's portfolio with a large photo, award winner cards, featured work and studios they have worked with",
                "caption": "A single portfolio page shows its award wins, picks and the studios that hired the designer."
            },
            {
                "path": "docs/screenshots/agency-listing.webp",
                "alt": "Portfolio index page with discipline filters, a grid of recently added entries and a list of older ones below",
                "caption": "Browse by discipline and see the newest entries first."
            },
            {
                "path": "docs/screenshots/agency-search.webp",
                "alt": "Page for a filter with no matches, showing a blank image panel, discipline links and three featured portfolios",
                "caption": "When nothing matches, visitors are pointed to broader disciplines and featured work."
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "contributionTraceability": {
        "deferredContributions": ["route"],
        "contributions": [
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.agency.awarded-profiles",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.agency.content-listing",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.agency.creator-directory",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.agency.cta",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.agency.education-upsell",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.agency.featured-portfolios",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.agency.filter-taxonomies",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.agency.footer",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.agency.form",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.agency.hero",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.agency.navigation",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.agency.newsletter",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.agency.portfolio-grid",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell.widget.agency.proof",
                "providerBucket": "runtime"
            }
        ]
    },
    "extends": "default",
    "themeKey": "agency"
}
