{
    "manifest-version": 3,
    "name": "capell-app/theme-first-light",
    "slug": "theme-first-light",
    "displayName": "Theme First Light",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "A calm daily feed of screenshots and finds: hairline borders, tiny labels, loose masonry, zero noise. Curation that respects the reader's morning.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\FirstLight",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\FirstLight\\FirstLightThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\FirstLight\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "first-light"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-first-light-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-first-light", "theme-first-light-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-first-light"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-first-light.package-health",
            "label": "First Light package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\FirstLight\\Health\\ThemeFirstLightHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A calm daily feed of screenshots and finds: hairline borders, tiny labels, loose masonry, zero noise.",
        "description": "First Light provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for curation sites that need a short hero, live update indicator, category tabs, search, newsletter signup, screenshot cards, maker/source/rating/platform metadata, topic tags, best-of views, latest feeds, apps, websites, icons, and infinite-feed-friendly archive pages.",
        "screenshots": [
            {
                "path": "docs/screenshots/first-light-homepage.png",
                "alt": "First Light homepage preview",
                "caption": "First Light Homepage"
            },
            {
                "path": "docs/screenshots/first-light-landing.png",
                "alt": "First Light landing page preview",
                "caption": "First Light Landing page"
            },
            {
                "path": "docs/screenshots/first-light-listing.png",
                "alt": "First Light list page preview",
                "caption": "First Light Latest feed"
            },
            {
                "path": "docs/screenshots/first-light-search.png",
                "alt": "First Light search results preview",
                "caption": "First Light Search results"
            },
            {
                "path": "docs/screenshots/first-light-contact.png",
                "alt": "First Light contact form preview",
                "caption": "First Light Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "first-light"
}
