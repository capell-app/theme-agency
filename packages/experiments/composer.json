{
    "name": "capell-app/experiments",
    "description": "First-party experiments, A/B testing, variant allocation, personalization rules, and winner reporting for Capell.",
    "keywords": [
        "capell",
        "experiments",
        "ab-testing",
        "personalization",
        "laravel",
        "cms"
    ],
    "homepage": "https://github.com/capell-app/experiments",
    "license": "proprietary",
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "capell-app/core": "^4.0",
        "filament/support": "^4.0|^5.0",
        "lorisleiva/laravel-actions": "^2.8",
        "spatie/laravel-data": "^4.5",
        "spatie/laravel-package-tools": "^1.14.1"
    },
    "autoload": {
        "psr-4": {
            "Capell\\Experiments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\Experiments\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\Experiments\\Providers\\ExperimentsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "pest"
    },
    "prefer-stable": true,
    "type": "library",
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/experiments"
    }
}
