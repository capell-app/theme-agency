{
    "manifest-version": 3,
    "name": "capell-app/shopify-commerce",
    "slug": "shopify-commerce",
    "displayName": "Shopify Commerce",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Shopify Commerce adds site-scoped Shopify Admin API OAuth, catalog sync, and customer cache foundations for Capell.",
    "product": {
        "group": "Capell Commerce",
        "tier": "premium",
        "bundle": "commerce"
    },
    "namespace": "Capell\\ShopifyCommerce",
    "surfaces": ["admin", "console"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core"],
        "supports": [
            "capell-app/contacts",
            "capell-app/search",
            "capell-app/diagnostics"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [
            "Capell\\ShopifyCommerce\\Providers\\ShopifyCommerceServiceProvider"
        ],
        "runtime": [
            "Capell\\ShopifyCommerce\\Providers\\ShopifyCommerceServiceProvider"
        ],
        "admin": ["Capell\\ShopifyCommerce\\Providers\\AdminServiceProvider"],
        "frontend": []
    },
    "contributes": [],
    "database": {
        "migrations": true,
        "settings": true,
        "requiredTables": [
            "shopify_connections",
            "shopify_oauth_states",
            "shopify_products",
            "shopify_product_variants",
            "shopify_customers"
        ],
        "protectedTables": [
            "shopify_connections",
            "shopify_oauth_states",
            "shopify_products",
            "shopify_product_variants",
            "shopify_customers"
        ]
    },
    "commands": {
        "install": "capell-shopify-commerce:install",
        "syncCustomers": "capell-shopify-commerce:sync-customers",
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "actions": {
        "install": "Capell\\ShopifyCommerce\\Actions\\InstallShopifyCommercePackageAction",
        "syncShopifyCustomers": "Capell\\ShopifyCommerce\\Actions\\Customers\\SyncShopifyCustomersAction",
        "upsertShopifyCustomer": "Capell\\ShopifyCommerce\\Actions\\Customers\\UpsertShopifyCustomerAction"
    },
    "settings": ["Capell\\ShopifyCommerce\\Settings\\ShopifyCommerceSettings"],
    "permissions": ["shopify-commerce.manage"],
    "capabilities": [
        "shopify-commerce",
        "shopify-commerce-admin",
        "shopify-commerce-catalog-sync",
        "shopify-commerce-customer-cache",
        "shopify-commerce-customer-synced-event"
    ],
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": ["shopify-commerce"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site"],
            "sensitiveOutput": true,
            "invalidationSources": [
                {
                    "model": "Capell\\ShopifyCommerce\\Models\\ShopifyProduct",
                    "events": ["created", "updated", "deleted"]
                },
                {
                    "model": "Capell\\ShopifyCommerce\\Models\\ShopifyProductVariant",
                    "events": ["created", "updated", "deleted"]
                },
                {
                    "model": "Capell\\ShopifyCommerce\\Models\\ShopifyCustomer",
                    "events": ["created", "updated", "deleted"]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "shopify-commerce.package-health",
            "label": "Shopify Commerce package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ShopifyCommerce\\Health\\ShopifyCommerceHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Connect any Shopify store to Capell in minutes and keep its product catalog and customer data in sync — securely, per site, with no storefront lock-in.",
        "description": "Shopify Commerce links your Shopify store to Capell with a guided, per-site OAuth connection — your Admin API token is encrypted at rest and never touches content code. It syncs your product catalog (products, variants, options, images, pricing) into fast local tables you can search and reference directly from the admin, and caches customer records for CRM and contact workflows. Designed to coexist with your existing storefront and checkout, it owns the integration layer so your team doesn't have to maintain Shopify API glue. Multi-store ready, permission-gated, and observable through Capell Diagnostics.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Shopify Commerce extension preview image",
                "caption": "Shopify Commerce extension preview"
            },
            {
                "path": "docs/screenshots/shopify-connection-page.png",
                "alt": "Shopify Commerce connected store page in Capell Admin",
                "caption": "Review the connected Shopify store, granted scopes, and latest sync timestamp"
            },
            {
                "path": "docs/screenshots/shopify-catalog-sync-state.png",
                "alt": "Shopify Commerce catalog sync state in Capell Admin",
                "caption": "Confirm the local catalog cache is populated from a site-scoped Shopify connection"
            },
            {
                "path": "docs/screenshots/shopify-product-search.png",
                "alt": "Shopify Commerce cached product search in Capell Admin",
                "caption": "Search synced Shopify products and variants without exposing storefront or token data"
            },
            {
                "path": "docs/screenshots/shopify-connection-page-dark.png",
                "alt": "Shopify Commerce connected store page in dark mode",
                "caption": "Connected-store controls remain readable in dark mode"
            },
            {
                "path": "docs/screenshots/shopify-catalog-sync-state-dark.png",
                "alt": "Shopify Commerce catalog sync state in dark mode",
                "caption": "Catalog sync status stays legible in Capell Admin dark mode"
            },
            {
                "path": "docs/screenshots/shopify-product-search-dark.png",
                "alt": "Shopify Commerce product search in dark mode",
                "caption": "Cached catalog lookup supports Capell Admin dark mode"
            }
        ],
        "categories": ["admin", "commerce", "integrations"]
    },
    "contributionTraceability": {
        "deferredContributions": ["admin-page", "model", "route"]
    }
}
