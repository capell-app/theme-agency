{
    "manifest-version": 3,
    "name": "capell-app/shopify-commerce",
    "slug": "shopify-commerce",
    "displayName": "Shopify Commerce",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Shopify Commerce adds site-scoped Shopify Admin API OAuth, catalog sync, and customer cache foundations for Capell.",
    "product": {
        "group": "Capell Commerce",
        "tier": "premium",
        "bundle": "commerce"
    },
    "namespace": "Capell\\ShopifyCommerce",
    "surfaces": ["admin", "console"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core"],
        "supports": [
            "capell-app/contacts",
            "capell-app/diagnostics",
            "capell-app/media-library",
            "capell-app/payments",
            "capell-app/search"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [
            "Capell\\ShopifyCommerce\\Providers\\ShopifyCommerceServiceProvider"
        ],
        "runtime": [
            "Capell\\ShopifyCommerce\\Providers\\ShopifyCommerceServiceProvider"
        ],
        "admin": ["Capell\\ShopifyCommerce\\Providers\\AdminServiceProvider"],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ShopifyCommerce\\Manifest\\ShopifyConnectionPageContribution",
            "pageClass": "Capell\\ShopifyCommerce\\Filament\\Pages\\ShopifyConnectionPage",
            "labelKey": "capell-shopify-commerce::capell-shopify-commerce.navigation.label"
        },
        {
            "type": "route",
            "class": "Capell\\ShopifyCommerce\\Manifest\\ShopifyCommerceRoutesContribution",
            "routes": [
                "capell-shopify-commerce.oauth.install",
                "capell-shopify-commerce.oauth.callback",
                "capell-shopify-commerce.webhooks.shopify"
            ]
        },
        {
            "type": "model",
            "class": "Capell\\ShopifyCommerce\\Manifest\\ShopifyCommerceModelsContribution",
            "modelClasses": [
                "Capell\\ShopifyCommerce\\Models\\ShopifyConnection",
                "Capell\\ShopifyCommerce\\Models\\ShopifyCustomer",
                "Capell\\ShopifyCommerce\\Models\\ShopifyOAuthState",
                "Capell\\ShopifyCommerce\\Models\\ShopifyProduct",
                "Capell\\ShopifyCommerce\\Models\\ShopifyProductVariant"
            ]
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\ShopifyCommerce\\Manifest\\ShopifyProductSyncScheduleContribution",
            "command": "capell-shopify-commerce:sync --all",
            "name": "capell-shopify-commerce-product-sync",
            "frequency": "everyFifteenMinutes",
            "enabledWhen": "capell-shopify-commerce.scheduled_sync_enabled"
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\ShopifyCommerce\\Manifest\\ShopifyOAuthStatePruneScheduleContribution",
            "command": "capell-shopify-commerce:prune-oauth-states",
            "name": "capell-shopify-commerce-prune-oauth-states",
            "frequency": "hourly",
            "enabledWhen": "package installed"
        },
        {
            "type": "console-command",
            "class": "Capell\\ShopifyCommerce\\Manifest\\ShopifyCommerceConsoleCommandsContribution",
            "commands": [
                "capell-shopify-commerce:install",
                "capell-shopify-commerce:prune-oauth-states",
                "capell-shopify-commerce:sync-customers",
                "capell-shopify-commerce:sync"
            ],
            "commandClasses": [
                "Capell\\ShopifyCommerce\\Console\\Commands\\InstallShopifyCommerceCommand",
                "Capell\\ShopifyCommerce\\Console\\Commands\\PruneExpiredShopifyOAuthStatesCommand",
                "Capell\\ShopifyCommerce\\Console\\Commands\\SyncShopifyCustomersCommand",
                "Capell\\ShopifyCommerce\\Console\\Commands\\SyncShopifyProductsCommand"
            ]
        },
        {
            "type": "setting",
            "class": "Capell\\ShopifyCommerce\\Manifest\\ShopifyCommerceSettingsContribution",
            "settingsClasses": [
                "Capell\\ShopifyCommerce\\Settings\\ShopifyCommerceSettings"
            ],
            "settingsGroups": ["shopify_commerce"]
        },
        {
            "type": "health-check",
            "class": "Capell\\ShopifyCommerce\\Manifest\\ShopifyCommerceHealthContribution",
            "checkClass": "Capell\\ShopifyCommerce\\Health\\ShopifyCommerceHealthCheck"
        }
    ],
    "database": {
        "migrations": true,
        "settings": true,
        "requiredTables": [
            "shopify_connections",
            "shopify_oauth_states",
            "shopify_products",
            "shopify_product_variants",
            "shopify_customers"
        ],
        "protectedTables": [
            "shopify_connections",
            "shopify_oauth_states",
            "shopify_products",
            "shopify_product_variants",
            "shopify_customers"
        ]
    },
    "commands": {
        "install": "capell-shopify-commerce:install",
        "pruneOAuthStates": "capell-shopify-commerce:prune-oauth-states",
        "syncCustomers": "capell-shopify-commerce:sync-customers",
        "syncProducts": "capell-shopify-commerce:sync",
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "actions": {
        "install": "Capell\\ShopifyCommerce\\Actions\\InstallShopifyCommercePackageAction",
        "ingestShopifyWebhook": "Capell\\ShopifyCommerce\\Actions\\Webhooks\\IngestShopifyWebhookAction",
        "persistShopifyProduct": "Capell\\ShopifyCommerce\\Actions\\Catalog\\PersistShopifyProductAction",
        "pruneExpiredShopifyOAuthStates": "Capell\\ShopifyCommerce\\Actions\\OAuth\\PruneExpiredShopifyOAuthStatesAction",
        "syncShopifyCustomers": "Capell\\ShopifyCommerce\\Actions\\Customers\\SyncShopifyCustomersAction",
        "upsertShopifyCustomer": "Capell\\ShopifyCommerce\\Actions\\Customers\\UpsertShopifyCustomerAction"
    },
    "settings": ["Capell\\ShopifyCommerce\\Settings\\ShopifyCommerceSettings"],
    "permissions": ["shopify-commerce.manage"],
    "capabilities": [
        "shopify-commerce",
        "shopify-commerce-admin",
        "shopify-commerce-catalog-sync",
        "shopify-commerce-customer-cache",
        "shopify-commerce-customer-synced-event",
        "shopify-commerce-webhooks"
    ],
    "security": {
        "riskTier": "critical",
        "publicSurface": {
            "routeNames": [
                "capell-shopify-commerce.oauth.callback",
                "capell-shopify-commerce.oauth.install",
                "capell-shopify-commerce.webhooks.shopify"
            ],
            "auth": "mixed",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": ["capell-shopify-commerce.webhooks.shopify"],
            "throttledRoutes": ["capell-shopify-commerce.webhooks.shopify"]
        },
        "sensitiveData": {
            "encryptedFields": [
                "Capell\\ShopifyCommerce\\Models\\ShopifyConnection::$access_token",
                "Capell\\ShopifyCommerce\\Models\\ShopifyCustomer::$email",
                "Capell\\ShopifyCommerce\\Models\\ShopifyCustomer::$first_name",
                "Capell\\ShopifyCommerce\\Models\\ShopifyCustomer::$last_name",
                "Capell\\ShopifyCommerce\\Models\\ShopifyCustomer::$phone"
            ],
            "hashedTokenFields": ["shopify_customers.email_hash"],
            "redactedOutputClasses": [
                "Capell\\ShopifyCommerce\\Actions\\Catalog\\SanitizeShopifySyncErrorAction"
            ],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": false,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": true,
            "requiresSecretRedaction": true,
            "clients": [
                "Capell\\ShopifyCommerce\\Actions\\Catalog\\ImportShopifyProductBulkSyncAction",
                "Capell\\ShopifyCommerce\\Actions\\Graphql\\ExecuteShopifyAdminGraphqlAction",
                "Capell\\ShopifyCommerce\\Actions\\OAuth\\ExchangeShopifyAuthorizationCodeAction"
            ]
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": ["shopify-commerce.manage"]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": ["shopify-commerce"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site"],
            "sensitiveOutput": true,
            "invalidationSources": [
                {
                    "model": "Capell\\ShopifyCommerce\\Models\\ShopifyProduct",
                    "events": ["created", "updated", "deleted"]
                },
                {
                    "model": "Capell\\ShopifyCommerce\\Models\\ShopifyProductVariant",
                    "events": ["created", "updated", "deleted"]
                },
                {
                    "model": "Capell\\ShopifyCommerce\\Models\\ShopifyCustomer",
                    "events": ["created", "updated", "deleted"]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "shopify-commerce.package-health",
            "label": "Shopify Commerce package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ShopifyCommerce\\Health\\ShopifyCommerceHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Connect any Shopify store to Capell in minutes and keep its product catalog and customer data in sync — securely, per site, with no storefront lock-in.",
        "description": "Shopify Commerce links your Shopify store to Capell with a guided, per-site OAuth connection — your Admin API token is encrypted at rest and never touches content code. It syncs your product catalog (products, variants, options, images, pricing) into fast local tables you can search and reference directly from the admin, and caches customer records for CRM and contact workflows. Designed to coexist with your existing storefront and checkout, it owns the integration layer so your team doesn't have to maintain Shopify API glue. Multi-store ready, permission-gated, and observable through Capell Diagnostics.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Shopify Commerce extension preview image",
                "caption": "Shopify Commerce extension preview"
            },
            {
                "path": "docs/screenshots/shopify-connection-page.png",
                "alt": "Shopify Commerce connected store page in Capell Admin",
                "caption": "Review the connected Shopify store, granted scopes, and latest sync timestamp"
            },
            {
                "path": "docs/screenshots/shopify-connection-page-dark.png",
                "alt": "Shopify Commerce connected store page in dark mode",
                "caption": "Connected-store controls remain readable in dark mode"
            }
        ],
        "categories": ["admin", "commerce", "integrations"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
