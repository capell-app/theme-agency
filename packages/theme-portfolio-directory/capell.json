{
    "manifest-version": 3,
    "name": "capell-app/theme-portfolio-directory",
    "slug": "theme-portfolio-directory",
    "displayName": "Theme Portfolio Directory",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Portfolio Directory extends the default Capell frontend with a clean portfolio directory direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for directory heroes, role filters, portfolio grids, preview tiles, featured portfolios, resume resources, articles, curated lists, profile details, gallery pages, social links, and related portfolios.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\PortfolioDirectory",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\PortfolioDirectory\\PortfolioDirectoryThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\PortfolioDirectory\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "portfolio-directory"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-portfolio-directory-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-portfolio-directory",
        "theme-portfolio-directory-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-portfolio-directory"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-portfolio-directory.package-health",
            "label": "Portfolio Directory package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\PortfolioDirectory\\Health\\ThemePortfolioDirectoryHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A clean Capell theme for portfolio directories, designer galleries, developer portfolios, studio showcases, resume resources, articles, and curated lists.",
        "description": "Portfolio Directory provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for designers, developers, studios, career-stage collections, portfolio resources, article libraries, and curated showcase directories that need large preview tiles, creator names, disciplines, short editorial notes, tags, resume links, social links, case-study links, galleries, and related portfolios.",
        "screenshots": [
            {
                "path": "docs/screenshots/portfolio-directory-homepage.png",
                "alt": "Portfolio Directory homepage preview",
                "caption": "Portfolio Directory Homepage"
            },
            {
                "path": "docs/screenshots/portfolio-directory-landing.png",
                "alt": "Portfolio Directory landing page preview",
                "caption": "Portfolio Directory Landing page"
            },
            {
                "path": "docs/screenshots/portfolio-directory-listing.png",
                "alt": "Portfolio Directory list page preview",
                "caption": "Portfolio Directory List page"
            },
            {
                "path": "docs/screenshots/portfolio-directory-search.png",
                "alt": "Portfolio Directory search results preview",
                "caption": "Portfolio Directory Search results"
            },
            {
                "path": "docs/screenshots/portfolio-directory-contact.png",
                "alt": "Portfolio Directory contact form preview",
                "caption": "Portfolio Directory Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "portfolio-directory"
}
