{
    "manifest-version": 3,
    "name": "capell-app/theme-restaurant",
    "slug": "theme-restaurant",
    "displayName": "Theme Restaurant",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Theme Restaurant gives hospitality teams a premium venue website built around menu discovery, reservation intent, private dining, events, opening hours, and location confidence. It extends the built-in default frontend theme, keeps restaurant copy and menu items in portable Capell content, and lets the package own the visual rhythm: editorial menu panels, service windows, private-room selling, event previews, and map-adjacent venue proof. It pairs with Bookings or Form Builder for reservation capture, Events for ticketed or seasonal occasions, and Blog for reviews or dining guides while rendering safe static fallbacks when those packages are absent.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\Restaurant",
    "surfaces": ["frontend", "console"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/bookings",
            "capell-app/events",
            "capell-app/form-builder",
            "capell-app/seo-suite"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\Restaurant\\RestaurantThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\Restaurant\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "restaurant"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-restaurant-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-restaurant", "theme-restaurant-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-restaurant"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-restaurant.package-health",
            "label": "Theme Restaurant package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\Restaurant\\Health\\ThemeRestaurantHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium hospitality theme for menu-led restaurants, bars, private dining venues, and event-led dining businesses.",
        "description": "Theme Restaurant gives hospitality teams a premium venue website built around menu discovery, reservation intent, private dining, events, opening hours, and location confidence. It extends the built-in default frontend theme, keeps restaurant copy and menu items in portable Capell content, and lets the package own the visual rhythm: editorial menu panels, service windows, private-room selling, event previews, and map-adjacent venue proof. It pairs with Bookings or Form Builder for reservation capture, Events for ticketed or seasonal occasions, and Blog for reviews or dining guides while rendering safe static fallbacks when those packages are absent.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.svg",
                "alt": "Theme Restaurant marketplace card preview",
                "caption": "Menu-led restaurant homepage and reservation surface."
            },
            {
                "path": "docs/assets/marketplace/restaurant-homepage.svg",
                "alt": "Theme Restaurant homepage preview",
                "caption": "Venue homepage with menu highlights and booking intent."
            },
            {
                "path": "docs/assets/marketplace/restaurant-menu.svg",
                "alt": "Theme Restaurant menu layout preview",
                "caption": "Editorial menu section for courses, tasting notes, and prices."
            },
            {
                "path": "docs/assets/marketplace/restaurant-reservations.svg",
                "alt": "Theme Restaurant reservation layout preview",
                "caption": "Reservation and private dining conversion surface."
            },
            {
                "path": "docs/assets/marketplace/restaurant-events.svg",
                "alt": "Theme Restaurant events layout preview",
                "caption": "Seasonal events, chef nights, and ticketed dining previews."
            },
            {
                "path": "docs/assets/marketplace/restaurant-private-dining.svg",
                "alt": "Theme Restaurant private dining preview",
                "caption": "Private dining page with room options, menus, and enquiry intent."
            }
        ],
        "categories": ["frontend", "themes", "hospitality"]
    },
    "extends": "default",
    "themeKey": "restaurant"
}
