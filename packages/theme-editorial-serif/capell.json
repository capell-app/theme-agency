{
    "manifest-version": 3,
    "name": "capell-app/theme-editorial-serif",
    "slug": "theme-editorial-serif",
    "displayName": "Theme Editorial Serif",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Editorial Serif extends the default Capell frontend with a editorial serif visual direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for publications & journals, writers & essayists.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\EditorialSerif",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\EditorialSerif\\EditorialSerifThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\EditorialSerif\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "editorial-serif"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-editorial-serif-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-editorial-serif", "theme-editorial-serif-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-editorial-serif"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-editorial-serif.package-health",
            "label": "Editorial Serif package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\EditorialSerif\\Health\\ThemeEditorialSerifHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for publications & journals, writers & essayists.",
        "description": "Editorial Serif provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for Quarter Press.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Editorial Serif marketplace card preview",
                "caption": "Editorial Serif premium theme card"
            },
            {
                "path": "docs/screenshots/editorial-serif-homepage.png",
                "alt": "Editorial Serif Homepage demo page screenshot",
                "caption": "Editorial Serif Homepage page"
            },
            {
                "path": "docs/screenshots/editorial-serif-directory.png",
                "alt": "Editorial Serif Directory demo page screenshot",
                "caption": "Editorial Serif Directory page"
            },
            {
                "path": "docs/screenshots/editorial-serif-detail.png",
                "alt": "Editorial Serif Detail demo page screenshot",
                "caption": "Editorial Serif Detail page"
            },
            {
                "path": "docs/screenshots/editorial-serif-contact.png",
                "alt": "Editorial Serif Contact demo page screenshot",
                "caption": "Editorial Serif Contact page"
            },
            {
                "path": "docs/screenshots/editorial-serif-empty.png",
                "alt": "Editorial Serif Empty State demo page screenshot",
                "caption": "Editorial Serif Empty State page"
            },
            {
                "path": "docs/screenshots/editorial-serif-not-found.png",
                "alt": "Editorial Serif 404 State demo page screenshot",
                "caption": "Editorial Serif 404 State page"
            },
            {
                "path": "docs/screenshots/editorial-serif-cta.png",
                "alt": "Editorial Serif Conversion CTA demo page screenshot",
                "caption": "Editorial Serif Conversion CTA page"
            },
            {
                "path": "docs/screenshots/editorial-serif-essays.png",
                "alt": "Editorial Serif Essays demo page screenshot",
                "caption": "Editorial Serif Essays page"
            },
            {
                "path": "docs/screenshots/editorial-serif-archive.png",
                "alt": "Editorial Serif Archive demo page screenshot",
                "caption": "Editorial Serif Archive page"
            },
            {
                "path": "docs/screenshots/editorial-serif-about.png",
                "alt": "Editorial Serif About the Publication demo page screenshot",
                "caption": "Editorial Serif About the Publication page"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "editorial-serif"
}
