{
    "manifest-version": 3,
    "name": "capell-app/theme-reel-room",
    "slug": "theme-reel-room",
    "displayName": "Theme Reel Room",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "A digital-awards archive with motion previews, jury scores, and sharp media frames on muted grey. Every winner, every credit, every frame accounted for.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\ReelRoom",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\ReelRoom\\ReelRoomThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\ReelRoom\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "reel-room"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-reel-room-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-reel-room", "theme-reel-room-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-reel-room"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-reel-room.package-health",
            "label": "Reel Room package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\ReelRoom\\Health\\ThemeReelRoomHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A digital-awards archive with motion previews, jury scores, and sharp media frames on muted grey.",
        "description": "Reel Room provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for motion-heavy awards archives that need month and year filters, winner lists, featured project panels, jury and score explanations, rectangular media frames, small numeric counters, technical labels, synopsis copy, credits, technology stacks, awards, media galleries, and next or previous project links.",
        "screenshots": [
            {
                "path": "docs/screenshots/reel-room-homepage.png",
                "alt": "Reel Room homepage preview",
                "caption": "Reel Room Homepage"
            },
            {
                "path": "docs/screenshots/reel-room-landing.png",
                "alt": "Reel Room landing page preview",
                "caption": "Reel Room Landing page"
            },
            {
                "path": "docs/screenshots/reel-room-listing.png",
                "alt": "Reel Room list page preview",
                "caption": "Reel Room Winner archive"
            },
            {
                "path": "docs/screenshots/reel-room-search.png",
                "alt": "Reel Room search results preview",
                "caption": "Reel Room Search results"
            },
            {
                "path": "docs/screenshots/reel-room-contact.png",
                "alt": "Reel Room contact form preview",
                "caption": "Reel Room Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "reel-room"
}
