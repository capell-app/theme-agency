{
    "manifest-version": 3,
    "name": "capell-app/theme-corporate",
    "slug": "theme-corporate",
    "displayName": "Theme Corporate",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Theme Corporate registers the corporate theme key and restrained renderer views for B2B, public sector, and professional-service sites.",
    "product": {
        "group": "Capell Foundation",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\ThemeStudio\\Corporate",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/foundation-theme"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\Corporate\\CorporateThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\Corporate\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "corporate"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-corporate-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-corporate", "theme-corporate-frontend"],
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-corporate"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "theme-corporate.package-health",
            "label": "Theme Corporate package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\Corporate\\Health\\ThemeCorporateHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Business and governance theme screenshots from route-backed demo layouts.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Theme Corporate extension preview image",
                "caption": "Theme Corporate extension preview"
            },
            {
                "path": "docs/assets/marketplace/corporate-article-layout.svg",
                "alt": "Theme Corporate Article Layout image",
                "caption": "Theme Corporate Article Layout"
            },
            {
                "path": "docs/assets/marketplace/corporate-contact-layout.svg",
                "alt": "Theme Corporate Contact Layout image",
                "caption": "Theme Corporate Contact Layout"
            },
            {
                "path": "docs/assets/marketplace/corporate-governance-layout.svg",
                "alt": "Theme Corporate Governance Layout image",
                "caption": "Theme Corporate Governance Layout"
            },
            {
                "path": "docs/assets/marketplace/corporate-homepage-layout.svg",
                "alt": "Theme Corporate Homepage Layout image",
                "caption": "Theme Corporate Homepage Layout"
            },
            {
                "path": "docs/assets/marketplace/corporate-investor-event-layout.svg",
                "alt": "Theme Corporate Investor Event Layout image",
                "caption": "Theme Corporate Investor Event Layout"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "capell-app/foundation-theme",
    "themeKey": "corporate"
}
