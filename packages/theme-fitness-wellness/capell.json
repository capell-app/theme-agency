                "alt": "Fitness Wellness Detail demo page screenshot",
                "caption": "Fitness Wellness Detail page"
            },
            {
                "path": "docs/screenshots/fitness-wellness-contact.png",
                "alt": "Fitness Wellness Contact demo page screenshot",
                "caption": "Fitness Wellness Contact page"
            },
            {
                "path": "docs/screenshots/fitness-wellness-empty.png",
                "alt": "Fitness Wellness Empty State demo page screenshot",
                "caption": "Fitness Wellness Empty State page"
            },
            {
                "path": "docs/screenshots/fitness-wellness-not-found.png",
                "alt": "Fitness Wellness 404 State demo page screenshot",
                "caption": "Fitness Wellness 404 State page"
            },
            {
                "path": "docs/screenshots/fitness-wellness-cta.png",
                "alt": "Fitness Wellness Conversion CTA demo page screenshot",
                "caption": "Fitness Wellness Conversion CTA page"
            },
            {
                "path": "docs/screenshots/fitness-wellness-classes.png",
                "alt": "Fitness Wellness Classes demo page screenshot",
                "caption": "Fitness Wellness Classes page"
            },
            {
                "path": "docs/screenshots/fitness-wellness-coaches.png",
                "alt": "Fitness Wellness Coaches demo page screenshot",
                "caption": "Fitness Wellness Coaches page"
            },
            {
                "path": "docs/screenshots/fitness-wellness-membership.png",
                "alt": "Fitness Wellness Membership demo page screenshot",
                "caption": "Fitness Wellness Membership page"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "fitness-wellness"
}
