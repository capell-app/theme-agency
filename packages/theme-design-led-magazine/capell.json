{
    "manifest-version": 3,
    "name": "capell-app/theme-design-led-magazine",
    "slug": "theme-design-led-magazine",
    "displayName": "Theme Design Led Magazine",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Design Led Magazine extends the default Capell frontend with a design-magazine direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for photography-led lead stories, editor picks, vertical categories, gallery features, product credits, trend lists, archives, and newsletter conversion.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\DesignLedMagazine",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\DesignLedMagazine\\DesignLedMagazineThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\DesignLedMagazine\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "design-led-magazine"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-design-led-magazine-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-design-led-magazine",
        "theme-design-led-magazine-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-design-led-magazine"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-design-led-magazine.package-health",
            "label": "Design Led Magazine package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\DesignLedMagazine\\Health\\ThemeDesignLedMagazineHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for design-led magazines covering architecture, interiors, fashion, art, culture, product credits, galleries, and trends.",
        "description": "Design Led Magazine provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for visual publishers that need refined story hierarchy, large photography, vertical categories, gallery rows, and newsletter growth.",
        "screenshots": [
            {
                "path": "docs/screenshots/design-led-magazine-homepage.png",
                "alt": "Design Led Magazine homepage preview",
                "caption": "Design Led Magazine Homepage"
            },
            {
                "path": "docs/screenshots/design-led-magazine-landing.png",
                "alt": "Design Led Magazine landing page preview",
                "caption": "Design Led Magazine Landing page"
            },
            {
                "path": "docs/screenshots/design-led-magazine-listing.png",
                "alt": "Design Led Magazine list page preview",
                "caption": "Design Led Magazine List page"
            },
            {
                "path": "docs/screenshots/design-led-magazine-search.png",
                "alt": "Design Led Magazine search results preview",
                "caption": "Design Led Magazine Search results"
            },
            {
                "path": "docs/screenshots/design-led-magazine-contact.png",
                "alt": "Design Led Magazine contact form preview",
                "caption": "Design Led Magazine Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "design-led-magazine"
}
