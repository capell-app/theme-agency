{
    "extends": "../../.eslintrc.json",
    "parserOptions": {
        "ecmaFeatures": {
            "jsx": true
        }
    },
    "rules": {
        "no-unused-vars": [
            "error",
            {
                "varsIgnorePattern": "^(Deferred|FieldError)$"
            }
        ]
    }
}
