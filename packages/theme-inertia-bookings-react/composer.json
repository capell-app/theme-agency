{
    "name": "capell-app/theme-inertia-bookings-react",
    "description": "React components for the Capell Inertia Bookings theme.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "capell-app/core": "^4.0 || 4.x-dev",
        "capell-app/inertia-react-adapter": "^4.0 || 4.x-dev",
        "capell-app/theme-inertia-bookings": "^4.0 || 4.x-dev",
        "spatie/laravel-package-tools": "^1.14.1"
    },
    "autoload": {
        "psr-4": {
            "Capell\\ThemeStudio\\InertiaBookingsReact\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\ThemeStudio\\InertiaBookingsReact\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\ThemeStudio\\InertiaBookingsReact\\Providers\\InertiaBookingsReactServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true,
    "keywords": [
        "capell",
        "inertia",
        "bookings",
        "react"
    ],
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/theme-inertia-bookings-react"
    }
}
