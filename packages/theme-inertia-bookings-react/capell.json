{
    "manifest-version": 3,
    "name": "capell-app/theme-inertia-bookings-react",
    "slug": "theme-inertia-bookings-react",
    "displayName": "Theme Inertia Bookings React",
    "kind": "plugin",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "React component pack for Theme Inertia Bookings.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\InertiaBookingsReact",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": [
            "capell-app/theme-inertia-bookings",
            "capell-app/inertia-react-adapter"
        ],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\InertiaBookingsReact\\Providers\\InertiaBookingsReactServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "frontend-component",
            "class": "Capell\\ThemeStudio\\InertiaBookingsReact\\Manifest\\InertiaBookingsReactComponentContribution",
            "component": "Capell/Bookings/Request",
            "adapter": "react",
            "surface": "frontend"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-inertia-bookings-react"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-inertia-bookings-react"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-inertia-bookings-react.package-health",
            "label": "Theme Inertia Bookings React components are present.",
            "class": "Capell\\ThemeStudio\\InertiaBookingsReact\\Health\\InertiaBookingsReactHealthCheck",
            "severity": "important",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "React components for Theme Inertia Bookings.",
        "description": "Provides React source components that implement the shared Capell/Page and Capell/Bookings/Request server contract.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.svg",
                "alt": "Theme Inertia Bookings React marketplace card.",
                "caption": "Theme Inertia Bookings React extension card."
            }
        ],
        "categories": ["frontend", "themes"]
    }
}
