{
    "manifest-version": 3,
    "name": "capell-app/campaign-studio",
    "slug": "campaign-studio",
    "displayName": "Campaign Studio",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Campaign Studio adds campaign groups, landing-page variants, audience targeting, experiments, CTA widgets, conversion goals, UTM attribution, funnel reporting, and conversion reporting to Capell.",
    "product": {
        "group": "Capell Growth",
        "tier": "premium",
        "bundle": "growth"
    },
    "namespace": "Capell\\CampaignStudio",
    "surfaces": ["admin", "frontend"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/form-builder",
            "capell-app/frontend",
            "capell-app/insights",
            "capell-app/layout-builder"
        ],
        "supports": ["capell-app/experiments", "capell-app/seo-suite"],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\CampaignStudio\\Providers\\CampaignStudioServiceProvider"
        ],
        "admin": ["Capell\\CampaignStudio\\Providers\\AdminServiceProvider"],
        "frontend": [
            "Capell\\CampaignStudio\\Providers\\FrontendServiceProvider"
        ]
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\CampaignStudio\\Manifest\\CampaignStudioAdminResourcesContribution",
            "resourceClasses": [
                "Capell\\CampaignStudio\\Filament\\Resources\\CampaignGroups\\CampaignGroupResource",
                "Capell\\CampaignStudio\\Filament\\Resources\\CampaignLandingPages\\CampaignLandingPageResource",
                "Capell\\CampaignStudio\\Filament\\Resources\\CampaignCtaWidgets\\CampaignCtaWidgetResource",
                "Capell\\CampaignStudio\\Filament\\Resources\\CampaignConversionGoals\\CampaignConversionGoalResource"
            ]
        },
        {
            "type": "configurator",
            "class": "Capell\\CampaignStudio\\Manifest\\CampaignWidgetConfiguratorsContribution",
            "configuratorClasses": [
                "Capell\\CampaignStudio\\Filament\\Configurators\\Widgets\\CampaignCtaWidgetWidgetConfigurator",
                "Capell\\CampaignStudio\\Filament\\Configurators\\Widgets\\CampaignHeroWidgetConfigurator",
                "Capell\\CampaignStudio\\Filament\\Configurators\\Widgets\\CampaignLeadFormWidgetConfigurator"
            ]
        },
        {
            "type": "dashboard-widget",
            "class": "Capell\\CampaignStudio\\Manifest\\CampaignStudioDashboardWidgetsContribution",
            "widgetClasses": [
                "Capell\\CampaignStudio\\Filament\\Widgets\\TopCampaignStudioWidget",
                "Capell\\CampaignStudio\\Filament\\Widgets\\TopLandingPagesWidget"
            ]
        },
        {
            "type": "overview-stat",
            "class": "Capell\\CampaignStudio\\Manifest\\CampaignOverviewStatsContribution",
            "keys": [
                "campaign_overview",
                "campaign_overview.conversions",
                "campaign_overview.conversion_rate"
            ]
        },
        {
            "type": "model",
            "class": "Capell\\CampaignStudio\\Manifest\\CampaignStudioModelsContribution",
            "modelClasses": [
                "Capell\\CampaignStudio\\Models\\CampaignGroup",
                "Capell\\CampaignStudio\\Models\\CampaignLandingPage",
                "Capell\\CampaignStudio\\Models\\CampaignCtaWidget",
                "Capell\\CampaignStudio\\Models\\CampaignConversionGoal",
                "Capell\\CampaignStudio\\Models\\CampaignConversion"
            ]
        },
        {
            "type": "schema-extender",
            "class": "Capell\\CampaignStudio\\Manifest\\CampaignPageSchemaExtenderContribution",
            "extenderClass": "Capell\\CampaignStudio\\Filament\\Extenders\\Page\\CampaignPageSchemaExtender"
        },
        {
            "type": "frontend-component",
            "class": "Capell\\CampaignStudio\\Manifest\\CampaignWidgetComponentsContribution",
            "componentClasses": [
                "Capell\\CampaignStudio\\View\\Components\\Widget\\CampaignCtaWidget"
            ]
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": [
            "campaign_groups",
            "campaign_landing_pages",
            "campaign_cta_widgets",
            "campaign_conversion_goals",
            "campaign_conversions"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "actions": {
        "applyCampaignPageDefaults": "Capell\\CampaignStudio\\Actions\\ApplyCampaignPageDefaultsAction",
        "buildCampaignConversionFunnel": "Capell\\CampaignStudio\\Actions\\BuildCampaignConversionFunnelAction",
        "buildCampaignLandingPageVariants": "Capell\\CampaignStudio\\Actions\\BuildCampaignLandingPageVariantsAction",
        "buildCampaignOverviewStats": "Capell\\CampaignStudio\\Actions\\BuildCampaignOverviewStatsAction",
        "buildCampaignUrl": "Capell\\CampaignStudio\\Actions\\BuildCampaignUrlAction",
        "buildConversionAttribution": "Capell\\CampaignStudio\\Actions\\BuildConversionAttributionAction",
        "buildTopCampaignStudioQuery": "Capell\\CampaignStudio\\Actions\\BuildTopCampaignStudioQueryAction",
        "buildTopLandingPagesQuery": "Capell\\CampaignStudio\\Actions\\BuildTopLandingPagesQueryAction",
        "recordCampaignConversion": "Capell\\CampaignStudio\\Actions\\RecordCampaignConversionAction",
        "recordCtaClickConversion": "Capell\\CampaignStudio\\Actions\\RecordCtaClickConversionAction",
        "recordFormSubmissionConversion": "Capell\\CampaignStudio\\Actions\\RecordFormSubmissionConversionAction",
        "recordPageViewConversion": "Capell\\CampaignStudio\\Actions\\RecordPageViewConversionAction",
        "resolveCampaignFromUrl": "Capell\\CampaignStudio\\Actions\\ResolveCampaignFromUrlAction",
        "resolveCampaignLandingPageFromUrl": "Capell\\CampaignStudio\\Actions\\ResolveCampaignLandingPageFromUrlAction",
        "resolveCampaignLandingPageVariant": "Capell\\CampaignStudio\\Actions\\ResolveCampaignLandingPageVariantAction",
        "syncCampaignExperiment": "Capell\\CampaignStudio\\Actions\\SyncCampaignExperimentAction"
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "campaign-studio",
        "campaign-studio-admin",
        "campaign-studio-frontend",
        "campaign-audience-targeting",
        "campaign-conversion-funnel-reporting",
        "campaign-dashboard-reporting",
        "campaign-experiment-sync",
        "landing-page-variant-experiments",
        "landing-page-variant-management"
    ],
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["campaign-studio"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "campaign-studio.package-health",
            "label": "Campaign Studio package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\CampaignStudio\\Health\\CampaignStudioHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Campaign Studio adds campaign groups, landing-page variants, audience targeting, experiments, CTA widgets, conversion goals, UTM attribution, funnel reporting, and conversion reporting to Capell.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Campaign Studio extension preview image",
                "caption": "Campaign Studio extension preview"
            }
        ],
        "categories": ["admin", "frontend", "growth"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
