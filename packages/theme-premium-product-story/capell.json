{
    "manifest-version": 3,
    "name": "capell-app/theme-premium-product-story",
    "slug": "theme-premium-product-story",
    "displayName": "Theme Premium Product Story",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Premium Product Story extends the default Capell frontend with a polished consumer product storytelling direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for expansive launches, product families, feature highlights, gallery strips, ecosystem modules, comparisons, and purchase CTAs.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\PremiumProductStory",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\PremiumProductStory\\PremiumProductStoryThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\PremiumProductStory\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "premium-product-story"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-premium-product-story-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-premium-product-story",
        "theme-premium-product-story-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-premium-product-story"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-premium-product-story.package-health",
            "label": "Premium Product Story package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\PremiumProductStory\\Health\\ThemePremiumProductStoryHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for consumer product launches, feature storytelling, model comparison, ecosystem content, and purchase CTAs.",
        "description": "Premium Product Story provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for premium product companies that need calm, spacious storytelling with practical buying paths.",
        "screenshots": [
            {
                "path": "docs/screenshots/premium-product-story-homepage.png",
                "alt": "Premium Product Story homepage preview",
                "caption": "Premium Product Story Homepage"
            },
            {
                "path": "docs/screenshots/premium-product-story-landing.png",
                "alt": "Premium Product Story landing page preview",
                "caption": "Premium Product Story Landing page"
            },
            {
                "path": "docs/screenshots/premium-product-story-listing.png",
                "alt": "Premium Product Story list page preview",
                "caption": "Premium Product Story List page"
            },
            {
                "path": "docs/screenshots/premium-product-story-search.png",
                "alt": "Premium Product Story search results preview",
                "caption": "Premium Product Story Search results"
            },
            {
                "path": "docs/screenshots/premium-product-story-contact.png",
                "alt": "Premium Product Story contact form preview",
                "caption": "Premium Product Story Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "contributionTraceability": {
        "deferredContributions": ["route"]
    },
    "extends": "default",
    "themeKey": "premium-product-story"
}
