{
    "name": "capell-app/comments",
    "description": "Configurable moderated comments for Capell pages and content.",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://github.com/capell-app/comments",
    "require": {
        "php": "^8.3",
        "capell-app/admin": "^4.0 || 4.x-dev",
        "capell-app/core": "^4.0 || 4.x-dev",
        "capell-app/frontend": "^4.0 || 4.x-dev",
        "filament/filament": "^4.7|^5.2",
        "laravel/framework": "^11.44.2|^12.0|^13.0",
        "livewire/livewire": "^3.0|^4.0",
        "lorisleiva/laravel-actions": "^2.8",
        "spatie/laravel-data": "^4.5",
        "spatie/laravel-package-tools": "^1.14.1",
        "spatie/laravel-settings": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Capell\\Comments\\": "src",
            "Capell\\Comments\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\Comments\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\Comments\\Providers\\CommentsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
