{
    "name": "capell-app/theme-developer-infrastructure",
    "description": "Developer Infrastructure is a first-party Capell theme for platform products with minimal white foundations, mono labels, sharp dividers, technical pillars, command blocks, deploy timelines, docs sidebars, changelog entries, integrations, architecture diagrams, and enterprise CTAs.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "capell-app/core": "^4.0 || 4.x-dev",
        "capell-app/frontend": "^4.0 || 4.x-dev"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Capell\\ThemeStudio\\DeveloperInfrastructure\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\ThemeStudio\\DeveloperInfrastructure\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\ThemeStudio\\DeveloperInfrastructure\\DeveloperInfrastructureThemeServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "homepage": "https://github.com/capell-app/theme-developer-infrastructure",
    "keywords": [
        "capell",
        "cms",
        "laravel",
        "theme"
    ],
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/theme-developer-infrastructure"
    }
}
