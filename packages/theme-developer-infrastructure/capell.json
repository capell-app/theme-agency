{
    "manifest-version": 3,
    "name": "capell-app/theme-developer-infrastructure",
    "slug": "theme-developer-infrastructure",
    "displayName": "Theme Developer Infrastructure",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Developer Infrastructure extends the default Capell frontend with a developer infrastructure product direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for platform pillars, command blocks, deploy timelines, docs and changelog modules, integrations, architecture diagrams, enterprise CTAs, mono labels, sharp dividers, and technical feature lists.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\DeveloperInfrastructure",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\DeveloperInfrastructure\\DeveloperInfrastructureThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\DeveloperInfrastructure\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "developer-infrastructure"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-developer-infrastructure-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-developer-infrastructure",
        "theme-developer-infrastructure-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-developer-infrastructure"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-developer-infrastructure.package-health",
            "label": "Developer Infrastructure package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\DeveloperInfrastructure\\Health\\ThemeDeveloperInfrastructureHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A minimal Capell theme for developer platforms, infrastructure products, API products, deployment tools, technical SaaS, and enterprise developer workflows.",
        "description": "Developer Infrastructure provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for developer platforms, infrastructure products, API products, deployment tools, technical SaaS teams, and enterprise engineering buyers that need technical pillars, command blocks, deploy timelines, docs sidebars, changelog entries, integrations, architecture diagrams, enterprise controls, and status states.",
        "screenshots": [
            {
                "path": "docs/screenshots/developer-infrastructure-homepage.png",
                "alt": "Developer Infrastructure homepage preview",
                "caption": "Developer Infrastructure Homepage"
            },
            {
                "path": "docs/screenshots/developer-infrastructure-landing.png",
                "alt": "Developer Infrastructure landing page preview",
                "caption": "Developer Infrastructure Landing page"
            },
            {
                "path": "docs/screenshots/developer-infrastructure-listing.png",
                "alt": "Developer Infrastructure list page preview",
                "caption": "Developer Infrastructure List page"
            },
            {
                "path": "docs/screenshots/developer-infrastructure-search.png",
                "alt": "Developer Infrastructure search results preview",
                "caption": "Developer Infrastructure Search results"
            },
            {
                "path": "docs/screenshots/developer-infrastructure-contact.png",
                "alt": "Developer Infrastructure contact form preview",
                "caption": "Developer Infrastructure Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "developer-infrastructure"
}
