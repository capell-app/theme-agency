{
    "manifest-version": 3,
    "name": "capell-app/theme-creator-newsletter",
    "slug": "theme-creator-newsletter",
    "displayName": "Theme Creator Newsletter",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Creator Newsletter extends the default Capell frontend with a creator newsletter visual direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for newsletter creators, solo media brands.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\CreatorNewsletter",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\CreatorNewsletter\\CreatorNewsletterThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\CreatorNewsletter\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "creator-newsletter"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-creator-newsletter-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-creator-newsletter",
        "theme-creator-newsletter-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-creator-newsletter"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-creator-newsletter.package-health",
            "label": "Creator Newsletter package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\CreatorNewsletter\\Health\\ThemeCreatorNewsletterHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for newsletter creators, solo media brands.",
        "description": "Creator Newsletter provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for The Long Game.",
        "screenshots": [
            {
                "path": "docs/screenshots/creator-newsletter-homepage.png",
                "alt": "Creator Newsletter homepage preview",
                "caption": "Creator Newsletter Homepage"
            },
            {
                "path": "docs/screenshots/creator-newsletter-landing.png",
                "alt": "Creator Newsletter landing page preview",
                "caption": "Creator Newsletter Landing page"
            },
            {
                "path": "docs/screenshots/creator-newsletter-listing.png",
                "alt": "Creator Newsletter list page preview",
                "caption": "Creator Newsletter List page"
            },
            {
                "path": "docs/screenshots/creator-newsletter-search.png",
                "alt": "Creator Newsletter search results preview",
                "caption": "Creator Newsletter Search results"
            },
            {
                "path": "docs/screenshots/creator-newsletter-contact.png",
                "alt": "Creator Newsletter contact form preview",
                "caption": "Creator Newsletter Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "creator-newsletter"
}
