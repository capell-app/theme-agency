{
    "name": "capell-app/seo-suite",
    "description": "Ship search-ready pages by default: live SEO scoring, schema.org structured data, broken-link and redirect management, Google Search Console insights, and first-class AI-discovery output (`llms.txt`, page Markdown, AI-crawler controls) — all inside the Capell page editor.",
    "keywords": [
        "capell",
        "seo",
        "discoverability",
        "structured-data",
        "ai-orchestrator",
        "laravel",
        "filamentphp",
        "cms"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "capell-app/admin": "^4.0 || 4.x-dev",
        "capell-app/ai-orchestrator": "^4.0 || 4.x-dev",
        "capell-app/core": "^4.0 || 4.x-dev",
        "capell-app/frontend": "^4.0 || 4.x-dev",
        "capell-app/insights": "^4.0 || 4.x-dev",
        "capell-app/site-discovery": "^4.0 || 4.x-dev"
    },
    "suggest": {
        "capell-app/publishing-studio": "Enables workspace-aware SEO publish dashboard-dashboard_reports."
    },
    "require-dev": {
        "orchestra/testbench": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Capell\\SeoSuite\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\SeoSuite\\Providers\\SeoSuiteServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true,
    "type": "library",
    "homepage": "https://github.com/capell-app/seo-suite",
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/seo-suite"
    }
}
