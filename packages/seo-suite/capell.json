{
    "manifest-version": 3,
    "name": "capell-app/seo-suite",
    "slug": "seo-suite",
    "displayName": "SEO Suite",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Ship search-ready pages by default: live SEO scoring, schema.org structured data, broken-link and redirect management, Google Search Console insights, and first-class AI-discovery output (`llms.txt`, page Markdown, AI-crawler controls) — all inside the Capell page editor.",
    "product": {
        "group": "Capell Search & SEO",
        "tier": "premium",
        "bundle": "search-seo"
    },
    "namespace": "Capell\\SeoSuite",
    "surfaces": ["admin", "frontend", "console"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/frontend",
            "capell-app/insights",
            "capell-app/site-discovery"
        ],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": ["Capell\\SeoSuite\\Providers\\SeoSuiteServiceProvider"],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\SeoSuite\\Manifest\\SeoAuditPageContribution",
            "pageClass": "Capell\\SeoSuite\\Filament\\Pages\\SeoAuditPage",
            "labelKey": "capell-seo-suite::generic.seo_audit"
        },
        {
            "type": "admin-page",
            "class": "Capell\\SeoSuite\\Manifest\\BrokenLinksPageContribution",
            "pageClass": "Capell\\SeoSuite\\Filament\\Pages\\BrokenLinksPage",
            "labelKey": "capell-admin::navigation.broken_links"
        },
        {
            "type": "admin-page",
            "class": "Capell\\SeoSuite\\Manifest\\NotFoundUrlsPageContribution",
            "pageClass": "Capell\\SeoSuite\\Filament\\Pages\\NotFoundUrlsPage",
            "labelKey": "capell-admin::navigation.not_found"
        },
        {
            "type": "admin-page",
            "class": "Capell\\SeoSuite\\Manifest\\AiDiscoveryPageContribution",
            "pageClass": "Capell\\SeoSuite\\Filament\\Pages\\AiDiscoveryPage",
            "labelKey": "capell-seo-suite::generic.ai_discovery"
        },
        {
            "type": "admin-page",
            "class": "Capell\\SeoSuite\\Manifest\\TranslationCoveragePageContribution",
            "pageClass": "Capell\\SeoSuite\\Filament\\Pages\\TranslationCoveragePage",
            "labelKey": "capell-admin::navigation.translation_coverage"
        },
        {
            "type": "admin-page",
            "class": "Capell\\SeoSuite\\Manifest\\SearchRankingsPageContribution",
            "pageClass": "Capell\\SeoSuite\\Filament\\Pages\\SearchRankingsPage",
            "labelKey": "capell-seo-suite::generic.search_rankings"
        },
        {
            "type": "route",
            "class": "Capell\\SeoSuite\\Manifest\\AiDiscoveryRoutesContribution",
            "routes": [
                "capell-frontend.llms-txt",
                "capell-frontend.llms-full-txt",
                "capell-frontend.robots-txt",
                "capell-frontend.page-markdown-home",
                "capell-frontend.page-markdown"
            ]
        }
    ],
    "database": {
        "migrations": true,
        "settings": true,
        "requiredTables": [
            "ai_creator_contexts",
            "ai_creator_sessions",
            "ai_discovery_crawler_rules",
            "ai_discovery_page_profiles",
            "ai_discovery_site_profiles",
            "ai_discovery_snapshots",
            "ai_generation_histories",
            "broken_links",
            "page_seo_snapshots",
            "page_speed_audit_results",
            "page_speed_audit_runs",
            "search_console_query_metrics",
            "search_console_url_metrics"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": "capell:seo-suite-doctor"
    },
    "actions": {
        "buildCrawlerPreviewReport": "Capell\\SeoSuite\\Actions\\BuildCrawlerPreviewReportAction",
        "buildSeoSuiteDoctorReport": "Capell\\SeoSuite\\Actions\\BuildSeoSuiteDoctorReportAction",
        "buildSchemaTemplateReport": "Capell\\SeoSuite\\Actions\\BuildSchemaTemplateReportAction",
        "buildMarketplaceStructuredDataFreshnessWarnings": "Capell\\SeoSuite\\Actions\\BuildMarketplaceStructuredDataFreshnessWarningsAction",
        "clearAiDiscoveryCache": "Capell\\SeoSuite\\Actions\\ClearAiDiscoveryCacheAction",
        "refreshStaleAiDiscoveryMarkdown": "Capell\\SeoSuite\\Actions\\RefreshStaleAiDiscoveryMarkdownAction",
        "syncAiDiscoveryPageProfiles": "Capell\\SeoSuite\\Actions\\SyncAiDiscoveryPageProfilesAction",
        "install": "Capell\\SeoSuite\\Actions\\InstallSeoSuitePackageAction"
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "seo-suite",
        "seo-suite-admin",
        "seo-suite-console",
        "seo-suite-frontend",
        "seo-suite-doctor",
        "seo-suite-public-output-leak-scanning",
        "seo-suite-structured-data-audit",
        "seo-suite-ai-discovery-coverage",
        "seo-suite-stale-output-regeneration",
        "seo-suite-site-discovery-registry",
        "seo-suite-marketplace-structured-data-freshness",
        "seo-suite-crawler-preview-report"
    ],
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["seo-suite"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "seo-suite.page-report",
            "label": "Page SEO reports cover metadata, canonical, robots, schema, redirects, and Search Console signals.",
            "class": "Capell\\SeoSuite\\Health\\SeoSuiteHealthCheck",
            "severity": "critical",
            "surface": "admin"
        },
        {
            "key": "seo-suite.schema-graph",
            "label": "Structured data templates build schema.org graph output.",
            "class": "Capell\\SeoSuite\\Health\\SeoSuiteHealthCheck",
            "severity": "warning",
            "surface": "frontend"
        },
        {
            "key": "seo-suite.broken-links",
            "label": "Broken link records produce redirect opportunities.",
            "class": "Capell\\SeoSuite\\Health\\SeoSuiteHealthCheck",
            "severity": "warning",
            "surface": "admin"
        },
        {
            "key": "seo-suite.ai-discovery",
            "label": "AI Discovery outputs llms.txt, robots.txt, and Markdown page surfaces.",
            "class": "Capell\\SeoSuite\\Health\\SeoSuiteHealthCheck",
            "severity": "warning",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Ship search-ready pages by default: live SEO scoring, schema.org structured data, broken-link and redirect management, Google Search Console insights, and first-class AI-discovery output (`llms.txt`, page Markdown, AI-crawler controls) — all inside the Capell page editor.",
        "description": "SEO Suite turns Capell into a search-and-AI optimisation platform. Editors get an in-context SEO panel that scores every page, previews Google and social results, and suggests internal links and metadata with optional AI assistance, while operators get broken-link tracking, redirect opportunities, Search Console dashboards, and PageSpeed audits. It is the only Capell package built for the AI-search era: generate and govern `llms.txt`, `llms-full.txt`, and per-page Markdown, and control exactly which AI crawlers (GPTBot, ClaudeBot, PerplexityBot, Google-Extended, CCBot) may train on or surface your content. A built-in doctor verifies route ownership, content types, cache headers, sitemap parity, and public-output safety so generated SEO output never leaks admin internals.",
        "screenshots": [
            {
