{
    "manifest-version": 3,
    "name": "capell-app/seo-suite",
    "slug": "seo-suite",
    "displayName": "SEO Suite",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Ship search-ready pages by default: live SEO scoring, schema.org structured data, broken-link and redirect management, Google Search Console insights, and first-class AI-discovery output (`llms.txt`, page Markdown, AI-crawler controls) — all inside the Capell page editor.",
    "product": {
        "group": "Capell Search & SEO",
        "tier": "premium",
        "bundle": "search-seo"
    },
    "namespace": "Capell\\SeoSuite",
    "surfaces": ["admin", "frontend", "console"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend",
            "capell-app/insights",
            "capell-app/site-discovery"
        ],
        "supports": [
            "capell-app/blog",
            "capell-app/media-ai",
            "capell-app/media-library",
            "capell-app/publishing-studio",
            "capell-app/url-manager"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": ["Capell\\SeoSuite\\Providers\\SeoSuiteServiceProvider"],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\SeoSuite\\Manifest\\SeoAuditPageContribution",
            "pageClass": "Capell\\SeoSuite\\Filament\\Pages\\SeoAuditPage",
            "labelKey": "capell-seo-suite::generic.seo_audit"
        },
        {
            "type": "admin-page",
            "class": "Capell\\SeoSuite\\Manifest\\BrokenLinksPageContribution",
            "pageClass": "Capell\\SeoSuite\\Filament\\Pages\\BrokenLinksPage",
            "labelKey": "capell-admin::navigation.broken_links"
        },
        {
            "type": "admin-page",
            "class": "Capell\\SeoSuite\\Manifest\\NotFoundUrlsPageContribution",
            "pageClass": "Capell\\SeoSuite\\Filament\\Pages\\NotFoundUrlsPage",
            "labelKey": "capell-admin::navigation.not_found"
        },
        {
            "type": "admin-page",
            "class": "Capell\\SeoSuite\\Manifest\\AiDiscoveryPageContribution",
            "pageClass": "Capell\\SeoSuite\\Filament\\Pages\\AiDiscoveryPage",
            "labelKey": "capell-seo-suite::generic.ai_discovery"
        },
        {
            "type": "admin-page",
            "class": "Capell\\SeoSuite\\Manifest\\TranslationCoveragePageContribution",
            "pageClass": "Capell\\SeoSuite\\Filament\\Pages\\TranslationCoveragePage",
            "labelKey": "capell-admin::navigation.translation_coverage"
        },
        {
            "type": "admin-page",
            "class": "Capell\\SeoSuite\\Manifest\\SearchRankingsPageContribution",
            "pageClass": "Capell\\SeoSuite\\Filament\\Pages\\SearchRankingsPage",
            "labelKey": "capell-seo-suite::generic.search_rankings"
        },
        {
            "type": "route",
            "class": "Capell\\SeoSuite\\Manifest\\AiDiscoveryRoutesContribution",
            "routes": [
                "capell-frontend.llms-txt",
                "capell-frontend.llms-full-txt",
                "capell-frontend.robots-txt",
                "capell-frontend.page-markdown-home",
                "capell-frontend.page-markdown"
            ]
        },
        {
            "type": "model",
            "class": "Capell\\SeoSuite\\Manifest\\SeoSuiteModelsContribution",
            "modelClasses": [
                "Capell\\AIOrchestrator\\Models\\AIGenerationHistory",
                "Capell\\SeoSuite\\Models\\AiCreatorContext",
                "Capell\\SeoSuite\\Models\\AiCreatorSession",
                "Capell\\SeoSuite\\Models\\AiDiscoverySiteProfile",
                "Capell\\SeoSuite\\Models\\AiDiscoveryPageProfile",
                "Capell\\SeoSuite\\Models\\AiDiscoveryCrawlerRule",
                "Capell\\SeoSuite\\Models\\AiDiscoverySnapshot",
                "Capell\\SeoSuite\\Models\\BrokenLink",
                "Capell\\SeoSuite\\Models\\PageSpeedAuditRun",
                "Capell\\SeoSuite\\Models\\PageSpeedAuditResult",
                "Capell\\SeoSuite\\Models\\PageSeoSnapshot",
                "Capell\\SeoSuite\\Models\\SearchConsoleUrlMetric",
                "Capell\\SeoSuite\\Models\\SearchConsoleQueryMetric"
            ]
        },
        {
            "type": "dashboard-widget",
            "class": "Capell\\SeoSuite\\Manifest\\SeoSuiteDashboardFilamentWidgetsContribution",
            "widgetClasses": [
                "Capell\\SeoSuite\\Filament\\Widgets\\SearchConsoleOverviewFilamentWidget",
                "Capell\\SeoSuite\\Filament\\Widgets\\TopSearchPagesFilamentWidget",
                "Capell\\SeoSuite\\Filament\\Widgets\\SearchMovementFilamentWidget",
                "Capell\\SeoSuite\\Filament\\Widgets\\SeoOpportunitiesFilamentWidget",
                "Capell\\SeoSuite\\Filament\\Widgets\\SearchIntelligenceFilamentWidget",
                "Capell\\SeoSuite\\Filament\\Widgets\\AiDiscoveryCoverageFilamentWidget"
            ]
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\SeoSuite\\Manifest\\SeoSuitePageSpeedScheduleContribution",
            "command": "capell:seo-suite:pagespeed-audit --notify",
            "name": "capell-seo-suite-pagespeed-audit",
            "frequency": "weeklyOn:1:06:00",
            "enabledWhen": "capell-seo-suite.pagespeed.enabled and seo_suite.pagespeed_audit_enabled"
        },
        {
            "type": "console-command",
            "class": "Capell\\SeoSuite\\Manifest\\SeoSuiteConsoleCommandsContribution",
            "commands": [
                "capell:admin-clear-ai-cache",
                "capell:seo-suite-doctor",
                "capell:seo-suite-install",
                "capell:admin-monitor-ai-usage",
                "capell:seo-suite:pagespeed-audit",
                "capell:seo-suite:refresh-ai-discovery-markdown",
                "capell:seo-suite-setup",
                "capell:seo-suite-sync-search-console",
                "capell:admin-test-openai"
            ],
            "commandClasses": [
                "Capell\\SeoSuite\\Console\\Commands\\ClearAiCacheCommand",
                "Capell\\SeoSuite\\Console\\Commands\\DoctorCommand",
                "Capell\\SeoSuite\\Console\\Commands\\InstallCommand",
                "Capell\\SeoSuite\\Console\\Commands\\MonitorAiUsageCommand",
                "Capell\\SeoSuite\\Console\\Commands\\PageSpeedAuditCommand",
                "Capell\\SeoSuite\\Console\\Commands\\RefreshAiDiscoveryMarkdownCommand",
                "Capell\\SeoSuite\\Console\\Commands\\SetupCommand",
                "Capell\\SeoSuite\\Console\\Commands\\SyncSearchConsoleCommand",
                "Capell\\SeoSuite\\Console\\Commands\\TestOpenAiConnectionCommand"
            ]
        },
        {
            "type": "setting",
            "class": "Capell\\SeoSuite\\Manifest\\SeoSuiteSettingsContribution",
            "settingsClasses": [
                "Capell\\AIOrchestrator\\Settings\\AIOrchestratorSettings",
                "Capell\\SeoSuite\\Settings\\SeoSuiteSettings"
            ],
            "settingsGroups": ["ai-orchestrator", "seo_suite", "frontend"]
        },
        {
            "type": "health-check",
            "class": "Capell\\SeoSuite\\Manifest\\SeoSuiteHealthContribution",
            "checkClass": "Capell\\SeoSuite\\Health\\SeoSuiteHealthCheck"
        }
    ],
    "database": {
        "migrations": true,
        "settings": true,
        "requiredTables": [
            "ai_creator_contexts",
            "ai_creator_sessions",
            "ai_discovery_crawler_rules",
            "ai_discovery_page_profiles",
            "ai_discovery_site_profiles",
            "ai_discovery_snapshots",
            "ai_generation_histories",
            "broken_links",
            "page_seo_snapshots",
            "page_speed_audit_results",
            "page_speed_audit_runs",
            "search_console_query_metrics",
            "search_console_url_metrics"
        ]
    },
    "commands": {
        "install": "capell:seo-suite-install",
        "setup": "capell:seo-suite-setup",
        "demo": null,
        "doctor": "capell:seo-suite-doctor",
        "clearAiCache": "capell:admin-clear-ai-cache",
        "monitorAiUsage": "capell:admin-monitor-ai-usage",
        "pageSpeedAudit": "capell:seo-suite:pagespeed-audit",
        "refreshAiDiscoveryMarkdown": "capell:seo-suite:refresh-ai-discovery-markdown",
        "syncSearchConsole": "capell:seo-suite-sync-search-console",
        "testOpenAiConnection": "capell:admin-test-openai"
    },
    "actions": {
        "buildCrawlerPreviewReport": "Capell\\SeoSuite\\Actions\\BuildCrawlerPreviewReportAction",
        "buildSeoSuiteDoctorReport": "Capell\\SeoSuite\\Actions\\BuildSeoSuiteDoctorReportAction",
        "buildSchemaTemplateReport": "Capell\\SeoSuite\\Actions\\BuildSchemaTemplateReportAction",
        "buildMarketplaceStructuredDataFreshnessWarnings": "Capell\\SeoSuite\\Actions\\BuildMarketplaceStructuredDataFreshnessWarningsAction",
        "clearAiDiscoveryCache": "Capell\\SeoSuite\\Actions\\ClearAiDiscoveryCacheAction",
        "refreshStaleAiDiscoveryMarkdown": "Capell\\SeoSuite\\Actions\\RefreshStaleAiDiscoveryMarkdownAction",
        "syncAiDiscoveryPageProfiles": "Capell\\SeoSuite\\Actions\\SyncAiDiscoveryPageProfilesAction",
        "install": "Capell\\SeoSuite\\Actions\\InstallSeoSuitePackageAction"
    },
    "settings": [
        "Capell\\AIOrchestrator\\Settings\\AIOrchestratorSettings",
        "Capell\\SeoSuite\\Settings\\SeoSuiteSettings"
    ],
    "permissions": [
        "View:SeoAuditPage",
        "View:BrokenLinksPage",
        "Manage:BrokenLinks",
        "View:NotFoundUrlsPage",
        "Manage:NotFoundUrls",
        "View:AiDiscoveryPage",
        "Manage:AiDiscovery",
        "View:SearchRankingsPage",
        "View:TranslationCoveragePage",
        "Manage:SeoSuiteSettings",
        "Use:AiCreator"
    ],
    "capabilities": [
        "seo-suite",
        "seo-suite-admin",
        "seo-suite-console",
        "seo-suite-frontend",
        "seo-suite-doctor",
        "seo-suite-public-output-leak-scanning",
        "seo-suite-structured-data-audit",
        "seo-suite-ai-discovery-coverage",
        "seo-suite-stale-output-regeneration",
        "seo-suite-site-discovery-registry",
        "seo-suite-marketplace-structured-data-freshness",
        "seo-suite-crawler-preview-report",
        "seo-suite-pagespeed-audits",
        "seo-suite-pagespeed-digest",
        "seo-suite-search-console-rankings",
        "seo-suite-ai-generation",
        "seo-suite-media-metadata",
        "seo-suite-publishing-studio-gates",
        "seo-suite-blog-article-schema",
        "seo-suite-url-manager-redirect-opportunities"
    ],
    "security": {
        "riskTier": "sensitive",
        "publicSurface": {
            "routeNames": [
                "capell-frontend.llms-full-txt",
                "capell-frontend.llms-txt",
                "capell-frontend.page-markdown",
                "capell-frontend.page-markdown-home",
                "capell-frontend.robots-txt"
            ],
            "auth": "public",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [
                "ai_discovery_page_profiles.markdown_hash",
                "ai_discovery_snapshots.content_hash",
                "search_console_query_metrics.query_hash",
                "search_console_query_metrics.url_hash",
                "search_console_url_metrics.url_hash"
            ],
            "redactedOutputClasses": [
                "Capell\\SeoSuite\\Actions\\BuildSeoSuiteDoctorReportAction",
                "Capell\\SeoSuite\\Support\\PublicOutputLeakScanner"
            ],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": true,
            "requiresSecretRedaction": true,
            "clients": [
                "Capell\\SeoSuite\\Actions\\BuildSeoSuiteDoctorReportAction",
                "Capell\\SeoSuite\\Support\\PageSpeed\\GooglePageSpeedInsightsClient",
                "Capell\\SeoSuite\\Support\\SearchConsole\\GoogleSearchConsoleClient"
            ]
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "View:SeoAuditPage",
                "View:BrokenLinksPage",
                "Manage:BrokenLinks",
                "View:NotFoundUrlsPage",
                "Manage:NotFoundUrls",
                "View:AiDiscoveryPage",
                "Manage:AiDiscovery",
                "View:SearchRankingsPage",
                "View:TranslationCoveragePage",
                "Manage:SeoSuiteSettings",
                "Use:AiCreator"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["seo-suite"],
        "cacheSafety": {
            "cacheable": true,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Core\\Models\\Page",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\SeoSuite\\Models\\AiDiscoverySiteProfile",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\SeoSuite\\Models\\AiDiscoveryPageProfile",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\SeoSuite\\Models\\AiDiscoveryCrawlerRule",
                    "events": ["saved", "deleted"]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "seo-suite.page-report",
            "label": "Page SEO reports cover metadata, canonical, robots, schema, redirects, and Search Console signals.",
            "class": "Capell\\SeoSuite\\Health\\SeoSuiteHealthCheck",
            "severity": "critical",
            "surface": "admin"
        },
        {
            "key": "seo-suite.schema-graph",
            "label": "Structured data templates build schema.org graph output.",
            "class": "Capell\\SeoSuite\\Health\\SeoSuiteHealthCheck",
            "severity": "warning",
            "surface": "frontend"
        },
        {
            "key": "seo-suite.broken-links",
            "label": "Broken link records produce redirect opportunities.",
            "class": "Capell\\SeoSuite\\Health\\SeoSuiteHealthCheck",
            "severity": "warning",
            "surface": "admin"
        },
        {
            "key": "seo-suite.ai-discovery",
            "label": "AI Discovery outputs llms.txt, robots.txt, and Markdown page surfaces.",
            "class": "Capell\\SeoSuite\\Health\\SeoSuiteHealthCheck",
            "severity": "warning",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Ship search-ready pages by default: live SEO scoring, schema.org structured data, broken-link and redirect management, Google Search Console insights, and first-class AI-discovery output (`llms.txt`, page Markdown, AI-crawler controls) — all inside the Capell page editor.",
        "description": "SEO Suite turns Capell into a search-and-AI optimisation platform. Editors get an in-context SEO panel that scores every page, previews Google and social results, and suggests internal links and metadata with optional AI assistance, while operators get broken-link tracking, redirect opportunities, Search Console dashboards, and PageSpeed audits. It is the only Capell package built for the AI-search era: generate and govern `llms.txt`, `llms-full.txt`, and per-page Markdown, and control exactly which AI crawlers (GPTBot, ClaudeBot, PerplexityBot, Google-Extended, CCBot) may train on or surface your content. A built-in doctor verifies route ownership, content types, cache headers, sitemap parity, and public-output safety so generated SEO output never leaks admin internals.",
        "screenshots": [
            {
                "path": "docs/screenshots/seo-audit-page.png",
                "alt": "SEO Suite audit page in light mode",
                "caption": "SEO audit dashboard"
            },
            {
                "path": "docs/screenshots/seo-audit-page-dark.png",
                "alt": "SEO Suite audit page in dark mode",
                "caption": "SEO audit dashboard dark mode"
            },
            {
                "path": "docs/screenshots/sitemap-page.png",
                "alt": "SEO Suite sitemap page in light mode",
                "caption": "Sitemap coverage"
            }
        ],
        "categories": ["admin", "console", "frontend", "search-seo"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
