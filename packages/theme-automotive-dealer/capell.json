{
    "manifest-version": 3,
    "name": "capell-app/theme-automotive-dealer",
    "slug": "theme-automotive-dealer",
    "displayName": "Theme Automotive Dealer",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Automotive Dealer extends the default Capell frontend with a automotive dealer visual direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for car dealerships, used-car retailers.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\AutomotiveDealer",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\AutomotiveDealer\\AutomotiveDealerThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\AutomotiveDealer\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "automotive-dealer"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-automotive-dealer-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-automotive-dealer",
        "theme-automotive-dealer-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-automotive-dealer"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-automotive-dealer.package-health",
            "label": "Automotive Dealer package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\AutomotiveDealer\\Health\\ThemeAutomotiveDealerHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for car dealerships, used-car retailers.",
        "description": "Automotive Dealer provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for Apex Motors.",
        "screenshots": [
            {
                "path": "docs/screenshots/automotive-dealer-homepage.png",
                "alt": "Automotive Dealer homepage preview",
                "caption": "Automotive Dealer Homepage"
            },
            {
                "path": "docs/screenshots/automotive-dealer-landing.png",
                "alt": "Automotive Dealer landing page preview",
                "caption": "Automotive Dealer Landing page"
            },
            {
                "path": "docs/screenshots/automotive-dealer-listing.png",
                "alt": "Automotive Dealer list page preview",
                "caption": "Automotive Dealer List page"
            },
            {
                "path": "docs/screenshots/automotive-dealer-search.png",
                "alt": "Automotive Dealer search results preview",
                "caption": "Automotive Dealer Search results"
            },
            {
                "path": "docs/screenshots/automotive-dealer-contact.png",
                "alt": "Automotive Dealer contact form preview",
                "caption": "Automotive Dealer Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "automotive-dealer"
}
