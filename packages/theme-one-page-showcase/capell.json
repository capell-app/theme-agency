{
    "manifest-version": 3,
    "name": "capell-app/theme-one-page-showcase",
    "slug": "theme-one-page-showcase",
    "displayName": "Theme One Page Showcase",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "One Page Showcase extends the default Capell frontend with a one-page showcase direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for showcase hero, category tabs, one-page grids, templates, sections, tools, sponsors, build resources, screenshot cards, compact tags, count proof, and submit CTAs.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\OnePageShowcase",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\OnePageShowcase\\OnePageShowcaseThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\OnePageShowcase\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "one-page-showcase"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-one-page-showcase-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-one-page-showcase",
        "theme-one-page-showcase-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-one-page-showcase"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-one-page-showcase.package-health",
            "label": "One Page Showcase package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\OnePageShowcase\\Health\\ThemeOnePageShowcaseHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A friendly Capell theme for one-page website galleries, landing page showcases, template directories, startup inspiration sites, and practical marketing resources.",
        "description": "One Page Showcase provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for one-page website galleries, landing page showcases, template directories, startup inspiration sites, resource hubs, and makers that need screenshots, titles, types, stacks, platforms, compact tags, short notes, templates, page sections, tools, sponsor recommendations, and build resources.",
        "screenshots": [
            {
                "path": "docs/screenshots/one-page-showcase-homepage.png",
                "alt": "One Page Showcase homepage preview",
                "caption": "One Page Showcase Homepage"
            },
            {
                "path": "docs/screenshots/one-page-showcase-landing.png",
                "alt": "One Page Showcase landing page preview",
                "caption": "One Page Showcase Landing page"
            },
            {
                "path": "docs/screenshots/one-page-showcase-listing.png",
                "alt": "One Page Showcase list page preview",
                "caption": "One Page Showcase List page"
            },
            {
                "path": "docs/screenshots/one-page-showcase-search.png",
                "alt": "One Page Showcase search results preview",
                "caption": "One Page Showcase Search results"
            },
            {
                "path": "docs/screenshots/one-page-showcase-contact.png",
                "alt": "One Page Showcase contact form preview",
                "caption": "One Page Showcase Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "one-page-showcase"
}
