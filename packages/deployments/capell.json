{
    "manifest-version": 3,
    "name": "capell-app/deployments",
    "slug": "deployments",
    "displayName": "Deployments",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Deployments lets site operators connect GitHub, GitLab, or Bitbucket repositories from the Capell admin and publish Composer requirement changes without server shell access. OAuth-backed connections store encrypted tokens, remember the repository owner/name, and let extension install flows open pull requests, auto-merge them, or make direct commits according to policy. It is the Operations bundle bridge between Marketplace installs and reviewed repository changes.",
    "product": {
        "group": "Capell Operations",
        "tier": "premium",
        "bundle": "operations"
    },
    "namespace": "Capell\\Deployments",
    "surfaces": ["admin"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [
            "Capell\\Deployments\\Providers\\DeploymentsServiceProvider"
        ],
        "runtime": [],
        "admin": ["Capell\\Deployments\\Providers\\DeploymentsServiceProvider"],
        "frontend": []
    },
    "contributes": [],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": ["deployment_connections", "deployment_publications"]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [
        "View:DeploymentConnectionPage",
        "Manage:DeploymentConnectionPage"
    ],
    "capabilities": [
        "deployments",
        "deployments-admin",
        "deployments-install-policy",
        "deployments-publish-history",
        "deployments-publish-idempotency",
        "deployments-token-refresh"
    ],
    "security": {
        "riskTier": "critical",
        "publicSurface": {
            "routeNames": [
                "capell-deployments.oauth.bitbucket",
                "capell-deployments.oauth.github",
                "capell-deployments.oauth.gitlab"
            ],
            "auth": "public",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [
                "Capell\\Deployments\\Models\\DeploymentConnection::$access_token_encrypted",
                "Capell\\Deployments\\Models\\DeploymentConnection::$refresh_token_encrypted"
            ],
            "hashedTokenFields": [],
            "redactedOutputClasses": [
                "Capell\\Deployments\\Http\\Controllers\\OAuth\\BitbucketCallbackController",
                "Capell\\Deployments\\Http\\Controllers\\OAuth\\GitHubCallbackController",
                "Capell\\Deployments\\Http\\Controllers\\OAuth\\GitLabCallbackController"
            ],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": true,
            "requiresSecretRedaction": true,
            "clients": [
                "Capell\\Deployments\\Actions\\RefreshProviderTokenAction",
                "Capell\\Deployments\\Http\\Controllers\\OAuth\\BitbucketCallbackController",
                "Capell\\Deployments\\Http\\Controllers\\OAuth\\GitHubCallbackController",
                "Capell\\Deployments\\Http\\Controllers\\OAuth\\GitLabCallbackController"
            ]
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "View:DeploymentConnectionPage",
                "Manage:DeploymentConnectionPage"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": [],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "deployments.package-health",
            "label": "Deployments package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\Deployments\\Health\\DeploymentsHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Connect a Git repository once, then install or update Capell extensions from admin workflows that publish composer.json changes as reviewed pull requests.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Illustrated Deployments marketplace card showing Git-backed extension publishing",
                "caption": "Deployments connects Capell extension installs to reviewed Git repository changes"
            },
            {
                "path": "docs/screenshots/deployment-connection-page.png",
                "alt": "Deployment Repository page showing GitHub, GitLab, and Bitbucket OAuth connect buttons",
                "caption": "Start the Git provider OAuth flow from the Deployment Repository admin page"
            },
            {
                "path": "docs/screenshots/deployment-connection-page-dark.png",
                "alt": "Deployment Repository page in dark mode showing Git provider OAuth connect buttons",
                "caption": "Dark-mode view of the Git provider connection entry point"
            }
        ],
        "categories": ["admin", "operations"]
    },
    "contributionTraceability": {
        "deferredContributions": ["admin-page", "route"]
    }
}
