{
    "manifest-version": 3,
    "name": "capell-app/automation-studio",
    "slug": "automation-studio",
    "displayName": "Automation Studio",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Automation Studio provides rule-based workflow orchestration for Capell package events, native actions, Public Actions, and agent capabilities.",
    "product": {
        "group": "Capell Automation",
        "tier": "premium",
        "bundle": "automation"
    },
    "namespace": "Capell\\AutomationStudio",
    "surfaces": ["admin", "console"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core"],
        "supports": [
            "capell-app/access-gate",
            "capell-app/agent-bridge",
            "capell-app/campaign-studio",
            "capell-app/contacts",
            "capell-app/email-studio",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/public-actions",
            "capell-app/publishing-studio"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\AutomationStudio\\Providers\\AutomationStudioServiceProvider"
        ],
        "admin": ["Capell\\AutomationStudio\\Providers\\AdminServiceProvider"],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\AutomationStudio\\Manifest\\AutomationRuleResourceContribution",
            "resourceClass": "Capell\\AutomationStudio\\Filament\\Resources\\AutomationRules\\AutomationRuleResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\AutomationStudio\\Manifest\\AutomationRunResourceContribution",
            "resourceClass": "Capell\\AutomationStudio\\Filament\\Resources\\AutomationRuns\\AutomationRunResource"
        },
        {
            "type": "model",
            "class": "Capell\\AutomationStudio\\Manifest\\AutomationStudioModelsContribution",
            "modelClasses": [
                "Capell\\AutomationStudio\\Models\\AutomationRule",
                "Capell\\AutomationStudio\\Models\\AutomationRun"
            ]
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": ["automation_rules", "automation_runs"]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "actions": {
        "dispatchAutomationTrigger": "Capell\\AutomationStudio\\Actions\\DispatchAutomationTriggerAction",
        "loadPersistedAutomationRules": "Capell\\AutomationStudio\\Actions\\LoadPersistedAutomationRulesAction",
        "persistAutomationTriggerResults": "Capell\\AutomationStudio\\Actions\\PersistAutomationTriggerResultsAction",
        "queueAutomationTrigger": "Capell\\AutomationStudio\\Actions\\QueueAutomationTriggerAction",
        "registerAutomationStudioDefaults": "Capell\\AutomationStudio\\Actions\\RegisterAutomationStudioDefaultsAction",
        "replayAutomationRun": "Capell\\AutomationStudio\\Actions\\ReplayAutomationRunAction",
        "recordAutomationRun": "Capell\\AutomationStudio\\Actions\\RecordAutomationRunAction"
    },
    "permissions": [
        "View:AutomationRule",
        "Create:AutomationRule",
        "Update:AutomationRule",
        "Delete:AutomationRule",
        "View:AutomationRun"
    ],
    "capabilities": [
        "automation-rules",
        "automation-triggers",
        "automation-actions",
        "automation-persistence",
        "automation-admin",
        "automation-queue",
        "automation-idempotency",
        "automation-run-replay",
        "trigger-form-submitted",
        "trigger-access-approved",
        "trigger-page-published",
        "trigger-campaign-converted",
        "native-action-send-email",
        "native-action-webhook",
        "native-action-tag-contact",
        "native-action-create-note",
        "native-action-subscribe-user",
        "native-action-queue-agent-capability",
        "public-actions-bridge",
        "contacts-bridge",
        "newsletter-bridge",
        "email-studio-bridge",
        "agent-capability-queue"
    ],
    "security": {
        "riskTier": "sensitive",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [
                "Capell\\AutomationStudio\\Models\\AutomationRule::$actions",
                "Capell\\AutomationStudio\\Models\\AutomationRule::$conditions",
                "Capell\\AutomationStudio\\Models\\AutomationRule::$settings",
                "Capell\\AutomationStudio\\Models\\AutomationRun::$context",
                "Capell\\AutomationStudio\\Models\\AutomationRun::$payload"
            ],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": true,
            "requiresSecretRedaction": true,
            "clients": ["public-actions-webhook"]
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "View:AutomationRule",
                "Create:AutomationRule",
                "Update:AutomationRule",
                "Delete:AutomationRule",
                "View:AutomationRun"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 20,
        "cacheTags": ["automation-studio"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "automation-studio.package-health",
            "label": "Automation Studio registries and trigger/action defaults are discoverable.",
            "class": "Capell\\AutomationStudio\\Health\\AutomationStudioHealthCheck",
            "severity": "critical",
            "surface": "admin",
            "coverage": [
                "storage-tables",
                "admin-resources",
                "trigger-registry",
                "action-registry",
                "queued-dispatch",
                "native-handlers",
                "optional-bridge-listeners"
            ]
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Automation Studio connects Capell package events to rule-based native actions, Public Actions, and agent capability workflows.",
        "screenshots": [
            {
                "path": "docs/screenshots/automation-rules-index.png",
                "alt": "Automation Studio rules index showing a seeded lead nurture workflow.",
                "caption": "Review active workflow rules, trigger types, status, and execution counts from Capell admin."
            },
            {
                "path": "docs/screenshots/automation-rule-edit.png",
                "alt": "Automation Studio rule edit screen with conditions, actions, and settings.",
                "caption": "Edit trigger conditions and multi-step native actions for a seeded automation workflow."
            },
            {
                "path": "docs/screenshots/automation-runs-index.png",
                "alt": "Automation Studio runs index showing a successful send email action.",
                "caption": "Audit workflow execution history, action status, messages, and timing in Capell admin."
            }
        ],
        "categories": ["admin", "automation", "console"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
