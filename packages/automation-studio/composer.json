{
    "name": "capell-app/automation-studio",
    "description": "Rule-based workflow orchestration for Capell CMS package events and actions.",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Capell\\AutomationStudio\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\AutomationStudio\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\AutomationStudio\\Providers\\AutomationStudioServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.3",
        "capell-app/core": "^4.0",
        "filament/support": "^4.0|^5.0",
        "laravel/framework": "^11.45.3|^12.41.1|^13.0",
        "lorisleiva/laravel-actions": "^2.8",
        "spatie/laravel-data": "^4.5"
    },
    "require-dev": {
        "orchestra/testbench": "^9.15|^10.8|^11.0",
        "pestphp/pest": "^3.8|^4.3",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "pest --colors=always"
    },
    "homepage": "https://github.com/capell-app/automation-studio",
    "keywords": [
        "automation",
        "capell",
        "cms",
        "laravel",
        "workflow"
    ],
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/automation-studio"
    }
}
