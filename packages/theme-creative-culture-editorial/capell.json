{
    "manifest-version": 3,
    "name": "capell-app/theme-creative-culture-editorial",
    "slug": "theme-creative-culture-editorial",
    "displayName": "Theme Creative Culture Editorial",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Creative Culture Editorial extends the default Capell frontend with a warm art-directed editorial direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for must-reads, projects, opinion, advice, culture stories, events, popular tags, discipline browsing, and newsletters.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\CreativeCultureEditorial",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\CreativeCultureEditorial\\CreativeCultureEditorialThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\CreativeCultureEditorial\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "creative-culture-editorial"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-creative-culture-editorial-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-creative-culture-editorial",
        "theme-creative-culture-editorial-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-creative-culture-editorial"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-creative-culture-editorial.package-health",
            "label": "Creative Culture Editorial package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\CreativeCultureEditorial\\Health\\ThemeCreativeCultureEditorialHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for creative editorial sites covering projects, opinion, advice, culture, events, tags, disciplines, and newsletters.",
        "description": "Creative Culture Editorial provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for culture and design publishers that need strong art direction, varied story cards, category accents, events, tags, and newsletter growth.",
        "screenshots": [
            {
                "path": "docs/screenshots/creative-culture-editorial-homepage.png",
                "alt": "Creative Culture Editorial homepage preview",
                "caption": "Creative Culture Editorial Homepage"
            },
            {
                "path": "docs/screenshots/creative-culture-editorial-landing.png",
                "alt": "Creative Culture Editorial landing page preview",
                "caption": "Creative Culture Editorial Landing page"
            },
            {
                "path": "docs/screenshots/creative-culture-editorial-listing.png",
                "alt": "Creative Culture Editorial list page preview",
                "caption": "Creative Culture Editorial List page"
            },
            {
                "path": "docs/screenshots/creative-culture-editorial-search.png",
                "alt": "Creative Culture Editorial search results preview",
                "caption": "Creative Culture Editorial Search results"
            },
            {
                "path": "docs/screenshots/creative-culture-editorial-contact.png",
                "alt": "Creative Culture Editorial contact form preview",
                "caption": "Creative Culture Editorial Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "creative-culture-editorial"
}
