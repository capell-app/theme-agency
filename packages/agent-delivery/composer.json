{
    "name": "capell-app/agent-delivery",
    "description": "Serve your published Capell pages to AI agents and answer engines as clean, public-safe JSON manifests and RAG-ready semantic chunks — no scraping, no admin leakage.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "capell-app/core": "^4.0 || 4.x-dev",
        "laravel/framework": "^11.45.3|^12.41.1|^13.0",
        "lorisleiva/laravel-actions": "^2.8",
        "spatie/laravel-data": "^4.5",
        "spatie/laravel-package-tools": "^1.14.1"
    },
    "suggest": {
        "capell-app/site-discovery": "Enables public URL registry generated-output coverage reporting for page manifest endpoints."
    },
    "require-dev": {
        "orchestra/testbench": "^9.15|^10.8|^11.0",
        "pestphp/pest": "^3.8|^4.3",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan": "^2.1",
        "laravel/pint": "^1.25"
    },
    "autoload": {
        "psr-4": {
            "Capell\\AgentDelivery\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\AgentDelivery\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\AgentDelivery\\Providers\\AgentDeliveryServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "homepage": "https://github.com/capell-app/agent-delivery",
    "keywords": [
        "capell",
        "cms",
        "agents",
        "structured-content"
    ],
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/agent-delivery"
    }
}
