{
    "manifest-version": 3,
    "name": "capell-app/agent-delivery",
    "slug": "agent-delivery",
    "displayName": "Agent Delivery",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Serve your published Capell pages to AI agents and answer engines as clean, public-safe JSON manifests and RAG-ready semantic chunks — no scraping, no admin leakage.",
    "product": {
        "group": "Capell Publishing Pro",
        "tier": "premium",
        "bundle": "publishing-pro"
    },
    "namespace": "Capell\\AgentDelivery",
    "surfaces": [
        "frontend"
    ],
    "dependencies": {
        "requires": [
            "capell-app/core"
        ],
        "supports": [
            "capell-app/site-discovery"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\AgentDelivery\\Providers\\AgentDeliveryServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "agent-delivery",
        "public-page-manifest",
        "public-page-chunks"
    ],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [
                "capell-agent-delivery.pages.chunks",
                "capell-agent-delivery.pages.index",
                "capell-agent-delivery.pages.manifest",
                "pages.index",
                "pages.manifest",
                "pages.chunks"
            ],
            "auth": "public",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": [
                "pages.index",
                "pages.manifest",
                "pages.chunks"
            ]
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": [
            "agent-delivery"
        ],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [
                "site",
                "locale",
                "url"
            ],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Core\\Models\\Page",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "agent-delivery.package-health",
            "label": "Agent Delivery package API compatibility is discoverable by Diagnostics.",
            "class": "Capell\\AgentDelivery\\Health\\AgentDeliveryHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Serve your published Capell pages to AI agents and answer engines as clean, public-safe JSON manifests and RAG-ready semantic chunks — no scraping, no admin leakage.",
        "screenshots": [],
        "categories": [
            "frontend",
            "publishing-pro",
            "ai"
        ]
    },
    "contributionTraceability": {
        "deferredContributions": [
            "route",
            "public-api-endpoint",
            "agent-delivery-contract"
        ]
    }
}
