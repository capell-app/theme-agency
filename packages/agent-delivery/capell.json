{
    "manifest-version": 3,
    "name": "capell-app/agent-delivery",
    "slug": "agent-delivery",
    "displayName": "Agent Delivery",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Public-safe structured page manifests and semantic chunks for agents, search assistants, and machine readers.",
    "product": {
        "group": "Capell Publishing Pro",
        "tier": "premium",
        "bundle": "publishing-pro"
    },
    "namespace": "Capell\\AgentDelivery",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core"],
        "supports": ["capell-app/site-discovery"],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\AgentDelivery\\Providers\\AgentDeliveryServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "agent-delivery",
        "public-page-manifest",
        "public-page-chunks"
    ],
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["agent-delivery"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale", "url"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Core\\Models\\Page",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "agent-delivery.package-health",
            "label": "Agent Delivery package surfaces, providers, and public manifest health are discoverable by Diagnostics.",
            "class": "Capell\\AgentDelivery\\Health\\AgentDeliveryHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Public-safe structured page manifests and semantic chunks for agents and machine readers.",
        "screenshots": [],
        "categories": ["frontend", "publishing-pro", "ai"]
    },
    "contributionTraceability": {
        "deferredContributions": [
            "route",
            "public-api-endpoint",
            "agent-delivery-contract"
        ]
    }
}
