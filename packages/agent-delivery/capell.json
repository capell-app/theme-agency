{
    "manifest-version": 3,
    "name": "capell-app/agent-delivery",
    "slug": "agent-delivery",
    "displayName": "Agent Delivery",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Serve your published Capell pages to AI agents and answer engines as clean, public-safe JSON manifests and RAG-ready semantic chunks — no scraping, no admin leakage.",
    "product": {
        "group": "Capell Publishing Pro",
        "tier": "premium",
        "bundle": "publishing-pro"
    },
    "namespace": "Capell\\AgentDelivery",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core"],
        "supports": ["capell-app/site-discovery"],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\AgentDelivery\\Providers\\AgentDeliveryServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "route",
            "class": "Capell\\AgentDelivery\\Manifest\\AgentDeliveryRoutesContribution",
            "apiSurface": "public-json",
            "endpointType": "public-api-endpoint",
            "version": "v1",
            "methods": ["GET"],
            "contentType": "application/json",
            "auth": "public",
            "cachePolicy": "short-lived-public-json",
            "cacheVariation": ["site", "language", "url", "page"],
            "conditionalRequests": true,
            "responseHeaders": [
                "X-Capell-Agent-Delivery-Version",
                "X-Capell-Cache-Tags",
                "X-Capell-Agent-Delivery-Variation",
                "Cache-Control",
                "Vary",
                "ETag",
                "Last-Modified"
            ],
            "routes": [
                "capell-agent-delivery.discovery",
                "capell-agent-delivery.pages.index",
                "capell-agent-delivery.pages.manifest",
                "capell-agent-delivery.pages.chunks"
            ],
            "prefix": "api/capell/agent/v1",
            "middleware": ["api", "throttle:capell-agent-delivery"]
        },
        {
            "type": "agent-capability",
            "class": "Capell\\AgentDelivery\\Manifest\\AgentDeliveryContractsContribution",
            "contracts": [
                "Capell\\AgentDelivery\\Contracts\\AgentDeliveryContributor",
                "Capell\\AgentDelivery\\Contracts\\AgentDeliveryMetadataContributor",
                "Capell\\AgentDelivery\\Contracts\\AgentDeliveryChunkContributor",
                "Capell\\AgentDelivery\\Contracts\\AgentDeliveryReferenceContributor",
                "Capell\\AgentDelivery\\Contracts\\AgentDeliveryRelatedUrlContributor"
            ]
        },
        {
            "type": "health-check",
            "class": "Capell\\AgentDelivery\\Health\\AgentDeliveryHealthCheck"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "agent-delivery",
        "public-page-manifest",
        "public-page-chunks",
        "public-agent-discovery"
    ],
    "security": {
        "riskTier": "critical",
        "publicSurface": {
            "routeNames": [
                "capell-agent-delivery.discovery",
                "capell-agent-delivery.pages.chunks",
                "capell-agent-delivery.pages.index",
                "capell-agent-delivery.pages.manifest"
            ],
            "auth": "public",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["agent-delivery"],
        "cacheSafety": {
            "cacheable": true,
            "variesBy": ["site", "language", "url", "page"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Core\\Models\\Page",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "agent-delivery.package-health",
            "label": "Agent Delivery package API compatibility is discoverable by Diagnostics.",
            "class": "Capell\\AgentDelivery\\Health\\AgentDeliveryHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Serve your published Capell pages to AI agents and answer engines as clean, public-safe JSON manifests and RAG-ready semantic chunks — no scraping, no admin leakage.",
        "screenshots": [],
        "categories": ["frontend", "publishing-pro", "ai"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
