{
    "manifest-version": 3,
    "name": "capell-app/theme-interactive-builder",
    "slug": "theme-interactive-builder",
    "displayName": "Theme Interactive Builder",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Interactive Builder extends the default Capell frontend with a interactive builder product direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for canvas workspaces, builder capabilities, templates, collaboration comments, community showcases, publishing controls, colorful media strips, layer panels, breakpoint previews, and AI helper panels.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\InteractiveBuilder",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\InteractiveBuilder\\InteractiveBuilderThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\InteractiveBuilder\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "interactive-builder"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-interactive-builder-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-interactive-builder",
        "theme-interactive-builder-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-interactive-builder"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-interactive-builder.package-health",
            "label": "Interactive Builder package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\InteractiveBuilder\\Health\\ThemeInteractiveBuilderHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "An expressive Capell theme for visual builders, creative tools, no-code platforms, template marketplaces, collaboration products, and community showcases.",
        "description": "Interactive Builder provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for visual builder products, creative tools, no-code platforms, template marketplaces, design collaboration products, and community showcase sites that need canvas panels, layers, assets, breakpoints, publishing controls, comments, AI helper panels, templates, collaboration states, and live previews.",
        "screenshots": [
            {
                "path": "docs/screenshots/interactive-builder-homepage.png",
                "alt": "Interactive Builder homepage preview",
                "caption": "Interactive Builder Homepage"
            },
            {
                "path": "docs/screenshots/interactive-builder-landing.png",
                "alt": "Interactive Builder landing page preview",
                "caption": "Interactive Builder Landing page"
            },
            {
                "path": "docs/screenshots/interactive-builder-listing.png",
                "alt": "Interactive Builder list page preview",
                "caption": "Interactive Builder List page"
            },
            {
                "path": "docs/screenshots/interactive-builder-search.png",
                "alt": "Interactive Builder search results preview",
                "caption": "Interactive Builder Search results"
            },
            {
                "path": "docs/screenshots/interactive-builder-contact.png",
                "alt": "Interactive Builder contact form preview",
                "caption": "Interactive Builder Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "interactive-builder"
}
