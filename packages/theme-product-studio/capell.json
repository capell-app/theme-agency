{
    "manifest-version": 3,
    "name": "capell-app/theme-product-studio",
    "slug": "theme-product-studio",
    "displayName": "Theme Product Studio",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Product Studio extends the default Capell frontend with a product studio visual direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for web & product studios, engineering agencies.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\ProductStudio",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\ProductStudio\\ProductStudioThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\ProductStudio\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "product-studio"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-product-studio-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-product-studio", "theme-product-studio-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-product-studio"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-product-studio.package-health",
            "label": "Product Studio package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\ProductStudio\\Health\\ThemeProductStudioHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for web & product studios, engineering agencies.",
        "description": "Product Studio provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for Northbound Studio.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Product Studio marketplace card preview",
                "caption": "Product Studio premium theme card"
            },
            {
                "path": "docs/screenshots/product-studio-homepage.png",
                "alt": "Product Studio Homepage demo page screenshot",
                "caption": "Product Studio Homepage page"
            },
            {
                "path": "docs/screenshots/product-studio-directory.png",
                "alt": "Product Studio Directory demo page screenshot",
                "caption": "Product Studio Directory page"
            },
            {
                "path": "docs/screenshots/product-studio-detail.png",
                "alt": "Product Studio Detail demo page screenshot",
                "caption": "Product Studio Detail page"
            },
            {
                "path": "docs/screenshots/product-studio-contact.png",
                "alt": "Product Studio Contact demo page screenshot",
                "caption": "Product Studio Contact page"
            },
            {
                "path": "docs/screenshots/product-studio-empty.png",
                "alt": "Product Studio Empty State demo page screenshot",
                "caption": "Product Studio Empty State page"
            },
            {
                "path": "docs/screenshots/product-studio-not-found.png",
                "alt": "Product Studio 404 State demo page screenshot",
                "caption": "Product Studio 404 State page"
            },
            {
                "path": "docs/screenshots/product-studio-cta.png",
                "alt": "Product Studio Conversion CTA demo page screenshot",
                "caption": "Product Studio Conversion CTA page"
            },
            {
                "path": "docs/screenshots/product-studio-case-studies.png",
                "alt": "Product Studio Case Studies demo page screenshot",
                "caption": "Product Studio Case Studies page"
            },
            {
                "path": "docs/screenshots/product-studio-engagements.png",
                "alt": "Product Studio Engagement Models demo page screenshot",
                "caption": "Product Studio Engagement Models page"
            },
            {
                "path": "docs/screenshots/product-studio-stack.png",
                "alt": "Product Studio Tech Stack demo page screenshot",
                "caption": "Product Studio Tech Stack page"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "product-studio"
}
