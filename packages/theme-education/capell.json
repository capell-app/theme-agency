{
    "manifest-version": 3,
    "name": "capell-app/theme-education",
    "slug": "theme-education",
    "displayName": "Theme Education",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Course and school theme for education providers, training teams, and learning programmes.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\Education",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/foundation-theme"],
        "supports": [
            "capell-app/layout-builder",
            "capell-app/frontend-authoring",
            "capell-app/publishing-studio",
            "capell-app/seo-suite",
            "capell-app/blog"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\Education\\EducationThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\Education\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "education"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-education-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-education", "theme-education-frontend"],
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-education"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "theme-education.package-health",
            "label": "Theme Education package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\Education\\Health\\ThemeEducationHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "marketplace": {
        "summary": "Course and learning-pathway theme screenshots from route-backed demo layouts.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Theme Education extension preview image",
                "caption": "Theme Education extension preview"
            },
            {
                "path": "docs/assets/marketplace/education-event-layout.svg",
                "alt": "Theme Education Event Layout image",
                "caption": "Theme Education Event Layout"
            },
            {
                "path": "docs/assets/marketplace/education-homepage-layout.svg",
                "alt": "Theme Education Homepage Layout image",
                "caption": "Theme Education Homepage Layout"
            },
            {
                "path": "docs/assets/marketplace/education-program-layout.svg",
                "alt": "Theme Education Program Layout image",
                "caption": "Theme Education Program Layout"
            },
            {
                "path": "docs/assets/marketplace/hero-desktop.jpg",
                "alt": "Theme Education Hero Desktop image",
                "caption": "Theme Education Hero Desktop"
            },
            {
                "path": "docs/assets/marketplace/hero-mobile.jpg",
                "alt": "Theme Education Hero Mobile image",
                "caption": "Theme Education Hero Mobile"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "capell-app/foundation-theme",
    "themeKey": "education",
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    }
}
