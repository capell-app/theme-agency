{
    "manifest-version": 3,
    "name": "capell-app/theme-education",
    "slug": "theme-education",
    "displayName": "Theme Education",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Course and school theme for education providers, training teams, and learning programmes.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\Education",
    "surfaces": ["frontend", "console"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/access-gate",
            "capell-app/blog",
            "capell-app/bookings",
            "capell-app/customer-portal",
            "capell-app/events",
            "capell-app/frontend-authoring",
            "capell-app/form-builder",
            "capell-app/layout-builder",
            "capell-app/payments",
            "capell-app/publishing-studio",
            "capell-app/seo-suite"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\Education\\EducationThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\Education\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "education"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-education-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-education", "theme-education-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-education"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "theme-education.package-health",
            "label": "Theme Education package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\Education\\Health\\ThemeEducationHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "marketplace": {
        "summary": "A polished, course-first theme for schools, academies, and training providers — turning programme discovery, faculty trust, open days, and enrolment into one coherent learner journey.",
        "description": "Theme Education gives schools, course providers, and training teams a complete learning-pathway frontend without commissioning a custom build. Purpose-shaped sections cover course catalogues, instructor and mentor profiles, learning outcomes, open days, resources, FAQs, and a guided enrolment call-to-action. It integrates optionally with Capell Events for open-day calendars, Form Builder for applications and enquiries, and Blog for learning resources — degrading gracefully when those aren't installed. Built on the built-in default frontend theme with brand-token theming, an accessible skip link and focus states, and zero database impact, so editors compose education pages through the normal Layout Builder workflow.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Theme Education marketplace card.",
                "caption": "Theme Education theme card."
            },
            {
                "path": "docs/screenshots/education-course-catalogue-layout.png",
                "alt": "Theme Education Education Course Catalogue Layout screenshot",
                "caption": "Education Course Catalogue Layout rendered with the Theme Education theme."
            },
            {
                "path": "docs/screenshots/education-enrolment-layout.png",
                "alt": "Theme Education Education Enrolment Layout screenshot",
                "caption": "Education Enrolment Layout rendered with the Theme Education theme."
            },
            {
                "path": "docs/screenshots/education-events-layout.png",
                "alt": "Theme Education Education Events Layout screenshot",
                "caption": "Education Events Layout rendered with the Theme Education theme."
            },
            {
                "path": "docs/screenshots/education-homepage-layout.png",
                "alt": "Theme Education Education Homepage Layout screenshot",
                "caption": "Education Homepage Layout rendered with the Theme Education theme."
            },
            {
                "path": "docs/screenshots/education-instructors-layout.png",
                "alt": "Theme Education Education Instructors Layout screenshot",
                "caption": "Education Instructors Layout rendered with the Theme Education theme."
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": null,
    "themeKey": "education",
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    }
}
