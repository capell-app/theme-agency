{
    "manifest-version": 3,
    "name": "capell-app/theme-ai-agent",
    "slug": "theme-ai-agent",
    "displayName": "Theme AI Agent",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "AI Agent extends the default Capell frontend with a ai agent visual direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for ai support agents, ops automation products.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\AiAgent",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\AiAgent\\AiAgentThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\AiAgent\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "ai-agent"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-ai-agent-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-ai-agent", "theme-ai-agent-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-ai-agent"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-ai-agent.package-health",
            "label": "AI Agent package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\AiAgent\\Health\\ThemeAiAgentHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for ai support agents, ops automation products.",
        "description": "AI Agent provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for Aria Agents.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "AI Agent marketplace card preview",
                "caption": "AI Agent premium theme card"
            },
            {
                "path": "docs/screenshots/ai-agent-homepage.png",
                "alt": "AI Agent Homepage demo page screenshot",
                "caption": "AI Agent Homepage page"
            },
            {
                "path": "docs/screenshots/ai-agent-directory.png",
                "alt": "AI Agent Directory demo page screenshot",
                "caption": "AI Agent Directory page"
            },
            {
                "path": "docs/screenshots/ai-agent-detail.png",
                "alt": "AI Agent Detail demo page screenshot",
                "caption": "AI Agent Detail page"
            },
            {
                "path": "docs/screenshots/ai-agent-contact.png",
                "alt": "AI Agent Contact demo page screenshot",
                "caption": "AI Agent Contact page"
            },
            {
                "path": "docs/screenshots/ai-agent-empty.png",
                "alt": "AI Agent Empty State demo page screenshot",
                "caption": "AI Agent Empty State page"
            },
            {
                "path": "docs/screenshots/ai-agent-not-found.png",
                "alt": "AI Agent 404 State demo page screenshot",
                "caption": "AI Agent 404 State page"
            },
            {
                "path": "docs/screenshots/ai-agent-cta.png",
                "alt": "AI Agent Conversion CTA demo page screenshot",
                "caption": "AI Agent Conversion CTA page"
            },
            {
                "path": "docs/screenshots/ai-agent-use-cases.png",
                "alt": "AI Agent Use Cases demo page screenshot",
                "caption": "AI Agent Use Cases page"
            },
            {
                "path": "docs/screenshots/ai-agent-integrations.png",
                "alt": "AI Agent Integrations demo page screenshot",
                "caption": "AI Agent Integrations page"
            },
            {
                "path": "docs/screenshots/ai-agent-roi.png",
                "alt": "AI Agent ROI Calculator demo page screenshot",
                "caption": "AI Agent ROI Calculator page"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "ai-agent"
}
