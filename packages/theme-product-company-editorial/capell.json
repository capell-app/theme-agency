{
    "manifest-version": 3,
    "name": "capell-app/theme-product-company-editorial",
    "slug": "theme-product-company-editorial",
    "displayName": "Theme Product Company Editorial",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Product Company Editorial extends the default Capell frontend with a product-company journal direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for dark mastheads, topic labels, author metadata, product updates, design essays, engineering posts, templates, culture stories, and newsletter conversion.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\ProductCompanyEditorial",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\ProductCompanyEditorial\\ProductCompanyEditorialThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\ProductCompanyEditorial\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "product-company-editorial"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-product-company-editorial-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-product-company-editorial",
        "theme-product-company-editorial-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-product-company-editorial"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-product-company-editorial.package-health",
            "label": "Product Company Editorial package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\ProductCompanyEditorial\\Health\\ThemeProductCompanyEditorialHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for product-company blogs, product updates, design essays, engineering posts, templates, culture stories, and newsletters.",
        "description": "Product Company Editorial provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for product companies that publish useful stories across product, design, engineering, templates, and culture.",
        "screenshots": [
            {
                "path": "docs/screenshots/product-company-editorial-homepage.png",
                "alt": "Product Company Editorial homepage preview",
                "caption": "Product Company Editorial Homepage"
            },
            {
                "path": "docs/screenshots/product-company-editorial-landing.png",
                "alt": "Product Company Editorial landing page preview",
                "caption": "Product Company Editorial Landing page"
            },
            {
                "path": "docs/screenshots/product-company-editorial-listing.png",
                "alt": "Product Company Editorial list page preview",
                "caption": "Product Company Editorial List page"
            },
            {
                "path": "docs/screenshots/product-company-editorial-search.png",
                "alt": "Product Company Editorial search results preview",
                "caption": "Product Company Editorial Search results"
            },
            {
                "path": "docs/screenshots/product-company-editorial-contact.png",
                "alt": "Product Company Editorial contact form preview",
                "caption": "Product Company Editorial Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "product-company-editorial"
}
