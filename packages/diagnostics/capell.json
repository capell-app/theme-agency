{
    "manifest-version": 3,
    "name": "capell-app/diagnostics",
    "slug": "diagnostics",
    "displayName": "Diagnostics",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Diagnostics adds operational diagnostics for cache, configuration drift, migrations, packages, registries, queues, mail, storage, public-output safety, permissions, package ownership, setup health, and Tailwind build status.",
    "product": {
        "group": "Capell Operations",
        "tier": "premium",
        "bundle": "operations"
    },
    "namespace": "Capell\\Diagnostics",
    "surfaces": ["admin", "console"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/html-cache"
        ],
        "supports": ["croustibat/filament-jobs-monitor"],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\Diagnostics\\Providers\\DiagnosticsServiceProvider"
        ],
        "admin": ["Capell\\Diagnostics\\Providers\\AdminServiceProvider"],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\Diagnostics\\Manifest\\DiagnosticsPageContribution",
            "pageClass": "Capell\\Diagnostics\\Filament\\Pages\\DiagnosticsPage",
            "labelKey": "capell-diagnostics::package.diagnostics"
        },
        {
            "type": "admin-page",
            "class": "Capell\\Diagnostics\\Manifest\\CommandPalettePageContribution",
            "pageClass": "Capell\\Diagnostics\\Filament\\Pages\\CommandPalettePage",
            "labelKey": "capell-diagnostics::package.command_palette"
        },
        {
            "type": "admin-page",
            "class": "Capell\\Diagnostics\\Manifest\\SystemHealthPageContribution",
            "pageClass": "Capell\\Diagnostics\\Filament\\Pages\\SystemHealthPage",
            "labelKey": "capell-diagnostics::package.system_health"
        },
        {
            "type": "admin-page",
            "class": "Capell\\Diagnostics\\Manifest\\QueueHealthPageContribution",
            "pageClass": "Capell\\Diagnostics\\Filament\\Pages\\QueueHealthPage",
            "labelKey": "capell-diagnostics::package.queue_health"
        },
        {
            "type": "admin-page",
            "class": "Capell\\Diagnostics\\Manifest\\PermissionAuditPageContribution",
            "pageClass": "Capell\\Diagnostics\\Filament\\Pages\\PermissionAuditPage",
            "labelKey": "capell-diagnostics::package.permission_audit"
        },
        {
            "type": "dashboard-widget",
            "class": "Capell\\Diagnostics\\Manifest\\SiteHealthWidgetContribution",
            "widgetClass": "Capell\\Diagnostics\\Filament\\Widgets\\Health\\SiteHealthWidgetAbstract"
        },
        {
            "type": "dashboard-widget",
            "class": "Capell\\Diagnostics\\Manifest\\SystemHealthWidgetsContribution",
            "widgetClasses": [
                "Capell\\Diagnostics\\Filament\\Widgets\\Health\\SetupHealthWidgetAbstract",
                "Capell\\Diagnostics\\Filament\\Widgets\\Health\\AlertsWidgetAbstract",
                "Capell\\Diagnostics\\Filament\\Widgets\\Health\\ContentHealthWidgetAbstract",
                "Capell\\Diagnostics\\Filament\\Widgets\\Health\\ContentGraphHealthWidgetAbstract",
                "Capell\\Diagnostics\\Filament\\Widgets\\Health\\RegistryHealthWidgetAbstract",
                "Capell\\Diagnostics\\Filament\\Widgets\\Health\\MigrationsHealthWidgetAbstract",
                "Capell\\Diagnostics\\Filament\\Widgets\\Health\\PackagesInstalledWidgetAbstract",
                "Capell\\Diagnostics\\Filament\\Widgets\\Health\\ConfigDriftWidgetAbstract",
                "Capell\\Diagnostics\\Filament\\Widgets\\Health\\CacheHealthWidgetAbstract",
                "Capell\\Diagnostics\\Filament\\Widgets\\Health\\TailwindBuildStatusWidgetAbstract"
            ]
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": ["command_palette_runs", "queue_monitors"]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "actions": {
        "buildCacheHealth": "Capell\\Diagnostics\\Actions\\Dashboard\\BuildCacheHealthAction",
        "buildConfigDrift": "Capell\\Diagnostics\\Actions\\Dashboard\\BuildConfigDriftAction",
        "buildMigrationsHealth": "Capell\\Diagnostics\\Actions\\Dashboard\\BuildMigrationsHealthAction",
        "buildPackagesInstalled": "Capell\\Diagnostics\\Actions\\Dashboard\\BuildPackagesInstalledAction",
        "buildRegistryHealth": "Capell\\Diagnostics\\Actions\\Dashboard\\BuildRegistryHealthAction",
        "buildSetupHealth": "Capell\\Diagnostics\\Actions\\Dashboard\\BuildSetupHealthAction",
        "buildTailwindBuildStatus": "Capell\\Diagnostics\\Actions\\Dashboard\\BuildTailwindBuildStatusAction",
        "buildInfrastructureStatus": "Capell\\Diagnostics\\Actions\\DashboardReports\\BuildInfrastructureStatusAction",
        "buildPublicOutputSafetyReport": "Capell\\Diagnostics\\Actions\\DashboardReports\\BuildPublicOutputSafetyReportAction",
        "buildPermissionAuditQuery": "Capell\\Diagnostics\\Actions\\DashboardReports\\BuildPermissionAuditQueryAction",
        "buildQueueHealthQuery": "Capell\\Diagnostics\\Actions\\DashboardReports\\BuildQueueHealthQueryAction",
        "buildQueueOperationsStats": "Capell\\Diagnostics\\Actions\\DashboardReports\\BuildQueueOperationsStatsAction",
        "ensureDiagnosticsPermissions": "Capell\\Diagnostics\\Actions\\EnsureDiagnosticsPermissionsAction",
        "inspectPackageOwnership": "Capell\\Diagnostics\\Actions\\InspectPackageOwnershipAction"
    },
    "settings": [],
    "permissions": [
        "accessDiagnostics",
        "viewDiagnostics",
        "View:PermissionAuditPage",
        "View:CommandPalettePage",
        "View:QueueHealthPage",
        "Manage:QueueHealthPage"
    ],
    "capabilities": [
        "diagnostics",
        "diagnostics-admin",
        "diagnostics-console",
        "diagnostics-cross-package-install-health",
        "diagnostics-public-output-safety",
        "diagnostics-infrastructure-status",
        "diagnostics-package-ownership"
    ],
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": [],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "diagnostics.package-catalog",
            "label": "Installed Capell packages are discovered from composer metadata",
            "class": "Capell\\Diagnostics\\Health\\DiagnosticsHealthCheck",
            "severity": "critical",
            "surface": "admin"
        },
        {
            "key": "diagnostics.manifest-health",
            "label": "Package manifests expose bundle, command, and health-check metadata",
            "class": "Capell\\Diagnostics\\Health\\DiagnosticsHealthCheck",
            "severity": "warning",
            "surface": "admin"
        },
        {
            "key": "diagnostics.system-health-widgets",
            "label": "System health widgets are registered for developer users",
            "class": "Capell\\Diagnostics\\Health\\DiagnosticsHealthCheck",
            "severity": "critical",
            "surface": "admin"
        },
        {
            "key": "diagnostics.queue-health",
            "label": "Queue health page and failed-job summary are available",
            "class": "Capell\\Diagnostics\\Health\\DiagnosticsHealthCheck",
            "severity": "warning",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Diagnostics adds operational diagnostics for cache, configuration drift, migrations, packages, registries, queues, mail, storage, public-output safety, permissions, package ownership, setup health, Tailwind build status, and Queue Operations powered by croustibat/filament-jobs-monitor telemetry.",
        "credits": [
            {
                "name": "croustibat/filament-jobs-monitor",
                "url": "https://github.com/ultraviolettes/filament-jobs-monitor",
                "role": "Upstream queue telemetry dependency used by Diagnostics Queue Operations."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Diagnostics extension preview image",
                "caption": "Diagnostics extension preview"
            }
        ],
        "categories": ["admin", "console", "operations"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
