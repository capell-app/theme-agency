{
    "manifest-version": 3,
    "name": "capell-app/login-audit",
    "slug": "login-audit",
    "displayName": "Login Audit",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Login Audit gives Capell operators a complete, immutable record of who accessed the admin and storefront, when, from which IP and device, and whether each attempt succeeded. A dedicated Filament resource, dashboard widget, and per-user access summary make it easy to spot unusual activity and respond to incidents, while configurable retention keeps the log lean and aligned with your data-protection policy. IP capture can be disabled or resolved through your CDN (Cloudflare and similar), and the audit log is read-only by design so records can't be quietly altered. Built on the battle-tested Laravel authentication-log foundation and wired into Capell's settings, permissions, and Diagnostics.",
    "product": {
        "group": "Capell Operations",
        "tier": "premium",
        "bundle": "operations"
    },
    "namespace": "Capell\\LoginAudit",
    "surfaces": ["admin"],
    "dependencies": {
        "requires": ["capell-app/admin"],
        "supports": [
            "capell-app/password-policy",
            "capell-app/privacy-center",
            "capell-app/diagnostics",
            "capell-app/access-gate"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "auth": ["Capell\\LoginAudit\\Providers\\LoginAuditServiceProvider"],
        "runtime": ["Capell\\LoginAudit\\Providers\\LoginAuditServiceProvider"],
        "admin": ["Capell\\LoginAudit\\Providers\\AdminServiceProvider"],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\LoginAudit\\Manifest\\LoginAuditAdminResourcesContribution",
            "resourceClass": "Capell\\LoginAudit\\Filament\\Resources\\LoginAudits\\LoginAuditResource"
        },
        {
            "type": "dashboard-widget",
            "class": "Capell\\LoginAudit\\Manifest\\LoginAuditDashboardWidgetContribution",
            "widgetClass": "Capell\\LoginAudit\\Filament\\Widgets\\LoginAuditsWidget",
            "dashboard": "system-health"
        },
        {
            "type": "model",
            "class": "Capell\\LoginAudit\\Manifest\\LoginAuditModelsContribution",
            "modelClass": "Capell\\LoginAudit\\Models\\LoginAudit"
        },
        {
            "type": "setting",
            "class": "Capell\\LoginAudit\\Manifest\\LoginAuditSettingsContribution",
            "settingsClass": "Capell\\LoginAudit\\Settings\\LoginAuditSettings",
            "settingsGroup": "login_audit"
        },
        {
            "type": "permission",
            "class": "Capell\\LoginAudit\\Manifest\\LoginAuditPermissionsContribution",
            "permissions": ["View:LoginAudit"]
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\LoginAudit\\Manifest\\LoginAuditPurgeScheduleContribution",
            "command": "authentication-log:purge",
            "frequency": "daily"
        },
        {
            "type": "health-check",
            "class": "Capell\\LoginAudit\\Manifest\\LoginAuditHealthContribution",
            "checkClass": "Capell\\LoginAudit\\Health\\LoginAuditHealthCheck"
        }
    ],
    "database": {
        "migrations": true,
        "settings": true,
        "requiredTables": ["login_audit"]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "actions": {
        "applyLoginAuditSettings": "Capell\\LoginAudit\\Actions\\ApplyLoginAuditSettingsAction",
        "buildLoginAuditsCsv": "Capell\\LoginAudit\\Actions\\BuildLoginAuditsCsvAction",
        "buildLoginAuditsQuery": "Capell\\LoginAudit\\Actions\\BuildLoginAuditsQueryAction",
        "detectSuspiciousLogin": "Capell\\LoginAudit\\Actions\\DetectSuspiciousLoginAction",
        "recordLoginAuditPurge": "Capell\\LoginAudit\\Actions\\RecordLoginAuditPurgeAction",
        "resolveLoginAuditIpAddress": "Capell\\LoginAudit\\Actions\\ResolveLoginAuditIpAddressAction",
        "sendLoginAuditAdminAlert": "Capell\\LoginAudit\\Actions\\SendLoginAuditAdminAlertAction",
        "shouldTrackAdminActivity": "Capell\\LoginAudit\\Actions\\ShouldTrackAdminActivityAction",
        "shouldTrackUserIpAddresses": "Capell\\LoginAudit\\Actions\\ShouldTrackUserIpAddressesAction",
        "updateLastSeenForActor": "Capell\\LoginAudit\\Actions\\UpdateLastSeenForActorAction"
    },
    "settings": ["Capell\\LoginAudit\\Settings\\LoginAuditSettings"],
    "permissions": ["View:LoginAudit"],
    "capabilities": [
        "login-audit",
        "login-audit-admin",
        "login-audit-device-activity",
        "login-audit-csv-export",
        "login-audit-detection",
        "login-audit-admin-alerts"
    ],
    "security": {
        "riskTier": "sensitive",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": ["View:LoginAudit"]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": [],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "login-audit.package-health",
            "label": "Login Audit package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\LoginAudit\\Health\\LoginAuditHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Tamper-proof access logging for Capell — track every login, failed attempt, logout, device, and session, with retention controls and an admin audit trail built for security and compliance reviews.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Login Audit extension preview image",
                "caption": "Login Audit extension preview"
            },
            {
                "path": "docs/screenshots/login-audits-admin-index.png",
                "alt": "Login Audit admin index listing successful and failed authentication events",
                "caption": "Review successful and failed authentication events in the admin index"
            },
            {
                "path": "docs/screenshots/login-audits-admin-index-dark.png",
                "alt": "Login Audit admin index in dark mode",
                "caption": "The authentication log admin index in dark mode"
            },
            {
                "path": "docs/screenshots/login-audit-table-filters.png",
                "alt": "Login Audit table filters for access status and login date range",
                "caption": "Filter events by access status, login date range, or cleared-by-user state"
            },
            {
                "path": "docs/screenshots/login-audit-table-filters-dark.png",
                "alt": "Login Audit table filters in dark mode",
                "caption": "Table filters for the access log in dark mode"
            },
            {
                "path": "docs/screenshots/dashboard-widget.png",
                "alt": "Login Audit dashboard widget showing recent access activity",
                "caption": "Surface recent access activity on the admin dashboard"
            },
            {
                "path": "docs/screenshots/dashboard-widget-dark.png",
                "alt": "Login Audit dashboard widget in dark mode",
                "caption": "The access log dashboard widget in dark mode"
            },
            {
                "path": "docs/screenshots/login-audit-settings-screen.png",
                "alt": "Login Audit settings for retention, IP tracking, and visibility",
                "caption": "Configure retention, IP tracking, and visibility from Capell settings"
            },
            {
                "path": "docs/screenshots/login-audit-settings-screen-dark.png",
                "alt": "Login Audit settings screen in dark mode",
                "caption": "The access log settings screen in dark mode"
            },
            {
                "path": "docs/screenshots/user-edit-access-summary.png",
                "alt": "Login Audit user edit access summary",
                "caption": "Review recent logins, failed attempts, devices, and active sessions while editing a user"
            },
            {
                "path": "docs/screenshots/user-login-audits-relation-manager.png",
                "alt": "Login Audit user authentication history relation manager",
                "caption": "Open user-owned authentication history with device and trusted-state context"
            }
        ],
        "categories": ["admin", "operations"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
