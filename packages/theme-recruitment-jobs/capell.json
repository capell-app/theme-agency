{
    "manifest-version": 3,
    "name": "capell-app/theme-recruitment-jobs",
    "slug": "theme-recruitment-jobs",
    "displayName": "Theme Recruitment & Jobs",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Recruitment & Jobs extends the default Capell frontend with a recruitment & jobs visual direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for recruitment agencies, job boards.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\RecruitmentJobs",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\RecruitmentJobs\\RecruitmentJobsThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\RecruitmentJobs\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "recruitment-jobs"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-recruitment-jobs-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-recruitment-jobs",
        "theme-recruitment-jobs-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-recruitment-jobs"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-recruitment-jobs.package-health",
            "label": "Recruitment & Jobs package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\RecruitmentJobs\\Health\\ThemeRecruitmentJobsHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for recruitment agencies, job boards.",
        "description": "Recruitment & Jobs provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for Beacon Talent.",
        "screenshots": [
            {
                "path": "docs/screenshots/recruitment-jobs-homepage.png",
                "alt": "Recruitment & Jobs homepage preview",
                "caption": "Recruitment & Jobs Homepage"
            },
            {
                "path": "docs/screenshots/recruitment-jobs-landing.png",
                "alt": "Recruitment & Jobs landing page preview",
                "caption": "Recruitment & Jobs Landing page"
            },
            {
                "path": "docs/screenshots/recruitment-jobs-listing.png",
                "alt": "Recruitment & Jobs list page preview",
                "caption": "Recruitment & Jobs List page"
            },
            {
                "path": "docs/screenshots/recruitment-jobs-search.png",
                "alt": "Recruitment & Jobs search results preview",
                "caption": "Recruitment & Jobs Search results"
            },
            {
                "path": "docs/screenshots/recruitment-jobs-contact.png",
                "alt": "Recruitment & Jobs contact form preview",
                "caption": "Recruitment & Jobs Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "recruitment-jobs"
}
