{
    "name": "capell-app/theme-nonprofit",
    "description": "A premium charity, NGO, and civic theme that moves visitors from your mission to a clear support action — donate, volunteer, or follow — with impact proof, live campaign progress, and transparent annual-report sections built in.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "capell-app/core": "^4.0 || 4.x-dev",
        "capell-app/foundation-theme": "^4.0 || 4.x-dev"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Capell\\ThemeStudio\\Nonprofit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\ThemeStudio\\Nonprofit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\ThemeStudio\\Nonprofit\\NonprofitThemeServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "homepage": "https://github.com/capell-app/theme-nonprofit",
    "keywords": [
        "capell",
        "cms",
        "laravel",
        "theme"
    ],
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/theme-nonprofit"
    }
}
