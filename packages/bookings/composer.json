{
    "name": "capell-app/bookings",
    "description": "Bookings and appointment requests for Capell",
    "keywords": [
        "capell",
        "bookings",
        "appointments",
        "calendar",
        "laravel",
        "cms"
    ],
    "homepage": "https://github.com/capell-app/bookings",
    "license": "proprietary",
    "authors": [
        {
            "name": "Howdu",
            "email": "capell.app26@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "capell-app/admin": "^4.0 || 4.x-dev",
        "capell-app/core": "^4.0 || 4.x-dev",
        "filament/filament": "^4.0|^5.0",
        "filament/support": "^4.7|^5.2",
        "lorisleiva/laravel-actions": "^2.8",
        "spatie/laravel-data": "^4.5"
    },
    "suggest": {
        "spatie/icalendar-generator": "Build downloadable iCalendar exports for confirmed appointment requests."
    },
    "autoload": {
        "psr-4": {
            "Capell\\Bookings\\": "src/",
            "Capell\\Bookings\\Database\\Factories\\": "database/factories"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\Bookings\\Providers\\BookingsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true,
    "type": "library",
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/bookings"
    }
}
