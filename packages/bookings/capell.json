{
    "manifest-version": 3,
    "name": "capell-app/bookings",
    "slug": "bookings",
    "displayName": "Bookings",
    "kind": "plugin",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Bookings adds services, staff, locations, availability, appointment requests, confirmations, reminders, and calendar feeds.",
    "product": {
        "group": "Capell Operations",
        "tier": "premium",
        "bundle": "operations"
    },
    "namespace": "Capell\\Bookings",
    "surfaces": ["admin", "console", "frontend"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core"],
        "supports": [
            "capell-app/address",
            "capell-app/events",
            "capell-app/form-builder",
            "capell-app/notifications",
            "capell-app/seo-suite"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": ["Capell\\Bookings\\Providers\\BookingsServiceProvider"],
        "admin": ["Capell\\Bookings\\Providers\\BookingsServiceProvider"],
        "frontend": ["Capell\\Bookings\\Providers\\BookingsServiceProvider"]
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\Bookings\\Manifest\\BookingServiceResourceContribution",
            "resourceClass": "Capell\\Bookings\\Filament\\Resources\\BookingServices\\BookingServiceResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\Bookings\\Manifest\\BookingStaffMemberResourceContribution",
            "resourceClass": "Capell\\Bookings\\Filament\\Resources\\BookingStaffMembers\\BookingStaffMemberResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\Bookings\\Manifest\\BookingLocationResourceContribution",
            "resourceClass": "Capell\\Bookings\\Filament\\Resources\\BookingLocations\\BookingLocationResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\Bookings\\Manifest\\BookingAvailabilityWindowResourceContribution",
            "resourceClass": "Capell\\Bookings\\Filament\\Resources\\BookingAvailabilityWindows\\BookingAvailabilityWindowResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\Bookings\\Manifest\\BookingAvailabilityExceptionResourceContribution",
            "resourceClass": "Capell\\Bookings\\Filament\\Resources\\BookingAvailabilityExceptions\\BookingAvailabilityExceptionResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\Bookings\\Manifest\\AppointmentRequestResourceContribution",
            "resourceClass": "Capell\\Bookings\\Filament\\Resources\\AppointmentRequests\\AppointmentRequestResource"
        },
        {
            "type": "model",
            "class": "Capell\\Bookings\\Manifest\\BookingsModelsContribution"
        },
        {
            "type": "route",
            "class": "Capell\\Bookings\\Manifest\\BookingsFrontendRoutesContribution"
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\Bookings\\Manifest\\BookingsReminderScheduleContribution",
            "name": "capell-bookings-send-due-reminders",
            "command": "capell:bookings:send-due-reminders",
            "frequency": "everyFiveMinutes"
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": [
            "booking_services",
            "booking_staff_members",
            "booking_locations",
            "booking_availability_windows",
            "booking_availability_exceptions",
            "appointment_requests",
            "appointment_audit_logs"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "actions": {
        "createAvailabilityException": "Capell\\Bookings\\Actions\\CreateAvailabilityExceptionAction",
        "createAppointmentRequest": "Capell\\Bookings\\Actions\\CreateAppointmentRequestAction",
        "confirmAppointmentRequest": "Capell\\Bookings\\Actions\\ConfirmAppointmentRequestAction",
        "cancelAppointmentRequest": "Capell\\Bookings\\Actions\\CancelAppointmentRequestAction",
        "queueAppointmentReminder": "Capell\\Bookings\\Actions\\QueueAppointmentReminderAction",
        "createStaffCalendarFeedUrl": "Capell\\Bookings\\Actions\\CreateStaffCalendarFeedUrlAction",
        "buildStaffCalendarFeed": "Capell\\Bookings\\Actions\\BuildStaffCalendarFeedAction",
        "buildPublicBookingRequestOptions": "Capell\\Bookings\\Actions\\BuildPublicBookingRequestOptionsAction",
        "buildPublicBookingRequestProps": "Capell\\Bookings\\Actions\\BuildPublicBookingRequestPropsAction",
        "buildAvailableBookingSlots": "Capell\\Bookings\\Actions\\BuildAvailableBookingSlotsAction"
    },
    "settings": [],
    "permissions": [
        "View:BookingService",
        "Create:BookingService",
        "Update:BookingService",
        "Delete:BookingService",
        "View:BookingStaffMember",
        "Create:BookingStaffMember",
        "Update:BookingStaffMember",
        "Delete:BookingStaffMember",
        "View:BookingLocation",
        "Create:BookingLocation",
        "Update:BookingLocation",
        "Delete:BookingLocation",
        "View:BookingAvailabilityWindow",
        "Create:BookingAvailabilityWindow",
        "Update:BookingAvailabilityWindow",
        "Delete:BookingAvailabilityWindow",
        "View:BookingAvailabilityException",
        "Create:BookingAvailabilityException",
        "Update:BookingAvailabilityException",
        "Delete:BookingAvailabilityException",
        "View:AppointmentRequest",
        "Update:AppointmentRequest"
    ],
    "capabilities": [
        "bookings",
        "bookings-availability",
        "bookings-availability-exceptions",
        "bookings-holidays",
        "bookings-capacity",
        "bookings-lead-times",
        "bookings-service-buffers",
        "bookings-appointment-requests",
        "bookings-appointment-audit",
        "bookings-notifications",
        "bookings-reminders",
        "bookings-calendar-feeds"
    ],
    "security": {
        "riskTier": "sensitive",
        "publicSurface": {
            "routeNames": ["calendar.staff", "request", "request.store"],
            "auth": "public",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": ["calendar.staff"],
            "webhookRoutes": [],
            "throttledRoutes": ["request.store"]
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": [
                "appointment_requests.confirmation_token: Reviewed package field; not stored as a reusable secret by this package contract.",
                "booking_staff_members.calendar_feed_token: Reviewed package field; not stored as a reusable secret by this package contract."
            ]
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 20,
        "cacheTags": ["bookings"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "bookings.package-health",
            "label": "Bookings models, migrations, and appointment request actions are discoverable.",
            "class": "Capell\\Bookings\\Health\\BookingsHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Bookings adds appointment request workflows, availability, confirmations, reminders, and calendar feeds for healthcare, services, education, consulting, nonprofit, and portfolio sites.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.svg",
                "alt": "Bookings extension marketplace card.",
                "caption": "Bookings extension preview for Marketplace cards."
            },
            {
                "path": "docs/screenshots/public-booking-request.png",
                "alt": "Public booking request form showing service, staff, location, time, and customer fields.",
                "caption": "Visitors request appointments through a route-backed public form validated against availability, capacity, buffers, and timezone."
            },
            {
                "path": "docs/screenshots/appointment-requests-admin.png",
                "alt": "Admin appointment request queue with requested, confirmed, and audited booking states.",
                "caption": "Operators review seeded requests, confirm or cancel appointments, and keep an audit trail for each workflow event."
            }
        ],
        "categories": ["admin", "calendar", "operations"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
