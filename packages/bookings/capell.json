                "Capell\\Bookings\\Console\\SendDueAppointmentRemindersCommand",
                "Capell\\Bookings\\Console\\ExpireBookingWorkflowStateCommand",
                "Capell\\Bookings\\Console\\ScheduleBookingReviewRequestsCommand",
                "Capell\\Bookings\\Console\\PruneBookingRetentionDataCommand"
            ]
        }
