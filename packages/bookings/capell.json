{
    "manifest-version": 3,
    "name": "capell-app/bookings",
    "slug": "bookings",
    "displayName": "Bookings",
    "kind": "plugin",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Bookings turns public appointment requests into a managed Capell operations workflow with availability, reminders, reviews, waitlists, travel planning, reporting, and optional advanced automation.",
    "product": {
        "group": "Capell Operations",
        "tier": "premium",
        "bundle": "operations"
    },
    "namespace": "Capell\\Bookings",
    "surfaces": ["admin", "console", "frontend"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/customer-portal"
        ],
        "supports": [
            "capell-app/address",
            "capell-app/ai-orchestrator",
            "capell-app/events",
            "capell-app/form-builder",
            "capell-app/media-library",
            "capell-app/notifications",
            "capell-app/payments",
            "capell-app/seo-suite"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": ["Capell\\Bookings\\Providers\\BookingsServiceProvider"],
        "admin": ["Capell\\Bookings\\Providers\\BookingsServiceProvider"],
        "frontend": ["Capell\\Bookings\\Providers\\BookingsServiceProvider"]
    },
    "contributes": [
