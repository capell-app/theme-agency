        {
            "type": "scheduled-job",
            "class": "Capell\\Bookings\\Manifest\\BookingsReminderScheduleContribution",
            "name": "capell-bookings-send-due-reminders",
            "command": "capell:bookings:send-due-reminders",
            "frequency": "everyFiveMinutes"
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\Bookings\\Manifest\\BookingsReminderScheduleContribution",
            "name": "capell-bookings-expire-workflow-state",
            "command": "capell:bookings:expire-workflow-state",
            "frequency": "everyFiveMinutes"
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\Bookings\\Manifest\\BookingsReminderScheduleContribution",
            "name": "capell-bookings-schedule-review-requests",
            "command": "capell:bookings:schedule-review-requests",
            "frequency": "hourly"
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\Bookings\\Manifest\\BookingsReminderScheduleContribution",
            "name": "capell-bookings-prune-retention-data",
            "command": "capell:bookings:prune-retention-data",
            "frequency": "daily"
        },
        {
            "type": "console-command",
            "class": "Capell\\Bookings\\Manifest\\BookingsConsoleCommandsContribution",
            "commands": [
                "capell:bookings-demo",
                "capell:bookings:send-due-reminders",
                "capell:bookings:expire-workflow-state",
                "capell:bookings:schedule-review-requests",
                "capell:bookings:prune-retention-data"
            ],
