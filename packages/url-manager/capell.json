{
    "manifest-version": 3,
    "name": "capell-app/url-manager",
    "slug": "url-manager",
    "displayName": "URL Manager",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "URL Manager keeps your site's link equity intact when pages move or get renamed. It auto-creates redirects when a page URL changes, resolves exact, prefix, and regex rules on the live request, and tracks hit counts so you can see which redirects matter. Repeated 404s and SEO Suite broken-link findings surface as one-click redirect opportunities, with CSV import/export for bulk migrations. Built for editors and SEO teams who need redirect hygiene without touching server config.",
    "product": {
        "group": "Capell Search & SEO",
        "tier": "premium",
        "bundle": "search-seo"
    },
    "namespace": "Capell\\UrlManager",
    "surfaces": ["admin", "frontend"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core"],
        "supports": [
            "capell-app/migration-assistant",
            "capell-app/seo-suite",
            "capell-app/site-discovery",
            "capell-app/wordpress-importer"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": ["Capell\\UrlManager\\Providers\\UrlManagerServiceProvider"],
        "admin": ["Capell\\UrlManager\\Providers\\UrlManagerServiceProvider"],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\UrlManager\\Manifest\\RedirectRulesPageContribution",
            "pageClass": "Capell\\UrlManager\\Filament\\Pages\\RedirectRulesPage"
        },
        {
            "type": "admin-page",
            "class": "Capell\\UrlManager\\Manifest\\NotFoundOpportunitiesPageContribution",
            "pageClass": "Capell\\UrlManager\\Filament\\Pages\\NotFoundOpportunitiesPage"
        },
        {
            "type": "model",
            "class": "Capell\\UrlManager\\Manifest\\UrlManagerModelsContribution",
            "modelClasses": [
                "Capell\\UrlManager\\Models\\RedirectRule",
                "Capell\\UrlManager\\Models\\RedirectHit",
                "Capell\\UrlManager\\Models\\NotFoundOpportunity"
            ]
        },
        {
            "type": "console-command",
            "class": "Capell\\UrlManager\\Manifest\\UrlManagerConsoleCommandsContribution",
            "commands": ["url-manager:prune-hits"],
            "commandClasses": [
                "Capell\\UrlManager\\Console\\Commands\\PruneRedirectHitsCommand"
            ]
        },
        {
            "type": "health-check",
            "class": "Capell\\UrlManager\\Manifest\\UrlManagerHealthContribution",
            "checkClass": "Capell\\UrlManager\\Health\\UrlManagerHealthCheck"
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": [
            "url_manager_redirect_rules",
            "url_manager_redirect_hits",
            "url_manager_not_found_opportunities"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null,
        "prune": "url-manager:prune-hits"
    },
    "settings": [],
    "actions": {
        "buildNotFoundRedirectSuggestions": "Capell\\UrlManager\\Actions\\BuildNotFoundRedirectSuggestionsAction",
        "buildRedirectRulesCsv": "Capell\\UrlManager\\Actions\\BuildRedirectRulesCsvAction",
        "buildRedirectRulesCsvTemplate": "Capell\\UrlManager\\Actions\\BuildRedirectRulesCsvTemplateAction",
        "buildCanonicalUrl": "Capell\\UrlManager\\Actions\\BuildCanonicalUrlAction",
        "convertNotFoundOpportunityToRedirect": "Capell\\UrlManager\\Actions\\ConvertNotFoundOpportunityToRedirectAction",
        "exportRedirectRules": "Capell\\UrlManager\\Actions\\ExportRedirectRulesAction",
        "importRedirectRules": "Capell\\UrlManager\\Actions\\ImportRedirectRulesAction",
        "importSeoSuiteBrokenLinks": "Capell\\UrlManager\\Actions\\ImportSeoSuiteBrokenLinksAction",
        "previewRedirectRulesImport": "Capell\\UrlManager\\Actions\\PreviewRedirectRulesImportAction",
        "pruneRedirectHits": "Capell\\UrlManager\\Actions\\PruneRedirectHitsAction",
        "recordChangedUrlRedirect": "Capell\\UrlManager\\Actions\\RecordChangedUrlRedirectAction",
        "recordNotFoundOpportunity": "Capell\\UrlManager\\Actions\\RecordNotFoundOpportunityAction",
        "recordRedirectHit": "Capell\\UrlManager\\Actions\\RecordRedirectHitAction",
        "resolveRedirectRule": "Capell\\UrlManager\\Actions\\ResolveRedirectRuleAction",
        "setNotFoundOpportunityStatus": "Capell\\UrlManager\\Actions\\SetNotFoundOpportunityStatusAction",
        "setRedirectRuleStatus": "Capell\\UrlManager\\Actions\\SetRedirectRuleStatusAction",
        "upsertRedirectRule": "Capell\\UrlManager\\Actions\\UpsertRedirectRuleAction"
    },
    "permissions": [
        "View:RedirectRulesPage",
        "Manage:RedirectRules",
        "View:NotFoundOpportunitiesPage",
        "Manage:NotFoundOpportunities"
    ],
    "capabilities": ["seo-suite-broken-url-import", "url-manager-admin"],
    "security": {
        "riskTier": "sensitive",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [
                "url_manager_not_found_opportunities.source_hash",
                "url_manager_redirect_hits.ip_hash",
                "url_manager_redirect_hits.user_agent_hash",
                "url_manager_redirect_rules.source_hash",
                "url_manager_redirect_rules.target_hash"
            ],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "View:RedirectRulesPage",
                "Manage:RedirectRules",
                "View:NotFoundOpportunitiesPage",
                "Manage:NotFoundOpportunities"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": ["url-manager"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\UrlManager\\Models\\RedirectRule",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\UrlManager\\Models\\RedirectHit",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\UrlManager\\Models\\NotFoundOpportunity",
                    "events": ["saved", "deleted"]
                }
            ],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "url-manager.package-health",
            "label": "URL Manager redirect tables, actions, and provider metadata are discoverable.",
            "class": "Capell\\UrlManager\\Health\\UrlManagerHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Stop losing traffic to broken links — manage redirects, auto-preserve moved page URLs, and turn repeated 404s into recovered SEO.",
        "description": "URL Manager keeps your site's link equity intact when pages move or get renamed. It auto-creates redirects when a page URL changes, resolves exact, prefix, and regex rules on the live request, and tracks hit counts so you can see which redirects matter. Repeated 404s and SEO Suite broken-link findings surface as one-click redirect opportunities, with CSV import/export for bulk migrations. Built for editors and SEO teams who need redirect hygiene without touching server config.",
        "screenshots": [],
        "categories": ["seo", "admin", "redirects"],
        "credits": []
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
