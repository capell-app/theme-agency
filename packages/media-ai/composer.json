{
    "name": "capell-app/media-ai",
    "description": "AI image actions inside Capell's media library — remove backgrounds, clean up and upscale photos — with a safe no-op fallback until you connect a provider.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "capell-app/admin": "^4.0 || 4.x-dev",
        "capell-app/core": "^4.0 || 4.x-dev",
        "filament/filament": "^4.7|^5.2",
        "laravel/framework": "^11.44.2|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.14.1"
    },
    "suggest": {
        "capell-app/ai-orchestrator": "Bind Capell\\MediaAI\\Contracts\\ImageDoctor to an AIOrchestrator-backed implementation."
    },
    "autoload": {
        "psr-4": {
            "Capell\\MediaAI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\MediaAI\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\MediaAI\\Providers\\MediaAIServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://github.com/capell-app/media-ai",
    "keywords": [
        "capell",
        "cms",
        "laravel",
        "media",
        "ai"
    ],
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/media-ai"
    }
}
