{
    "name": "capell-app/theme-commerce",
    "description": "A premium, conversion-focused retail theme for Capell — image-led catalog, product discovery, social proof, and buying-guide layouts that turn browsing into baskets.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "capell-app/core": "^4.0 || 4.x-dev",
        "capell-app/foundation-theme": "^4.0 || 4.x-dev"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Capell\\ThemeStudio\\Commerce\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\ThemeStudio\\Commerce\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\ThemeStudio\\Commerce\\CommerceThemeServiceProvider"
            ]
        }
    },
    "homepage": "https://github.com/capell-app/theme-commerce",
    "keywords": [
        "capell",
        "cms",
        "laravel",
        "theme",
        "ecommerce",
        "retail",
        "storefront",
        "product grid",
        "catalog",
        "conversion",
        "shopify",
        "buying guide",
        "lookbook",
        "merchandising",
        "collections"
    ],
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/theme-commerce"
    }
}
