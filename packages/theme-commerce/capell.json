{
    "manifest-version": 3,
    "name": "capell-app/theme-commerce",
    "slug": "theme-commerce",
    "displayName": "Theme Commerce",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Theme Commerce registers the commerce theme key and image-led retail renderer views for catalog and conversion pages.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\Commerce",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/foundation-theme"],
        "supports": ["capell-app/blog", "capell-app/shopify-commerce"],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\Commerce\\CommerceThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\Commerce\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "commerce"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-commerce-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-commerce", "theme-commerce-frontend"],
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-commerce"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "theme-commerce.package-health",
            "label": "Theme Commerce package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\Commerce\\Health\\ThemeCommerceHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Retail buying-path theme screenshots from route-backed demo layouts.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Theme Commerce extension preview image",
                "caption": "Theme Commerce extension preview"
            },
            {
                "path": "docs/assets/marketplace/commerce-buying-guide-layout.svg",
                "alt": "Theme Commerce Buying Guide Layout image",
                "caption": "Theme Commerce Buying Guide Layout"
            },
            {
                "path": "docs/assets/marketplace/commerce-campaign-layout.svg",
                "alt": "Theme Commerce Campaign Layout image",
                "caption": "Theme Commerce Campaign Layout"
            },
            {
                "path": "docs/assets/marketplace/commerce-collection-layout.svg",
                "alt": "Theme Commerce Collection Layout image",
                "caption": "Theme Commerce Collection Layout"
            },
            {
                "path": "docs/assets/marketplace/commerce-homepage-layout.svg",
                "alt": "Theme Commerce Homepage Layout image",
                "caption": "Theme Commerce Homepage Layout"
            },
            {
                "path": "docs/assets/marketplace/commerce-lookbook-layout.svg",
                "alt": "Theme Commerce Lookbook Layout image",
                "caption": "Theme Commerce Lookbook Layout"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "capell-app/foundation-theme",
    "themeKey": "commerce"
}
