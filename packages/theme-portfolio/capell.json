{
    "manifest-version": 3,
    "name": "capell-app/theme-portfolio",
    "slug": "theme-portfolio",
    "displayName": "Theme Portfolio",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Creator and consultant portfolio theme for work, case studies, services, media kits, and newsletters.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\Portfolio",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/layout-builder",
            "capell-app/frontend-authoring",
            "capell-app/publishing-studio",
            "capell-app/seo-suite",
            "capell-app/blog"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\Portfolio\\PortfolioThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\Portfolio\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "portfolio"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-portfolio-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-portfolio", "theme-portfolio-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-portfolio"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "theme-portfolio.package-health",
            "label": "Theme Portfolio package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\Portfolio\\Health\\ThemePortfolioHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "marketplace": {
        "summary": "A premium portfolio theme for creators and consultants — turn selected work into outcome-driven case studies, sell your services and media kit, and grow your audience from one polished site.",
        "description": "Theme Portfolio gives independent creators, consultants, and studios a credibility-first website built around proof, not just pretty pictures. Lead with a work-led hero, walk visitors through outcome-rich case studies (scope, role, timeline, measurable results), and present your services, process, and media kit as things people can actually buy. Connect Media Library for real project imagery, Content Sections for deep case studies, and Newsletter for audience capture — every section degrades gracefully when an integration is not installed. Where an agency theme sells a team and campaigns, Theme Portfolio sells _you_: your work, your authority, and your availability.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Theme Portfolio extension preview image",
                "caption": "Theme Portfolio extension preview"
            },
            {
                "path": "docs/screenshots/frontend-page-rendered-with-portfolio-theme.png",
                "alt": "Theme Portfolio Frontend Page Rendered With Portfolio Theme screenshot",
                "caption": "Frontend Page Rendered With Portfolio Theme rendered with the Theme Portfolio theme."
            },
            {
                "path": "docs/screenshots/portfolio-case-study-layout.png",
                "alt": "Theme Portfolio Portfolio Case Study Layout screenshot",
                "caption": "Portfolio Case Study Layout rendered with the Theme Portfolio theme."
            },
            {
                "path": "docs/screenshots/portfolio-homepage-layout.png",
                "alt": "Theme Portfolio Portfolio Homepage Layout screenshot",
                "caption": "Portfolio Homepage Layout rendered with the Theme Portfolio theme."
            },
            {
                "path": "docs/screenshots/portfolio-media-kit-layout.png",
                "alt": "Theme Portfolio Portfolio Media Kit Layout screenshot",
                "caption": "Portfolio Media Kit Layout rendered with the Theme Portfolio theme."
            },
            {
                "path": "docs/screenshots/portfolio-newsletter-layout.png",
                "alt": "Theme Portfolio Portfolio Newsletter Layout screenshot",
                "caption": "Portfolio Newsletter Layout rendered with the Theme Portfolio theme."
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "portfolio",
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    }
}
