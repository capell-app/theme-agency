{
    "manifest-version": 3,
    "name": "capell-app/public-actions",
    "slug": "public-actions",
    "displayName": "Public Actions",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Public Actions gives Capell a safe boundary for public and trusted server-to-server input: submissions are validated against a per-action schema, screened for spam through honeypot, Turnstile, hCaptcha, or reCAPTCHA checks where appropriate, de-duplicated by idempotency key, and persisted before anything fires. Successful submissions fan out to configured destinations over signed HTTP webhooks (HMAC-SHA256) with SSRF protection, encrypted secrets, durable retry, and a complete per-attempt dispatch audit. Native presets cover Zapier, Make, n8n, Pipedream, and generic endpoints, while trusted inbound API submissions can be verified by HMAC or Bearer secret before entering the same audit pipeline. A registry lets other packages plug in their own handlers, destination adapters, and spam guards, and an authenticated Zapier-style JSON API exposes discoverable actions and submissions for no-code automation builders.",
    "product": {
        "group": "Capell Automation",
        "tier": "premium",
        "bundle": "automation"
    },
    "namespace": "Capell\\PublicActions",
    "surfaces": ["admin", "frontend", "console"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend"
        ],
        "supports": ["capell-app/access-gate", "capell-app/form-builder"],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\PublicActions\\Providers\\PublicActionsServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\PublicActions\\Manifest\\PublicActionsAdminResourcesContribution",
            "resourceClasses": [
                "Capell\\PublicActions\\Filament\\Resources\\PublicActions\\PublicActionResource",
                "Capell\\PublicActions\\Filament\\Resources\\Destinations\\PublicActionDestinationResource",
                "Capell\\PublicActions\\Filament\\Resources\\Submissions\\PublicActionSubmissionResource",
                "Capell\\PublicActions\\Filament\\Resources\\DispatchAttempts\\PublicActionDispatchAttemptResource",
                "Capell\\PublicActions\\Filament\\Resources\\IntegrationTokens\\PublicActionIntegrationTokenResource"
            ]
        },
        {
            "type": "model",
            "class": "Capell\\PublicActions\\Manifest\\PublicActionsModelsContribution",
            "modelClasses": [
                "Capell\\PublicActions\\Models\\PublicAction",
                "Capell\\PublicActions\\Models\\PublicActionDestination",
                "Capell\\PublicActions\\Models\\PublicActionSubmission",
                "Capell\\PublicActions\\Models\\PublicActionDispatchAttempt",
                "Capell\\PublicActions\\Models\\PublicActionIntegrationToken"
            ]
        },
        {
            "type": "route",
            "class": "Capell\\PublicActions\\Manifest\\PublicActionsRoutesContribution",
            "routes": [
                "capell-public-actions.show",
                "capell-public-actions.submit",
                "capell-public-actions.zapier.me",
                "capell-public-actions.zapier.actions",
                "capell-public-actions.zapier.actions.submit",
                "capell-public-actions.zapier.submissions",
                "capell-public-actions.trusted.actions.submit"
            ]
        },
        {
            "type": "console-command",
            "class": "Capell\\PublicActions\\Manifest\\PublicActionsConsoleCommandsContribution",
            "commands": ["capell:public-actions:prune-submissions"],
            "commandClasses": [
                "Capell\\PublicActions\\Console\\Commands\\PrunePublicActionSubmissionsCommand"
            ]
        },
        {
            "type": "health-check",
            "class": "Capell\\PublicActions\\Manifest\\PublicActionsHealthContribution",
            "checkClass": "Capell\\PublicActions\\Health\\PublicActionsHealthCheck"
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": [
            "public_actions",
            "public_action_destinations",
            "public_action_submissions",
            "public_action_dispatch_attempts",
            "public_action_integration_tokens"
        ],
        "protectedTables": [
            "public_actions",
            "public_action_destinations",
            "public_action_submissions",
            "public_action_dispatch_attempts",
            "public_action_integration_tokens"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null,
        "prune": "capell:public-actions:prune-submissions"
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "automation-webhooks",
        "durable-dispatch-fanout",
        "configurable-rate-limits",
        "manual-dispatch-replay",
        "submission-retention-pruning",
        "captcha-spam-protection",
        "trusted-inbound-submissions",
        "public-form",
        "public-actions",
        "submit-actions",
        "zapier-integration"
    ],
    "security": {
        "riskTier": "critical",
        "publicSurface": {
            "routeNames": [
                "actions",
                "actions.submit",
                "me",
                "show",
                "submissions",
                "submit"
            ],
            "auth": "public",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": ["submit"]
        },
        "sensitiveData": {
            "encryptedFields": [
                "Capell\\PublicActions\\Models\\PublicActionDestination::$endpoint_url",
                "Capell\\PublicActions\\Models\\PublicActionDestination::$headers",
                "Capell\\PublicActions\\Models\\PublicActionDestination::$secret",
                "Capell\\PublicActions\\Models\\PublicActionSubmission::$payload"
            ],
            "hashedTokenFields": [],
            "redactedOutputClasses": [
                "Capell\\PublicActions\\Health\\PublicActionsHealthCheck",
                "Capell\\PublicActions\\Support\\Providers\\HttpWebhookPublicActionAdapter"
            ],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": true,
            "requiresSecretRedaction": true,
            "clients": [
                "Capell\\PublicActions\\Support\\Providers\\HttpWebhookPublicActionAdapter",
                "Capell\\PublicActions\\Support\\SpamProtection\\HCaptchaPublicActionSpamProtectionAdapter",
                "Capell\\PublicActions\\Support\\SpamProtection\\ReCaptchaPublicActionSpamProtectionAdapter",
                "Capell\\PublicActions\\Support\\SpamProtection\\TurnstilePublicActionSpamProtectionAdapter"
            ]
        },
        "adminSurface": {
            "authorization": "policies",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["public-actions"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "public-actions.webhook-dispatch",
            "label": "Webhook destinations dispatch JSON payloads with durable attempts",
            "class": "Capell\\PublicActions\\Health\\PublicActionsHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        },
        {
            "key": "public-actions.webhook-security",
            "label": "Webhook destinations block private hosts and redact secrets",
            "class": "Capell\\PublicActions\\Health\\PublicActionsHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        },
        {
            "key": "public-actions.provider-presets",
            "label": "Provider presets normalize Zapier, Pipedream, n8n, Make, and generic webhooks",
            "class": "Capell\\PublicActions\\Health\\PublicActionsHealthCheck",
            "severity": "warning",
            "surface": "admin"
        },
        {
            "key": "public-actions.form-builder-integration",
            "label": "Form Builder submissions can feed Public Actions through package listeners",
            "class": "Capell\\PublicActions\\Health\\PublicActionsHealthCheck",
            "severity": "warning",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Turn any public form or API request into a signed, retried, fully-audited webhook to Zapier, Make, n8n, Pipedream, or your own endpoint — without exposing a single admin route.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Public Actions extension preview image",
                "caption": "Public Actions extension preview"
            },
            {
                "path": "docs/screenshots/public-actions-admin-index.png",
                "alt": "Public Actions admin index with active action rows",
                "caption": "Public Actions admin index"
            },
            {
                "path": "docs/screenshots/public-action-form.png",
                "alt": "Public Action form showing handler, site scope, redirect, API, and schema settings",
                "caption": "Public Action create/edit form"
            },
            {
                "path": "docs/screenshots/public-action-destinations.png",
                "alt": "Public Action destinations with signed webhooks and redacted secrets",
                "caption": "Public Action destinations"
            },
            {
                "path": "docs/screenshots/public-action-submissions.png",
                "alt": "Public Action submissions table showing processed, queued, and duplicate requests",
                "caption": "Public Action submissions"
            },
            {
                "path": "docs/screenshots/public-action-dispatch-attempts.png",
                "alt": "Public Action dispatch attempts audit table with response and retry state",
                "caption": "Public Action dispatch attempts"
            },
            {
                "path": "docs/screenshots/public-action-integration-tokens.png",
                "alt": "Public Action integration token list without exposed token values",
                "caption": "Public Action integration tokens"
            },
            {
                "path": "docs/screenshots/public-action-frontend-form.png",
                "alt": "Public-safe frontend form for an active Public Action",
                "caption": "Public Action frontend form"
            }
        ],
        "categories": ["admin", "automation", "console", "frontend"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
