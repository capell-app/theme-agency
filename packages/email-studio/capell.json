{
    "manifest-version": 3,
    "name": "capell-app/email-studio",
    "slug": "email-studio",
    "displayName": "Email Studio",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Email Studio gives every Capell site a reliable transactional-email core. Packages register static Blade-backed template definitions with declared variables and sample data, while admins can customize site and locale variants, activate versions, preview with sample data, send test emails, and apply branded email themes. Auth email overrides replace Laravel verification and password reset messages by default, with welcome, verified, login, lockout, and reset-success lifecycle emails available as opt-in templates. Every send is rendered to an immutable snapshot, screened against site and global suppression lists, and delivered via provider adapters and queue jobs that record per-recipient outcomes for support and audit.",
    "product": {
        "group": "Capell Communications",
        "tier": "premium",
        "bundle": "communications"
    },
    "namespace": "Capell\\EmailStudio",
    "surfaces": ["admin", "frontend", "console"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend"
        ],
        "supports": [
            "capell-app/campaign-studio",
            "capell-app/form-builder",
            "capell-app/insights"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "auth": ["Capell\\EmailStudio\\Providers\\AuthEmailServiceProvider"],
        "runtime": [
            "Capell\\EmailStudio\\Providers\\EmailStudioServiceProvider"
        ],
        "admin": ["Capell\\EmailStudio\\Providers\\AdminServiceProvider"],
        "frontend": ["Capell\\EmailStudio\\Providers\\FrontendServiceProvider"]
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\EmailStudio\\Manifest\\SentEmailResourceContribution",
            "resourceClass": "Capell\\EmailStudio\\Filament\\Resources\\SentEmails\\SentEmailResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\EmailStudio\\Manifest\\TemplateAuthoringResourceContribution",
            "resourceClass": "Capell\\EmailStudio\\Filament\\Resources\\EmailTemplates\\EmailTemplateResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\EmailStudio\\Manifest\\TemplateAuthoringResourceContribution",
            "resourceClass": "Capell\\EmailStudio\\Filament\\Resources\\EmailTemplateVariants\\EmailTemplateVariantResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\EmailStudio\\Manifest\\TemplateAuthoringResourceContribution",
            "resourceClass": "Capell\\EmailStudio\\Filament\\Resources\\EmailTemplateThemes\\EmailTemplateThemeResource"
        },
        {
            "type": "model",
            "class": "Capell\\EmailStudio\\Manifest\\SentEmailModelContribution",
            "modelClass": "Capell\\EmailStudio\\Models\\SentEmail"
        },
        {
            "type": "setting",
            "class": "Capell\\EmailStudio\\Manifest\\EmailStudioSettingsContribution",
            "settingsClass": "Capell\\EmailStudio\\Settings\\EmailStudioSettings",
            "settingsGroup": "email_studio"
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\EmailStudio\\Manifest\\TrackedEmailPurgeScheduleContribution",
            "command": "capell-email-studio:purge-tracked-emails",
            "frequency": "daily"
        }
    ],
    "database": {
        "migrations": true,
        "settings": true,
        "requiredTables": [
            "email_template_themes",
            "sent_emails",
            "sent_emails_url_clicked"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null,
        "retention": "capell-email-studio:prune-bodies",
        "mailTrackerPurge": "Capell\\EmailStudio\\Console\\Commands\\PurgeTrackedEmailsCommand"
    },
    "actions": {
        "applyMailTrackerSettings": "Capell\\EmailStudio\\Actions\\ApplyMailTrackerSettingsAction",
        "purgeTrackedEmails": "Capell\\EmailStudio\\Actions\\PurgeTrackedEmailsAction",
        "recordProviderEvent": "Capell\\EmailStudio\\Actions\\RecordProviderEventAction",
        "validateProviderWebhookSignature": "Capell\\EmailStudio\\Actions\\ValidateProviderWebhookSignatureAction",
        "createTemplateOverride": "Capell\\EmailStudio\\Actions\\CreateEmailTemplateOverrideAction",
        "activateTemplateVariant": "Capell\\EmailStudio\\Actions\\ActivateEmailTemplateVariantAction",
        "captureTemplateThemeScreenshot": "Capell\\EmailStudio\\Actions\\CaptureEmailTemplateThemeScreenshotAction",
        "renderStaticTemplateDefinition": "Capell\\EmailStudio\\Actions\\RenderEmailTemplateDefinitionAction",
        "sendTemplateTest": "Capell\\EmailStudio\\Actions\\SendEmailTemplateTestAction"
    },
    "settings": [
        "Capell\\EmailStudio\\Settings\\EmailStudioSettings",
        "Capell\\EmailStudio\\Manifest\\EmailStudioSettingsContribution"
    ],
    "permissions": [
        "ViewAny:SentEmail",
        "View:SentEmail",
        "ViewAny:EmailTemplateRegistration",
        "View:EmailTemplateRegistration",
        "ViewAny:EmailTemplateVariant",
        "View:EmailTemplateVariant",
        "Update:EmailTemplateVariant",
        "ViewAny:EmailTemplateTheme",
        "View:EmailTemplateTheme",
        "Create:EmailTemplateTheme",
        "Update:EmailTemplateTheme"
    ],
    "capabilities": [
        "delivery-audit",
        "mail-tracker-admin",
        "mail-tracker-open-click-tracking",
        "mail-tracker-retention",
        "provider-event-ingestion",
        "provider-normalization-foundation",
        "provider-adapters",
        "auth-email-overrides",
        "package-template-registration",
        "static-template-fallback",
        "suppressions",
        "template-authoring-admin",
        "template-preview-test-send",
        "template-theme-screenshot-capture",
        "template-theme-editor",
        "template-rendering",
        "transactional-email"
    ],
    "security": {
        "riskTier": "sensitive",
        "publicSurface": {
            "routeNames": [
                "capell-email-studio.provider-events"
            ],
            "auth": "public",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [
                "capell-email-studio.provider-events"
            ],
            "webhookRoutes": [
                "capell-email-studio.provider-events"
            ],
            "throttledRoutes": [
                "capell-email-studio.provider-events"
            ]
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [
                "email_profiles.webhook_endpoint_token_hash",
                "email_recipients.email_hash",
                "email_replies.from_email_hash",
                "email_suppressions.email_hash",
                "email_tracking_tokens.token_hash"
            ],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "ViewAny:SentEmail",
                "View:SentEmail",
                "ViewAny:EmailTemplateRegistration",
                "View:EmailTemplateRegistration",
                "ViewAny:EmailTemplateVariant",
                "View:EmailTemplateVariant",
                "Update:EmailTemplateVariant",
                "ViewAny:EmailTemplateTheme",
                "View:EmailTemplateTheme",
                "Create:EmailTemplateTheme",
                "Update:EmailTemplateTheme"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["email-studio"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "email-studio.template-rendering",
            "label": "Email templates render through database variants and static registered definitions",
            "class": "Capell\\EmailStudio\\Health\\EmailStudioHealthCheck",
            "severity": "critical",
            "surface": "admin"
        },
        {
            "key": "email-studio.template-authoring",
            "label": "Template authoring resources, themes, and test-send actions are available",
            "class": "Capell\\EmailStudio\\Health\\EmailStudioHealthCheck",
            "severity": "critical",
            "surface": "admin"
        },
        {
            "key": "email-studio.provider-delivery",
            "label": "Queued email delivery records provider results per recipient",
            "class": "Capell\\EmailStudio\\Health\\EmailStudioHealthCheck",
            "severity": "critical",
            "surface": "console"
        },
        {
            "key": "email-studio.suppressions",
            "label": "Suppressions are enforced before provider handoff",
            "class": "Capell\\EmailStudio\\Health\\EmailStudioHealthCheck",
            "severity": "critical",
            "surface": "console"
        },
        {
            "key": "email-studio.provider-events",
            "label": "Provider webhook and inbound reply normalization foundations are present",
            "class": "Capell\\EmailStudio\\Health\\EmailStudioHealthCheck",
            "severity": "warning",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Email Studio is Capell's transactional-email engine and template authoring surface: package-registered static defaults, safe {{ variable }} rendering, editable site and locale overrides, auth email replacements, branded themes, preview/test-send, delivery profiles, suppressions, and a queued audit trail.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Email Studio sent email index captured from the Capell screenshot runner",
                "caption": "Runner-captured sent email activity in Capell admin"
            },
            {
                "path": "docs/screenshots/sent-emails-index.png",
                "alt": "Email Studio sent emails table with MailTracker opens and clicks",
                "caption": "Sent email activity table"
            },
            {
                "path": "docs/screenshots/sent-emails-index-dark.png",
                "alt": "Email Studio sent emails table with MailTracker opens and clicks in dark mode",
                "caption": "Sent email activity table in dark mode"
            },
            {
                "path": "docs/screenshots/sent-email-view.png",
                "alt": "Email Studio sent email detail page with headers and sandboxed HTML preview",
                "caption": "Sent email detail view"
            },
            {
                "path": "docs/screenshots/sent-email-view-dark.png",
                "alt": "Email Studio sent email detail page with headers and sandboxed HTML preview in dark mode",
                "caption": "Sent email detail view in dark mode"
            },
            {
                "path": "docs/assets/marketplace/hero-desktop.jpg",
                "alt": "Email Studio template authoring and theme editing marketplace hero",
                "caption": "Template authoring and branded email themes"
            }
        ],
        "categories": ["admin", "communications", "console", "frontend"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
