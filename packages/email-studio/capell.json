{
    "manifest-version": 3,
    "name": "capell-app/email-studio",
    "slug": "email-studio",
    "displayName": "Email Studio",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Email Studio gives every Capell site a reliable transactional-email core. Define reusable, locale- and site-scoped templates that render through a deliberately safe placeholder engine (HTML-escaped, missing-variable-strict in production), then send through delivery profiles backed by pluggable provider adapters (SMTP today, with a clean contract for Postmark and others). Every send is rendered to an immutable snapshot, screened against site and global suppression lists, and delivered via a queue job that records per-recipient outcomes for support and audit. Roadmap slices add provider webhook ingestion, open/click tracking, one-click unsubscribe, and an in-panel template and send-log studio.",
    "product": {
        "group": "Capell Communications",
        "tier": "premium",
        "bundle": "communications"
    },
    "namespace": "Capell\\EmailStudio",
    "surfaces": ["admin", "frontend", "console"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend",
            "jdavidbakr/mail-tracker"
        ],
        "supports": [
            "capell-app/campaign-studio",
            "capell-app/form-builder",
            "capell-app/insights"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\EmailStudio\\Providers\\EmailStudioServiceProvider"
        ],
        "admin": ["Capell\\EmailStudio\\Providers\\AdminServiceProvider"],
        "frontend": ["Capell\\EmailStudio\\Providers\\FrontendServiceProvider"]
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\EmailStudio\\Manifest\\SentEmailResourceContribution",
            "resourceClass": "Capell\\EmailStudio\\Filament\\Resources\\SentEmails\\SentEmailResource"
        },
        {
            "type": "model",
            "class": "Capell\\EmailStudio\\Manifest\\SentEmailModelContribution",
            "modelClass": "Capell\\EmailStudio\\Models\\SentEmail"
        },
        {
            "type": "setting",
            "class": "Capell\\EmailStudio\\Manifest\\EmailStudioSettingsContribution",
            "settingsClass": "Capell\\EmailStudio\\Settings\\EmailStudioSettings",
            "settingsGroup": "email_studio"
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\EmailStudio\\Manifest\\TrackedEmailPurgeScheduleContribution",
            "command": "capell-email-studio:purge-tracked-emails",
            "frequency": "daily"
        }
    ],
    "database": {
        "migrations": true,
        "settings": true,
        "requiredTables": ["sent_emails", "sent_emails_url_clicked"]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null,
        "retention": "capell-email-studio:prune-bodies",
        "mailTrackerPurge": "Capell\\EmailStudio\\Console\\Commands\\PurgeTrackedEmailsCommand"
    },
    "actions": {
        "applyMailTrackerSettings": "Capell\\EmailStudio\\Actions\\ApplyMailTrackerSettingsAction",
        "purgeTrackedEmails": "Capell\\EmailStudio\\Actions\\PurgeTrackedEmailsAction"
    },
    "settings": ["Capell\\EmailStudio\\Settings\\EmailStudioSettings"],
    "permissions": [],
    "capabilities": [
        "delivery-audit",
        "mail-tracker-admin",
        "mail-tracker-retention",
        "provider-normalization-foundation",
        "provider-adapters",
        "suppressions",
        "template-rendering",
        "transactional-email"
    ],
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["email-studio"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "email-studio.template-rendering",
            "label": "Email templates render through typed template actions",
            "class": "Capell\\EmailStudio\\Health\\EmailStudioHealthCheck",
            "severity": "critical",
            "surface": "admin"
        },
        {
            "key": "email-studio.provider-delivery",
            "label": "Queued email delivery records provider results per recipient",
            "class": "Capell\\EmailStudio\\Health\\EmailStudioHealthCheck",
            "severity": "critical",
            "surface": "console"
        },
        {
            "key": "email-studio.suppressions",
            "label": "Suppressions are enforced before provider handoff",
            "class": "Capell\\EmailStudio\\Health\\EmailStudioHealthCheck",
            "severity": "critical",
            "surface": "console"
        },
        {
            "key": "email-studio.provider-events",
            "label": "Provider webhook and inbound reply normalization foundations are present",
            "class": "Capell\\EmailStudio\\Health\\EmailStudioHealthCheck",
            "severity": "warning",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Email Studio is Capell's transactional-email engine: site-scoped reusable templates with safe {{ variable }} rendering, pluggable delivery profiles and provider adapters, suppression enforcement, and a queued, auditable per-recipient send pipeline.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Email Studio extension preview image",
                "caption": "Email Studio extension preview"
            },
            {
                "path": "docs/screenshots/sent-emails-index.png",
                "alt": "Email Studio sent emails table with MailTracker opens and clicks",
                "caption": "Sent email activity table"
            },
            {
                "path": "docs/screenshots/sent-email-view.png",
                "alt": "Email Studio sent email detail page with headers and sandboxed HTML preview",
                "caption": "Sent email detail view"
            },
            {
                "path": "docs/screenshots/email-studio-settings.png",
                "alt": "Email Studio MailTracker settings for tracking and retention",
                "caption": "Mail tracking settings"
            }
        ],
        "categories": ["admin", "communications", "console", "frontend"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
