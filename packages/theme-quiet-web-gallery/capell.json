{
    "manifest-version": 3,
    "name": "capell-app/theme-quiet-web-gallery",
    "slug": "theme-quiet-web-gallery",
    "displayName": "Theme Quiet Web Gallery",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Quiet Web Gallery extends the default Capell frontend with a calm web-design gallery direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for light grey pages, modest typography, practical browse panels, understated image grids, latest showcase entries, sponsor space, category archives, random picks, best-of lists, simple posts, and newsletter paths.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\QuietWebGallery",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\QuietWebGallery\\QuietWebGalleryThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\QuietWebGallery\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "quiet-web-gallery"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-quiet-web-gallery-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-quiet-web-gallery",
        "theme-quiet-web-gallery-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-quiet-web-gallery"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-quiet-web-gallery.package-health",
            "label": "Quiet Web Gallery package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\QuietWebGallery\\Health\\ThemeQuietWebGalleryHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A quiet Capell theme for calm web-design galleries with practical browse panels, understated image grids, latest entries, sponsor space, category archives, random picks, best-of lists, and simple posts.",
        "description": "Quiet Web Gallery provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for understated inspiration sites that need browse, follow or subscribe, submit, and blog panels; latest showcase entries; sponsor space; small captions; dates; categories; comments; random picks; best-of lists; category archives; and simple editorial posts.",
        "screenshots": [
            {
                "path": "docs/screenshots/quiet-web-gallery-homepage.png",
                "alt": "Quiet Web Gallery homepage preview",
                "caption": "Quiet Web Gallery Homepage"
            },
            {
                "path": "docs/screenshots/quiet-web-gallery-landing.png",
                "alt": "Quiet Web Gallery landing page preview",
                "caption": "Quiet Web Gallery Landing page"
            },
            {
                "path": "docs/screenshots/quiet-web-gallery-listing.png",
                "alt": "Quiet Web Gallery list page preview",
                "caption": "Quiet Web Gallery Category archive"
            },
            {
                "path": "docs/screenshots/quiet-web-gallery-search.png",
                "alt": "Quiet Web Gallery search results preview",
                "caption": "Quiet Web Gallery Search results"
            },
            {
                "path": "docs/screenshots/quiet-web-gallery-contact.png",
                "alt": "Quiet Web Gallery contact form preview",
                "caption": "Quiet Web Gallery Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "quiet-web-gallery"
}
