{
    "manifest-version": 3,
    "name": "capell-app/theme-dark-product-system",
    "slug": "theme-dark-product-system",
    "displayName": "Theme Dark Product System",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Dark Product System extends the default Capell frontend with a dark product system direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for system heroes, workflow rails, agents and automation, planning roadmaps, changelog and integrations, security proof, near-black surfaces, refined borders, product UI shells, and activity timelines.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\DarkProductSystem",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\DarkProductSystem\\DarkProductSystemThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\DarkProductSystem\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "dark-product-system"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-dark-product-system-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-dark-product-system",
        "theme-dark-product-system-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-dark-product-system"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-dark-product-system.package-health",
            "label": "Dark Product System package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\DarkProductSystem\\Health\\ThemeDarkProductSystemHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A dark Capell theme for product-led SaaS, workflow platforms, technical operations tools, AI-assisted work products, planning systems, and security-conscious teams.",
        "description": "Dark Product System provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for product-led SaaS, workflow platforms, technical operations tools, AI-assisted work products, team planning systems, and security-conscious buyers that need inboxes, issues, roadmaps, reviews, automation, activity, integrations, customer proof, security modules, and command palette states.",
        "screenshots": [
            {
                "path": "docs/screenshots/dark-product-system-homepage.png",
                "alt": "Dark Product System homepage preview",
                "caption": "Dark Product System Homepage"
            },
            {
                "path": "docs/screenshots/dark-product-system-landing.png",
                "alt": "Dark Product System landing page preview",
                "caption": "Dark Product System Landing page"
            },
            {
                "path": "docs/screenshots/dark-product-system-listing.png",
                "alt": "Dark Product System list page preview",
                "caption": "Dark Product System List page"
            },
            {
                "path": "docs/screenshots/dark-product-system-search.png",
                "alt": "Dark Product System search results preview",
                "caption": "Dark Product System Search results"
            },
            {
                "path": "docs/screenshots/dark-product-system-contact.png",
                "alt": "Dark Product System contact form preview",
                "caption": "Dark Product System Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "dark-product-system"
}
