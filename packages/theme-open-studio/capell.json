{
    "manifest-version": 3,
    "name": "capell-app/theme-open-studio",
    "slug": "theme-open-studio",
    "displayName": "Theme Open Studio",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Put the work centre-stage: rich case studies with credits, process notes, media stacks, and a hire-me CTA. Built for studios and creators who win clients by showing, not telling.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\OpenStudio",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\OpenStudio\\OpenStudioThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\OpenStudio\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "open-studio"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-open-studio-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-open-studio", "theme-open-studio-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-open-studio"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-open-studio.package-health",
            "label": "Open Studio package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\OpenStudio\\Health\\ThemeOpenStudioHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Put the work centre-stage: rich case studies with credits, process notes, media stacks, and a hire-me CTA.",
        "description": "Open Studio provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for graphic design, photography, 3D, UI/UX, motion, architecture, fashion, and multidisciplinary project platforms that need appreciations, views, save state, ownership, media type, credits, tools, process notes, related projects, and hiring paths.",
        "screenshots": [
            {
                "path": "docs/screenshots/open-studio-homepage.png",
                "alt": "Open Studio homepage preview",
                "caption": "Open Studio Homepage"
            },
            {
                "path": "docs/screenshots/open-studio-landing.png",
                "alt": "Open Studio landing page preview",
                "caption": "Open Studio Landing page"
            },
            {
                "path": "docs/screenshots/open-studio-listing.png",
                "alt": "Open Studio list page preview",
                "caption": "Open Studio List page"
            },
            {
                "path": "docs/screenshots/open-studio-search.png",
                "alt": "Open Studio search results preview",
                "caption": "Open Studio Search results"
            },
            {
                "path": "docs/screenshots/open-studio-contact.png",
                "alt": "Open Studio contact form preview",
                "caption": "Open Studio Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "open-studio"
}
