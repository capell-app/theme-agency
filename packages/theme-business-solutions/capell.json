{
    "manifest-version": 3,
    "name": "capell-app/theme-business-solutions",
    "slug": "theme-business-solutions",
    "displayName": "Theme Business Solutions",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Theme Business Solutions registers vertical business theme keys and renderer profiles for professional, civic, commerce, and modern service sites.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\BusinessSolutions",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/foundation-theme"],
        "optional": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\BusinessSolutions\\BusinessSolutionsThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-business-solutions",
        "theme-business-solutions-frontend"
    ],
    "performance": {
        "frontendRenderBudgetMs": 25,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-business-solutions"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "theme-business-solutions.package-health",
            "label": "Theme Business Solutions package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\BusinessSolutions\\Health\\ThemeBusinessSolutionsHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Theme Business Solutions registers vertical business theme keys and renderer profiles for professional, civic, commerce, and modern service sites.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Theme Business Solutions extension preview image",
                "caption": "Theme Business Solutions extension preview"
            }
        ],
        "categories": ["frontend", "themes", "business"]
    },
    "extends": "capell-app/foundation-theme",
    "themeKey": "business-legal"
}
