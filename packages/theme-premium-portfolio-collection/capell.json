{
    "manifest-version": 3,
    "name": "capell-app/theme-premium-portfolio-collection",
    "slug": "theme-premium-portfolio-collection",
    "displayName": "Theme Premium Portfolio Collection",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Premium Portfolio Collection extends the default Capell frontend with an awards-style portfolio directory direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for featured portfolios, newest entries, winner labels, taxonomy filters, creator profiles, educational resources, and newsletters.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\PremiumPortfolioCollection",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\PremiumPortfolioCollection\\PremiumPortfolioCollectionThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\PremiumPortfolioCollection\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "premium-portfolio-collection"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-premium-portfolio-collection-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-premium-portfolio-collection",
        "theme-premium-portfolio-collection-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-premium-portfolio-collection"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-premium-portfolio-collection.package-health",
            "label": "Premium Portfolio Collection package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\PremiumPortfolioCollection\\Health\\ThemePremiumPortfolioCollectionHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for portfolio directories, award-style collections, creator profiles, filters, galleries, and portfolio education.",
        "description": "Premium Portfolio Collection provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for portfolio collections that need large previews, award labels, creator metadata, taxonomy filters, and educational upsells.",
        "screenshots": [
            {
                "path": "docs/screenshots/premium-portfolio-collection-homepage.png",
                "alt": "Premium Portfolio Collection homepage preview",
                "caption": "Premium Portfolio Collection Homepage"
            },
            {
                "path": "docs/screenshots/premium-portfolio-collection-landing.png",
                "alt": "Premium Portfolio Collection landing page preview",
                "caption": "Premium Portfolio Collection Landing page"
            },
            {
                "path": "docs/screenshots/premium-portfolio-collection-listing.png",
                "alt": "Premium Portfolio Collection list page preview",
                "caption": "Premium Portfolio Collection List page"
            },
            {
                "path": "docs/screenshots/premium-portfolio-collection-search.png",
                "alt": "Premium Portfolio Collection search results preview",
                "caption": "Premium Portfolio Collection Search results"
            },
            {
                "path": "docs/screenshots/premium-portfolio-collection-contact.png",
                "alt": "Premium Portfolio Collection contact form preview",
                "caption": "Premium Portfolio Collection Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "premium-portfolio-collection"
}
