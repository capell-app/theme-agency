{
    "manifest-version": 3,
    "name": "capell-app/newsletter",
    "slug": "newsletter",
    "displayName": "Newsletter",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Capture, confirm, and segment newsletter subscribers on every Capell site — with double opt-in, a public preference center, GDPR-grade consent evidence, and one-click sync to Mailchimp, Kit, and Campaign Monitor.",
    "product": {
        "group": "Capell Marketing",
        "tier": "premium",
        "bundle": "newsletter"
    },
    "namespace": "Capell\\Newsletter",
    "surfaces": ["admin", "frontend"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/form-builder",
            "capell-app/frontend",
            "capell-app/tags"
        ],
        "supports": ["capell-app/contacts", "capell-app/customer-portal"],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": ["Capell\\Newsletter\\Providers\\NewsletterServiceProvider"],
        "admin": ["Capell\\Newsletter\\Providers\\AdminServiceProvider"],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\Newsletter\\Manifest\\NewsletterAdminResourcesContribution",
            "resourceClasses": [
                "Capell\\Newsletter\\Filament\\Resources\\Subscribers\\SubscriberResource",
                "Capell\\Newsletter\\Filament\\Resources\\ProviderConnections\\ProviderConnectionResource",
                "Capell\\Newsletter\\Filament\\Resources\\ProviderAudiences\\ProviderAudienceResource",
                "Capell\\Newsletter\\Filament\\Resources\\ProviderInterestMappings\\ProviderInterestMappingResource",
                "Capell\\Newsletter\\Filament\\Resources\\FormMappings\\FormMappingResource",
                "Capell\\Newsletter\\Filament\\Resources\\NewsletterTags\\NewsletterTagResource",
                "Capell\\Newsletter\\Filament\\Resources\\Segments\\SegmentResource",
                "Capell\\Newsletter\\Filament\\Resources\\NewsletterSends\\NewsletterSendResource",
                "Capell\\Newsletter\\Filament\\Resources\\ImportBatches\\ImportBatchResource",
                "Capell\\Newsletter\\Filament\\Resources\\SyncAttempts\\SyncAttemptResource"
            ]
        },
        {
            "type": "dashboard-widget",
            "class": "Capell\\Newsletter\\Manifest\\NewsletterOverviewWidgetContribution",
            "widgetClass": "Capell\\Newsletter\\Filament\\Widgets\\NewsletterOverviewStatsWidget"
        },
        {
            "type": "overview-stat",
            "class": "Capell\\Newsletter\\Manifest\\NewsletterOverviewStatsContribution",
            "keys": [
                "newsletter_overview",
                "newsletter_overview.pending",
                "newsletter_overview.sync_failures"
            ]
        },
        {
            "type": "route",
            "class": "Capell\\Newsletter\\Manifest\\NewsletterFrontendRoutesContribution",
            "routes": [
                "capell-newsletter.subscribe",
                "capell-newsletter.confirm",
                "capell-newsletter.unsubscribe",
                "capell-newsletter.unsubscribe.one-click",
                "capell-newsletter.preferences.show",
                "capell-newsletter.preferences.update",
                "capell-newsletter.provider-webhook"
            ]
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\Newsletter\\Manifest\\NewsletterSyncRetryScheduleContribution",
            "command": "newsletter:sync-retry-due",
            "frequency": "everyFiveMinutes"
        },
        {
            "type": "model",
            "class": "Capell\\Newsletter\\Manifest\\NewsletterModelsContribution",
            "modelClasses": [
                "Capell\\Newsletter\\Models\\Subscriber",
                "Capell\\Newsletter\\Models\\ConsentEvent",
                "Capell\\Newsletter\\Models\\PublicToken",
                "Capell\\Newsletter\\Models\\FormMapping",
                "Capell\\Newsletter\\Models\\ProviderConnection",
                "Capell\\Newsletter\\Models\\ProviderAudience",
                "Capell\\Newsletter\\Models\\ProviderInterestMapping",
                "Capell\\Newsletter\\Models\\ProviderSubscriber",
                "Capell\\Newsletter\\Models\\SyncAttempt",
                "Capell\\Newsletter\\Models\\Segment",
                "Capell\\Newsletter\\Models\\ImportBatch",
                "Capell\\Newsletter\\Models\\NewsletterSend"
            ]
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": [
            "newsletter_provider_connections",
            "newsletter_subscribers",
            "newsletter_provider_audiences",
            "newsletter_consent_events",
            "newsletter_provider_interest_mappings",
            "newsletter_provider_subscribers",
            "newsletter_public_tokens",
            "newsletter_segments",
            "newsletter_sync_attempts",
            "newsletter_form_mappings",
            "newsletter_import_batches",
            "newsletter_processed_webhook_events",
            "newsletter_sends"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "actions": {
        "applyNewsletterTags": "Capell\\Newsletter\\Actions\\ApplyNewsletterTagsAction",
        "buildDueNewsletterSends": "Capell\\Newsletter\\Actions\\BuildDueNewsletterSendsAction",
        "buildNewsletterSendHandoffPayload": "Capell\\Newsletter\\Actions\\BuildNewsletterSendHandoffPayloadAction",
        "confirmSubscriber": "Capell\\Newsletter\\Actions\\ConfirmSubscriberAction",
        "buildListUnsubscribeHeaders": "Capell\\Newsletter\\Actions\\BuildListUnsubscribeHeadersAction",
        "createPreferenceCenterToken": "Capell\\Newsletter\\Actions\\CreatePreferenceCenterTokenAction",
        "createUnsubscribeToken": "Capell\\Newsletter\\Actions\\CreateUnsubscribeTokenAction",
        "evaluateNewsletterSegment": "Capell\\Newsletter\\Actions\\EvaluateNewsletterSegmentAction",
        "exportSubscribers": "Capell\\Newsletter\\Actions\\ExportSubscribersAction",
        "handleProviderWebhook": "Capell\\Newsletter\\Actions\\HandleProviderWebhookAction",
        "importSubscribers": "Capell\\Newsletter\\Actions\\ImportSubscribersAction",
        "parseSubscriberCsvRows": "Capell\\Newsletter\\Actions\\ParseSubscriberCsvRowsAction",
        "queueProviderSync": "Capell\\Newsletter\\Actions\\QueueProviderSyncAction",
        "recordConsentEvent": "Capell\\Newsletter\\Actions\\RecordConsentEventAction",
        "requestDoubleOptIn": "Capell\\Newsletter\\Actions\\RequestDoubleOptInAction",
        "requeueDueProviderSyncAttempts": "Capell\\Newsletter\\Actions\\RequeueDueProviderSyncAttemptsAction",
        "resolvePreferenceCenter": "Capell\\Newsletter\\Actions\\ResolvePreferenceCenterAction",
        "resolveUtmAttribution": "Capell\\Newsletter\\Actions\\ResolveUtmAttributionAction",
        "scheduleNewsletterSend": "Capell\\Newsletter\\Actions\\ScheduleNewsletterSendAction",
        "subscribeFromPublicRequest": "Capell\\Newsletter\\Actions\\SubscribeFromPublicRequestAction",
        "subscribeFromFormSubmission": "Capell\\Newsletter\\Actions\\SubscribeFromFormSubmissionAction",
        "syncNewsletterSubscriberContact": "Capell\\Newsletter\\Actions\\SyncNewsletterSubscriberContactAction",
        "syncSubscriberToProvider": "Capell\\Newsletter\\Actions\\SyncSubscriberToProviderAction",
        "unsubscribeSubscriber": "Capell\\Newsletter\\Actions\\UnsubscribeSubscriberAction",
        "updateNewsletterSendStatus": "Capell\\Newsletter\\Actions\\UpdateNewsletterSendStatusAction",
        "updatePreferenceCenter": "Capell\\Newsletter\\Actions\\UpdatePreferenceCenterAction",
        "upsertSubscriber": "Capell\\Newsletter\\Actions\\UpsertSubscriberAction"
    },
    "permissions": [],
    "capabilities": [
        "newsletter",
        "newsletter-admin",
        "newsletter-frontend",
        "newsletter-segments",
        "newsletter-preference-center",
        "newsletter-campaign-sends",
        "newsletter-send-handoff",
        "newsletter-send-lifecycle",
        "newsletter-utm-attribution",
        "newsletter-unsubscribe-routes",
        "newsletter-automation-hooks",
        "newsletter-global-suppression",
        "newsletter-sync-exhaustion",
        "newsletter-contacts-source-adapter",
        "newsletter-customer-portal-preferences-feed",
        "newsletter-public-preference-center"
    ],
    "security": {
        "riskTier": "sensitive",
        "publicSurface": {
            "routeNames": [
                "capell-newsletter.confirm",
                "capell-newsletter.preferences.show",
                "capell-newsletter.preferences.update",
                "capell-newsletter.provider-webhook",
                "capell-newsletter.subscribe",
                "capell-newsletter.unsubscribe",
                "capell-newsletter.unsubscribe.one-click",
                "subscribe",
                "confirm",
                "unsubscribe",
                "unsubscribe.one-click",
                "preferences.show",
                "preferences.update",
                "provider-webhook"
            ],
            "auth": "mixed",
            "csrfExemptRoutes": [
                "capell-newsletter.provider-webhook",
                "capell-newsletter.subscribe",
                "capell-newsletter.unsubscribe.one-click",
                "subscribe",
                "unsubscribe.one-click",
                "provider-webhook"
            ],
            "signedRoutes": [],
            "tokenizedRoutes": [
                "capell-newsletter.confirm",
                "capell-newsletter.preferences.show",
                "capell-newsletter.preferences.update",
                "capell-newsletter.unsubscribe",
                "capell-newsletter.unsubscribe.one-click",
                "confirm",
                "unsubscribe",
                "unsubscribe.one-click",
                "preferences.show",
                "preferences.update"
            ],
            "webhookRoutes": [
                "capell-newsletter.provider-webhook",
                "provider-webhook"
            ],
            "throttledRoutes": [
                "capell-newsletter.subscribe",
                "subscribe",
                "unsubscribe.one-click",
                "preferences.update",
                "provider-webhook"
            ]
        },
        "sensitiveData": {
            "encryptedFields": [
                "Capell\\Newsletter\\Models\\ConsentEvent::$evidence",
                "Capell\\Newsletter\\Models\\ConsentEvent::$metadata",
                "Capell\\Newsletter\\Models\\ImportBatch::$dry_run_payload",
                "Capell\\Newsletter\\Models\\ImportBatch::$source_meta",
                "Capell\\Newsletter\\Models\\ProviderConnection::$credentials",
                "Capell\\Newsletter\\Models\\ProviderConnection::$oauth_tokens",
                "Capell\\Newsletter\\Models\\ProviderConnection::$webhook_secret",
                "Capell\\Newsletter\\Models\\Subscriber::$email",
                "Capell\\Newsletter\\Models\\Subscriber::$first_name",
                "Capell\\Newsletter\\Models\\Subscriber::$last_name",
                "Capell\\Newsletter\\Models\\Subscriber::$profile"
            ],
            "hashedTokenFields": [
                "newsletter_public_tokens.token_hash",
                "newsletter_subscribers.email_hash",
                "newsletter_sync_attempts.payload_hash"
            ],
            "redactedOutputClasses": [
                "Capell\\Newsletter\\Actions\\RedactNewsletterProviderErrorMessageAction",
                "Capell\\Newsletter\\Actions\\SyncSubscriberToProviderAction"
            ],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": true,
            "requiresSecretRedaction": true,
            "clients": [
                "Capell\\Newsletter\\Support\\Providers\\CampaignMonitorProviderAdapter",
                "Capell\\Newsletter\\Support\\Providers\\KitProviderAdapter",
                "Capell\\Newsletter\\Support\\Providers\\MailchimpProviderAdapter"
            ]
        },
        "adminSurface": {
            "authorization": "policies",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["newsletter"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "newsletter.form-subscription",
            "label": "Form submissions can create subscribers with consent evidence",
            "class": "Capell\\Newsletter\\Health\\NewsletterHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        },
        {
            "key": "newsletter.provider-sync-retry",
            "label": "Provider sync failures are retried through durable sync attempts",
            "class": "Capell\\Newsletter\\Health\\NewsletterHealthCheck",
            "severity": "critical",
            "surface": "admin"
        },
        {
            "key": "newsletter.provider-webhooks",
            "label": "Provider webhooks normalize remote subscriber state",
            "class": "Capell\\Newsletter\\Health\\NewsletterHealthCheck",
            "severity": "warning",
            "surface": "frontend"
        },
        {
            "key": "newsletter.segments",
            "label": "Static and dynamic subscriber segments evaluate through typed actions",
            "class": "Capell\\Newsletter\\Health\\NewsletterHealthCheck",
            "severity": "warning",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Capture, confirm, and segment newsletter subscribers on every Capell site — with double opt-in, a public preference center, GDPR-grade consent evidence, and one-click sync to Mailchimp, Kit, and Campaign Monitor.",
