{
    "name": "capell-app/newsletter",
    "description": "Capture, confirm, and segment newsletter subscribers for Capell CMS with double opt-in, consent evidence, a preference center, and Mailchimp/Kit/Campaign Monitor sync.",
    "keywords": [
        "capell",
        "laravel",
        "filamentphp",
        "cms",
        "newsletter",
        "email-marketing",
        "subscribers",
        "double-opt-in",
        "gdpr-consent",
        "mailchimp",
        "kit-convertkit",
        "campaign-monitor",
        "segmentation",
        "preference-center",
        "unsubscribe",
        "audience-sync"
    ],
    "homepage": "https://github.com/capell-app/newsletter",
    "license": "proprietary",
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "capell-app/admin": "^4.0 || 4.x-dev",
        "capell-app/core": "^4.0 || 4.x-dev",
        "capell-app/form-builder": "^4.0 || 4.x-dev",
        "capell-app/frontend": "^4.0 || 4.x-dev",
        "capell-app/tags": "^4.0 || 4.x-dev"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Capell\\Newsletter\\": "src/",
            "Capell\\Newsletter\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\Newsletter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\Newsletter\\Providers\\NewsletterServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "pest"
    },
    "prefer-stable": true,
    "type": "library",
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/newsletter"
    }
}
