{
    "manifest-version": 3,
    "name": "capell-app/theme-inertia-bookings",
    "slug": "theme-inertia-bookings",
    "displayName": "Theme Inertia Bookings",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Premium Inertia booking-business theme for services, clinics, consultants, classes, and appointments.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\InertiaBookings",
    "surfaces": ["frontend", "console"],
    "dependencies": {
        "requires": [
            "capell-app/core",
            "capell-app/frontend",
            "capell-app/foundation-theme",
            "capell-app/inertia",
            "capell-app/bookings"
        ],
        "supports": [
            "capell-app/inertia-vue-adapter",
            "capell-app/inertia-react-adapter",
            "capell-app/layout-builder"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\InertiaBookings\\Providers\\InertiaBookingsThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\InertiaBookings\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "inertia-bookings"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-inertia-bookings-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-inertia-bookings", "inertia-bookings-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-inertia-bookings"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "theme-inertia-bookings.package-health",
            "label": "Theme Inertia Bookings runtime and renderer bindings are installed.",
            "class": "Capell\\ThemeStudio\\InertiaBookings\\Health\\ThemeInertiaBookingsHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Premium Inertia booking-business theme for services, clinics, consultants, classes, and appointments.",
        "description": "Theme Inertia Bookings renders Capell marketing pages through Inertia and links into the real Bookings appointment request flow with lazy slot loading.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.svg",
                "alt": "Theme Inertia Bookings marketplace card.",
                "caption": "Theme Inertia Bookings extension card."
            },
            {
                "path": "docs/screenshots/inertia-bookings-request-flow.png",
                "alt": "Theme Inertia Bookings appointment request flow with service, staff, location, slot, and customer fields.",
                "caption": "Runner-backed booking request flow with labelled controls, appointment slots, and customer details."
            },
            {
                "path": "docs/screenshots/inertia-bookings-mobile-request.png",
                "alt": "Theme Inertia Bookings mobile appointment request flow with service controls and available slots.",
                "caption": "Runner-backed mobile booking request flow with available slots and appointment actions."
            },
            {
                "path": "docs/screenshots/inertia-bookings-homepage.png",
                "alt": "Theme Inertia Bookings homepage with service-led booking content and appointment calls to action.",
                "caption": "Runner-backed homepage experience for service businesses using the Inertia Bookings theme."
            },
            {
                "path": "docs/screenshots/inertia-bookings-services.png",
                "alt": "Theme Inertia Bookings services listing with appointment-focused service cards.",
                "caption": "Runner-backed services listing with booking-oriented content cards and appointment paths."
            },
            {
                "path": "docs/screenshots/inertia-bookings-locations.png",
                "alt": "Theme Inertia Bookings locations page with clinic and service-location details.",
                "caption": "Runner-backed locations page for multi-location booking businesses."
            }
        ],
        "categories": ["frontend", "themes", "bookings"]
    },
    "themeKey": "inertia-bookings"
}
