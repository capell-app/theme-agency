{
    "name": "capell-app/ai-creator",
    "description": "Reviewed AI-assisted creation sessions for Capell content, pages, layouts, and extension recommendations",
    "keywords": [
        "capell",
        "ai-creator",
        "ai"
    ],
    "homepage": "https://capell.app",
    "license": "proprietary",
    "authors": [
        {
            "name": "Howdu",
            "email": "capell.app26@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "capell-app/admin": "^4.0 || 4.x-dev",
        "capell-app/agent-bridge": "^4.0 || 4.x-dev",
        "capell-app/ai-orchestrator": "^4.0 || 4.x-dev",
        "capell-app/core": "^4.0 || 4.x-dev",
        "capell-app/theme-foundation": "^4.0 || 4.x-dev",
        "capell-app/layout-builder": "^4.0 || 4.x-dev",
        "lorisleiva/laravel-actions": "^2.8",
        "spatie/laravel-data": "^4.5",
        "spatie/laravel-package-tools": "^1.14.1"
    },
    "autoload": {
        "psr-4": {
            "Capell\\AiCreator\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\AiCreator\\Providers\\AiCreatorServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true,
    "type": "library",
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/ai-creator"
    }
}
