{
    "manifest-version": 3,
    "name": "capell-app/theme-reading-room",
    "slug": "theme-reading-room",
    "displayName": "Theme Reading Room",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Reading Room is a first-party Capell theme in the docs-knowledge family, generated by capell:make-theme as a night-shift-shaped, definition-only, layout-native scaffold.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\ReadingRoom",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": [
            "capell-app/core",
            "capell-app/theme-foundation",
            "capell-app/frontend",
            "capell-app/layout-builder"
        ],
        "supports": ["capell-app/blog", "capell-app/form-builder"],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\ReadingRoom\\ReadingRoomThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-reading-room-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-reading-room", "theme-reading-room-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-reading-room"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Core\\Models\\Layout",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\LayoutBuilder\\Models\\Widget",
                    "events": ["saved", "deleted"]
                }
            ],
            "queueInvalidation": false
        }
    },
    "healthChecks": [],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Reading Room theme scaffold.",
        "description": "Reading Room provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for the docs-knowledge family.",
        "screenshots": [],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "reading-room"
}
