{
    "manifest-version": 3,
    "name": "capell-app/theme-inertia-bookings-vue",
    "slug": "theme-inertia-bookings-vue",
    "displayName": "Theme Inertia Bookings Vue",
    "kind": "plugin",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Vue component pack for Theme Inertia Bookings.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\InertiaBookingsVue",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": [
            "capell-app/theme-inertia-bookings",
            "capell-app/inertia-vue-adapter"
        ],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\InertiaBookingsVue\\Providers\\InertiaBookingsVueServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "frontend-component",
            "class": "Capell\\ThemeStudio\\InertiaBookingsVue\\Manifest\\InertiaBookingsVueComponentContribution",
            "component": "Capell/Bookings/Request",
            "adapter": "vue",
            "surface": "frontend"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-inertia-bookings-vue"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-inertia-bookings-vue"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-inertia-bookings-vue.package-health",
            "label": "Theme Inertia Bookings Vue components are present.",
            "class": "Capell\\ThemeStudio\\InertiaBookingsVue\\Health\\InertiaBookingsVueHealthCheck",
            "severity": "important",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Vue components for Theme Inertia Bookings.",
        "description": "Provides Vue source components that implement the shared Capell/Page and Capell/Bookings/Request server contract.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.svg",
                "alt": "Theme Inertia Bookings Vue marketplace card.",
                "caption": "Theme Inertia Bookings Vue extension card."
            },
            {
                "path": "docs/screenshots/vue-booking-components.png",
                "alt": "Theme Inertia Bookings Vue request components rendered through the adapter.",
                "caption": "Runner-backed Vue booking request component pack."
            },
            {
                "path": "docs/screenshots/vue-booking-services.png",
                "alt": "Theme Inertia Bookings Vue services sections rendered with booking-focused cards.",
                "caption": "Runner-backed Vue services layout for appointment-led businesses."
            },
            {
                "path": "docs/screenshots/vue-booking-slot-loading.png",
                "alt": "Theme Inertia Bookings Vue slot loading state with stable public selectors.",
                "caption": "Runner-backed Vue deferred slot loading state."
            },
            {
                "path": "docs/screenshots/vue-booking-validation.png",
                "alt": "Theme Inertia Bookings Vue validation state with accessible inline errors.",
                "caption": "Runner-backed Vue validation state for failed booking requests."
            },
            {
                "path": "docs/screenshots/vue-booking-mobile.png",
                "alt": "Theme Inertia Bookings Vue mobile booking request layout.",
                "caption": "Runner-backed Vue mobile booking request flow."
            }
        ],
        "categories": ["frontend", "themes"]
    }
}
