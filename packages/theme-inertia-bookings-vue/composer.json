{
    "name": "capell-app/theme-inertia-bookings-vue",
    "description": "Vue components for the Capell Inertia Bookings theme.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "capell-app/core": "^4.0 || 4.x-dev",
        "capell-app/inertia-vue-adapter": "^4.0 || 4.x-dev",
        "capell-app/theme-inertia-bookings": "^4.0 || 4.x-dev",
        "spatie/laravel-package-tools": "^1.14.1"
    },
    "autoload": {
        "psr-4": {
            "Capell\\ThemeStudio\\InertiaBookingsVue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\ThemeStudio\\InertiaBookingsVue\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\ThemeStudio\\InertiaBookingsVue\\Providers\\InertiaBookingsVueServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true,
    "keywords": [
        "capell",
        "inertia",
        "bookings",
        "vue"
    ]
}
