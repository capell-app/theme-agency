{
    "manifest-version": 3,
    "name": "capell-app/hero",
    "slug": "hero",
    "displayName": "Hero",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "A polished, responsive home hero for every Capell theme — autoplay video or decorative overlay backgrounds, multi-slide carousel, and theme-level styling that pages inherit automatically.",
    "product": {
        "group": "Capell Foundation",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\Hero",
    "surfaces": ["admin", "frontend", "console"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend",
            "capell-app/layout-builder"
        ],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": ["Capell\\Hero\\Providers\\HeroServiceProvider"],
        "admin": [],
        "frontend": []
    },
    "contributes": [],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": "capell:hero-setup",
        "setupParams": ["force"],
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "hero-widget",
        "hero-video-background",
        "hero-overlay-backgrounds",
        "hero-carousel",
        "hero-theme-inheritance"
    ],
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["hero"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "hero.package-health",
            "label": "Hero package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\Hero\\Health\\HeroHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "A polished, responsive home hero for every Capell theme — autoplay video or decorative overlay backgrounds, multi-slide carousel, and theme-level styling that pages inherit automatically.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Hero extension preview image",
                "caption": "Hero extension preview"
            },
            {
                "path": "docs/screenshots/hero-home-widget.png",
                "alt": "Capell public homepage rendering the Hero widget",
                "caption": "Render a clean public homepage hero with inherited theme styling and deterministic setup data."
            }
        ],
        "categories": ["admin", "console", "foundation", "frontend"]
    }
}
