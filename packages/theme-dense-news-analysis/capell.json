{
    "manifest-version": 3,
    "name": "capell-app/theme-dense-news-analysis",
    "slug": "theme-dense-news-analysis",
    "displayName": "Theme Dense News Analysis",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Dense News Analysis extends the default Capell frontend with a serious newsroom direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for top stories, live briefs, topic navigation, opinion, video, missed-it recaps, archives, and newsletter inserts.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\DenseNewsAnalysis",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\DenseNewsAnalysis\\DenseNewsAnalysisThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\DenseNewsAnalysis\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "dense-news-analysis"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-dense-news-analysis-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-dense-news-analysis",
        "theme-dense-news-analysis-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-dense-news-analysis"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-dense-news-analysis.package-health",
            "label": "Dense News Analysis package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\DenseNewsAnalysis\\Health\\ThemeDenseNewsAnalysisHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for serious news publishers, analysis desks, opinion pages, video rows, live coverage, and reader briefings.",
        "description": "Dense News Analysis provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for publishers that need dense hierarchy, trust signals, live context, opinion, video, topic routes, and newsletter growth.",
        "screenshots": [
            {
                "path": "docs/screenshots/dense-news-analysis-homepage.png",
                "alt": "Dense News Analysis homepage preview",
                "caption": "Dense News Analysis Homepage"
            },
            {
                "path": "docs/screenshots/dense-news-analysis-landing.png",
                "alt": "Dense News Analysis landing page preview",
                "caption": "Dense News Analysis Landing page"
            },
            {
                "path": "docs/screenshots/dense-news-analysis-listing.png",
                "alt": "Dense News Analysis list page preview",
                "caption": "Dense News Analysis List page"
            },
            {
                "path": "docs/screenshots/dense-news-analysis-search.png",
                "alt": "Dense News Analysis search results preview",
                "caption": "Dense News Analysis Search results"
            },
            {
                "path": "docs/screenshots/dense-news-analysis-contact.png",
                "alt": "Dense News Analysis contact form preview",
                "caption": "Dense News Analysis Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "dense-news-analysis"
}
