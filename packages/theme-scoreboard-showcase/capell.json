{
    "manifest-version": 3,
    "name": "capell-app/theme-scoreboard-showcase",
    "slug": "theme-scoreboard-showcase",
    "displayName": "Theme Scoreboard Showcase",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Scoreboard Showcase extends the default Capell frontend with a design-awards scoreboard direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for warm off-white pages, compact uppercase labels, numeric scores, segmented judging criteria, winner-of-the-day modules, newest nominees, previous winners, public voting states, score breakdowns, creator credits, and precise archive pages.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\ScoreboardShowcase",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\ScoreboardShowcase\\ScoreboardShowcaseThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\ScoreboardShowcase\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "scoreboard-showcase"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-scoreboard-showcase-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-scoreboard-showcase",
        "theme-scoreboard-showcase-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-scoreboard-showcase"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-scoreboard-showcase.package-health",
            "label": "Scoreboard Showcase package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\ScoreboardShowcase\\Health\\ThemeScoreboardShowcaseHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A warm Capell theme for design-awards scoreboards with winner modules, nominee cards, criteria scores, previous winners, voting states, and creator credits.",
        "description": "Scoreboard Showcase provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for awards sites that need winner-of-the-day heroes, newest nominees, previous winners, UI/UX/innovation/overall score breakdowns, numeric score cards, compact uppercase labels, date/country/category metadata, public voting CTAs, status states, creator credits, related winners, and precise archive pages.",
        "screenshots": [
            {
                "path": "docs/screenshots/scoreboard-showcase-homepage.png",
                "alt": "Scoreboard Showcase homepage preview",
                "caption": "Scoreboard Showcase Homepage"
            },
            {
                "path": "docs/screenshots/scoreboard-showcase-landing.png",
                "alt": "Scoreboard Showcase landing page preview",
                "caption": "Scoreboard Showcase Landing page"
            },
            {
                "path": "docs/screenshots/scoreboard-showcase-listing.png",
                "alt": "Scoreboard Showcase list page preview",
                "caption": "Scoreboard Showcase Awards archive"
            },
            {
                "path": "docs/screenshots/scoreboard-showcase-search.png",
                "alt": "Scoreboard Showcase search results preview",
                "caption": "Scoreboard Showcase Search results"
            },
            {
                "path": "docs/screenshots/scoreboard-showcase-contact.png",
                "alt": "Scoreboard Showcase contact form preview",
                "caption": "Scoreboard Showcase Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "scoreboard-showcase"
}
