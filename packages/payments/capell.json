{
    "manifest-version": 3,
    "name": "capell-app/payments",
    "slug": "payments",
    "displayName": "Payments",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Payments adds a provider-neutral payment record layer and native Stripe Checkout foundation for Capell.",
    "product": {
        "group": "Capell Commerce",
        "tier": "premium",
        "bundle": "commerce"
    },
    "namespace": "Capell\\Payments",
    "surfaces": ["admin", "frontend", "console"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core"],
        "supports": [
            "capell-app/access-gate",
            "capell-app/customer-portal",
            "capell-app/form-builder"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": ["Capell\\Payments\\Providers\\PaymentsServiceProvider"],
        "runtime": ["Capell\\Payments\\Providers\\PaymentsServiceProvider"],
        "admin": ["Capell\\Payments\\Providers\\AdminServiceProvider"],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\Payments\\Manifest\\PaymentCustomerResourceContribution",
            "resourceClass": "Capell\\Payments\\Filament\\Resources\\Customers\\PaymentCustomerResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\Payments\\Manifest\\CheckoutSessionResourceContribution",
            "resourceClass": "Capell\\Payments\\Filament\\Resources\\CheckoutSessions\\CheckoutSessionResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\Payments\\Manifest\\PaymentIntentResourceContribution",
            "resourceClass": "Capell\\Payments\\Filament\\Resources\\PaymentIntents\\PaymentIntentResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\Payments\\Manifest\\SubscriptionResourceContribution",
            "resourceClass": "Capell\\Payments\\Filament\\Resources\\Subscriptions\\SubscriptionResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\Payments\\Manifest\\PaymentWebhookEventResourceContribution",
            "resourceClass": "Capell\\Payments\\Filament\\Resources\\WebhookEvents\\PaymentWebhookEventResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\Payments\\Manifest\\PaymentRefundResourceContribution",
            "resourceClass": "Capell\\Payments\\Filament\\Resources\\Refunds\\PaymentRefundResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\Payments\\Manifest\\PaymentDisputeResourceContribution",
            "resourceClass": "Capell\\Payments\\Filament\\Resources\\Disputes\\PaymentDisputeResource"
        },
        {
            "type": "model",
            "class": "Capell\\Payments\\Manifest\\PaymentsModelsContribution"
        },
        {
            "type": "route",
            "class": "Capell\\Payments\\Manifest\\PaymentsFrontendRoutesContribution"
        }
    ],
    "database": {
        "migrations": true,
        "settings": true,
        "requiredTables": [
            "payment_customers",
            "payment_checkout_sessions",
            "payment_intents",
            "payment_subscriptions",
            "payment_webhook_events",
            "payment_refunds",
            "payment_disputes",
            "payment_download_entitlements"
        ],
        "protectedTables": [
            "payment_customers",
            "payment_checkout_sessions",
            "payment_intents",
            "payment_subscriptions",
            "payment_webhook_events",
            "payment_refunds",
            "payment_disputes",
            "payment_download_entitlements"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "actions": {
        "checkout": "Capell\\Payments\\Actions\\CreateCheckoutSessionAction",
        "billingPortal": "Capell\\Payments\\Actions\\CreateBillingPortalSessionAction",
        "formPaymentCheckoutUrl": "Capell\\Payments\\Actions\\CreateFormPaymentCheckoutUrlAction",
        "formPaymentCheckout": "Capell\\Payments\\Actions\\CreateFormPaymentCheckoutSessionAction",
        "paidDownloadUrl": "Capell\\Payments\\Actions\\CreatePaidDownloadUrlAction",
        "subscriptionEntitlement": "Capell\\Payments\\Actions\\ResolveSubscriptionEntitlementAction"
    },
    "settings": ["Capell\\Payments\\Settings\\PaymentsSettings"],
    "permissions": [
        "View:PaymentCustomer",
        "View:CheckoutSession",
        "View:PaymentIntent",
        "View:Subscription",
        "View:PaymentWebhookEvent",
        "View:PaymentRefund",
        "View:PaymentDispute"
    ],
    "capabilities": [
        "stripe-checkout",
        "one-off-payments",
        "subscriptions",
        "donations",
        "paid-downloads",
        "paid-gated-access",
        "form-payment-fields",
        "stripe-webhooks",
        "refund-records",
        "dispute-records",
        "payments-admin",
        "payment-fulfillment-handlers",
        "stripe-billing-portal",
        "subscription-entitlements",
        "customer-portal-billing-dashboard",
        "customer-portal-payments-feed"
    ],
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": ["payments"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "customer"],
            "sensitiveOutput": true,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "payments.package-health",
            "label": "Payments models, migrations, and gateway configuration are discoverable.",
            "class": "Capell\\Payments\\Health\\PaymentsHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Provider-neutral payment records with native Stripe Checkout, subscriptions, form payments, paid downloads, and paid gated access fulfillment.",
        "screenshots": [],
        "categories": ["commerce", "integrations"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
