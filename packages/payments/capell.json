{
    "manifest-version": 3,
    "name": "capell-app/payments",
    "slug": "payments",
    "displayName": "Payments",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Payments gives Capell a first-party way to charge customers without depending on an external store. It ships native Stripe Checkout for one-off purchases, recurring subscriptions, donations, paid file downloads, and fulfillment-backed gated-access handoffs, plus signed webhook intake that keeps payments, subscriptions, refunds, and disputes in sync automatically. Every record is stored behind a provider-neutral model layer, so admins get read-only audit resources, customers get a self-service billing portal, and Form Builder fields can collect payment inline. Designed for revenue-generating sites that want checkout, fulfilment, and reconciliation handled inside the CMS.",
    "product": {
        "group": "Capell Commerce",
        "tier": "premium",
        "bundle": "commerce"
    },
    "namespace": "Capell\\Payments",
    "surfaces": ["admin", "frontend", "console"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core"],
        "supports": [
            "capell-app/access-gate",
            "capell-app/customer-portal",
            "capell-app/form-builder"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": ["Capell\\Payments\\Providers\\PaymentsServiceProvider"],
        "runtime": ["Capell\\Payments\\Providers\\PaymentsServiceProvider"],
        "admin": ["Capell\\Payments\\Providers\\AdminServiceProvider"],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\Payments\\Manifest\\PaymentCustomerResourceContribution",
            "resourceClass": "Capell\\Payments\\Filament\\Resources\\Customers\\PaymentCustomerResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\Payments\\Manifest\\CheckoutSessionResourceContribution",
            "resourceClass": "Capell\\Payments\\Filament\\Resources\\CheckoutSessions\\CheckoutSessionResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\Payments\\Manifest\\PaymentIntentResourceContribution",
            "resourceClass": "Capell\\Payments\\Filament\\Resources\\PaymentIntents\\PaymentIntentResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\Payments\\Manifest\\SubscriptionResourceContribution",
            "resourceClass": "Capell\\Payments\\Filament\\Resources\\Subscriptions\\SubscriptionResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\Payments\\Manifest\\PaymentWebhookEventResourceContribution",
            "resourceClass": "Capell\\Payments\\Filament\\Resources\\WebhookEvents\\PaymentWebhookEventResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\Payments\\Manifest\\PaymentRefundResourceContribution",
            "resourceClass": "Capell\\Payments\\Filament\\Resources\\Refunds\\PaymentRefundResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\Payments\\Manifest\\PaymentDisputeResourceContribution",
            "resourceClass": "Capell\\Payments\\Filament\\Resources\\Disputes\\PaymentDisputeResource"
        },
        {
            "type": "model",
            "class": "Capell\\Payments\\Manifest\\PaymentsModelsContribution"
        },
        {
            "type": "route",
            "class": "Capell\\Payments\\Manifest\\PaymentsFrontendRoutesContribution"
        }
    ],
    "database": {
        "migrations": true,
        "settings": true,
        "requiredTables": [
            "payment_customers",
            "payment_checkout_sessions",
            "payment_intents",
            "payment_subscriptions",
            "payment_webhook_events",
            "payment_refunds",
            "payment_disputes",
            "payment_download_entitlements"
        ],
        "protectedTables": [
            "payment_customers",
            "payment_checkout_sessions",
            "payment_intents",
            "payment_subscriptions",
            "payment_webhook_events",
            "payment_refunds",
            "payment_disputes",
            "payment_download_entitlements"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "actions": {
        "checkout": "Capell\\Payments\\Actions\\CreateCheckoutSessionAction",
        "billingPortal": "Capell\\Payments\\Actions\\CreateBillingPortalSessionAction",
        "formPaymentCheckoutUrl": "Capell\\Payments\\Actions\\CreateFormPaymentCheckoutUrlAction",
        "formPaymentCheckout": "Capell\\Payments\\Actions\\CreateFormPaymentCheckoutSessionAction",
        "paidDownloadUrl": "Capell\\Payments\\Actions\\CreatePaidDownloadUrlAction",
        "subscriptionEntitlement": "Capell\\Payments\\Actions\\ResolveSubscriptionEntitlementAction"
    },
    "settings": ["Capell\\Payments\\Settings\\PaymentsSettings"],
    "permissions": [
        "View:PaymentCustomer",
        "View:CheckoutSession",
        "View:PaymentIntent",
        "View:Subscription",
        "View:PaymentWebhookEvent",
        "View:PaymentRefund",
        "View:PaymentDispute"
    ],
    "capabilities": [
        "stripe-checkout",
        "one-off-payments",
        "subscriptions",
        "donations",
        "paid-downloads",
        "paid-gated-access",
        "form-payment-fields",
        "stripe-webhooks",
        "refund-records",
        "dispute-records",
        "payments-admin",
        "payment-fulfillment-handlers",
        "stripe-billing-portal",
        "subscription-entitlements",
        "customer-portal-billing-dashboard",
        "customer-portal-payments-feed"
    ],
    "security": {
        "riskTier": "sensitive",
        "publicSurface": {
            "routeNames": [
                "capell-payments.form-builder.checkout",
                "capell-payments.paid-downloads.show",
                "capell-payments.portal.billing",
                "capell-payments.stripe-webhook",
                "stripe-webhook",
                "paid-downloads.show",
                "form-builder.checkout",
                "portal.billing"
            ],
            "auth": "mixed",
            "csrfExemptRoutes": [
                "capell-payments.stripe-webhook",
                "stripe-webhook"
            ],
            "signedRoutes": [
                "capell-payments.paid-downloads.show",
                "paid-downloads.show",
                "form-builder.checkout"
            ],
            "tokenizedRoutes": [],
            "webhookRoutes": [
                "capell-payments.stripe-webhook",
                "stripe-webhook"
            ],
            "throttledRoutes": ["stripe-webhook"]
        },
        "sensitiveData": {
            "encryptedFields": [
                "Capell\\Payments\\Models\\CheckoutSession::$provider_payload",
                "Capell\\Payments\\Models\\PaymentCustomer::$email",
                "Capell\\Payments\\Models\\PaymentCustomer::$provider_payload",
                "Capell\\Payments\\Models\\PaymentDispute::$provider_payload",
                "Capell\\Payments\\Models\\PaymentDownloadEntitlement::$email",
                "Capell\\Payments\\Models\\PaymentIntent::$provider_payload",
                "Capell\\Payments\\Models\\PaymentRefund::$provider_payload",
                "Capell\\Payments\\Models\\PaymentWebhookEvent::$payload",
                "Capell\\Payments\\Models\\Subscription::$provider_payload"
            ],
            "hashedTokenFields": [],
            "redactedOutputClasses": [
                "Capell\\Payments\\Actions\\ProcessStripeWebhookEventAction",
                "Capell\\Payments\\Actions\\RedactPaymentErrorMessageAction"
            ],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": false,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": true,
            "requiresSecretRedaction": true,
            "clients": [
                "Capell\\Payments\\Actions\\CreateBillingPortalSessionAction",
                "Capell\\Payments\\Actions\\IssuePaymentRefundAction",
                "Capell\\Payments\\Support\\Gateways\\StripePaymentGateway"
            ]
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "View:PaymentCustomer",
                "View:CheckoutSession",
                "View:PaymentIntent",
                "View:Subscription",
                "View:PaymentWebhookEvent",
                "View:PaymentRefund",
                "View:PaymentDispute"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": ["payments"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "customer"],
            "sensitiveOutput": true,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "payments.package-health",
            "label": "Payments models, migrations, and gateway configuration are discoverable.",
            "class": "Capell\\Payments\\Health\\PaymentsHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Take one-off payments, donations, subscriptions, paid downloads, and fulfillment-backed gated-access handoffs through Stripe Checkout — with a provider-neutral record layer built to add more gateways later.",
        "screenshots": [
            {
                "path": "docs/screenshots/payments-checkout-sessions.png",
                "alt": "Payments checkout sessions admin table with payment and fulfillment states",
                "caption": "Payments checkout sessions"
            },
            {
                "path": "docs/screenshots/payments-webhook-events.png",
                "alt": "Payments webhook events admin table with Stripe processing states",
                "caption": "Payments webhook events"
            },
            {
                "path": "docs/screenshots/payments-settings.png",
                "alt": "Payments settings page for Stripe Checkout and webhook configuration",
                "caption": "Payments settings"
            },
            {
                "path": "docs/screenshots/payments-customer-portal.png",
                "alt": "Customer portal billing view with subscriptions, payments, and paid downloads",
                "caption": "Payments customer portal billing"
            },
            {
                "path": "docs/screenshots/payments-form-builder-checkout.png",
                "alt": "Public Form Builder payment checkout handoff view",
                "caption": "Payments Form Builder checkout"
            }
        ],
        "categories": ["commerce", "integrations"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
