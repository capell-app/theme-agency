{
    "manifest-version": 3,
    "name": "capell-app/frontend-authoring",
    "slug": "frontend-authoring",
    "displayName": "Frontend Authoring",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "In-page (frontend) editing for Capell: an admin-only beacon adds inline edit controls to live pages without leaking any editor markup or signed URLs into public or cached output.",
    "product": {
        "group": "Capell Foundation",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\FrontendAuthoring",
    "surfaces": [
        "frontend",
        "console"
    ],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend",
            "capell-app/html-cache"
        ],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\FrontendAuthoring\\Providers\\FrontendAuthoringServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [
        "frontend-authoring.edit"
    ],
    "capabilities": [
        "authoring-surface",
        "preview-only",
        "beacon",
        "cache-blocking"
    ],
    "security": {
        "riskTier": "sensitive",
        "publicSurface": {
            "routeNames": [
                "capell-frontend.authoring.edit",
                "capell-frontend.beacon",
                "beacon",
                "authoring.edit"
            ],
            "auth": "admin-only",
            "csrfExemptRoutes": [
                "capell-frontend.beacon",
                "beacon"
            ],
            "signedRoutes": [
                "capell-frontend.authoring.edit",
                "authoring.edit"
            ],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": [
                "capell-frontend.beacon",
                "beacon"
            ]
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "frontend-authoring.edit"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": [
            "frontend-authoring"
        ],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [
                "site",
                "locale"
            ],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "frontend-authoring.package-health",
            "label": "Frontend Authoring package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\FrontendAuthoring\\Health\\FrontendAuthoringHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Edit page titles, descriptions and content straight from the live site — admins get inline edit controls after the page loads, while visitors and caches only ever see ordinary HTML.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Frontend Authoring extension preview image",
                "caption": "Frontend Authoring extension preview"
            },
            {
                "path": "docs/screenshots/capell-app-frontend-authoring-mobile.png",
                "alt": "Inline authoring overlay working on a mobile viewport",
                "caption": "Authoring controls stay usable on mobile"
            }
        ],
        "categories": [
            "console",
            "foundation",
            "frontend"
        ]
    },
    "scopes": [
        "frontend"
    ],
    "contributionTraceability": {
        "deferredContributions": [
            "route"
        ]
    }
}
