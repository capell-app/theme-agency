{
    "manifest-version": 3,
    "name": "capell-app/theme-financial-advisory",
    "slug": "theme-financial-advisory",
    "displayName": "Theme Financial Advisory",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Financial Advisory extends the default Capell frontend with a financial advisory visual direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for financial advisors, accountants.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\FinancialAdvisory",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\FinancialAdvisory\\FinancialAdvisoryThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\FinancialAdvisory\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "financial-advisory"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-financial-advisory-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-financial-advisory",
        "theme-financial-advisory-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-financial-advisory"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-financial-advisory.package-health",
            "label": "Financial Advisory package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\FinancialAdvisory\\Health\\ThemeFinancialAdvisoryHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for financial advisors, accountants.",
        "description": "Financial Advisory provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for Sterling & Vale Advisors.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Financial Advisory marketplace card preview",
                "caption": "Financial Advisory premium theme card"
            },
            {
                "path": "docs/screenshots/financial-advisory-homepage.png",
                "alt": "Financial Advisory Homepage demo page screenshot",
                "caption": "Financial Advisory Homepage page"
            },
            {
                "path": "docs/screenshots/financial-advisory-directory.png",
                "alt": "Financial Advisory Directory demo page screenshot",
                "caption": "Financial Advisory Directory page"
            },
            {
                "path": "docs/screenshots/financial-advisory-detail.png",
                "alt": "Financial Advisory Detail demo page screenshot",
                "caption": "Financial Advisory Detail page"
            },
            {
                "path": "docs/screenshots/financial-advisory-contact.png",
                "alt": "Financial Advisory Contact demo page screenshot",
                "caption": "Financial Advisory Contact page"
            },
            {
                "path": "docs/screenshots/financial-advisory-empty.png",
                "alt": "Financial Advisory Empty State demo page screenshot",
                "caption": "Financial Advisory Empty State page"
            },
            {
                "path": "docs/screenshots/financial-advisory-not-found.png",
                "alt": "Financial Advisory 404 State demo page screenshot",
                "caption": "Financial Advisory 404 State page"
            },
            {
                "path": "docs/screenshots/financial-advisory-cta.png",
                "alt": "Financial Advisory Conversion CTA demo page screenshot",
                "caption": "Financial Advisory Conversion CTA page"
            },
            {
                "path": "docs/screenshots/financial-advisory-services.png",
                "alt": "Financial Advisory Services demo page screenshot",
                "caption": "Financial Advisory Services page"
            },
            {
                "path": "docs/screenshots/financial-advisory-advisors.png",
                "alt": "Financial Advisory Advisors demo page screenshot",
                "caption": "Financial Advisory Advisors page"
            },
            {
                "path": "docs/screenshots/financial-advisory-calculators.png",
                "alt": "Financial Advisory Calculators demo page screenshot",
                "caption": "Financial Advisory Calculators page"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "financial-advisory"
}
