{
    "manifest-version": 3,
    "name": "capell-app/theme-ink-press",
    "slug": "theme-ink-press",
    "displayName": "Theme Ink Press",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "A serious newsroom front page: top stories, live briefs, opinion, and deep archives at broadsheet density. For publishers who measure the day in column inches.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\InkPress",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\InkPress\\InkPressThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\InkPress\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "ink-press"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-ink-press-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-ink-press", "theme-ink-press-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-ink-press"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-ink-press.package-health",
            "label": "Ink Press package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\InkPress\\Health\\ThemeInkPressHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A serious newsroom front page: top stories, live briefs, opinion, and deep archives at broadsheet density.",
        "description": "Ink Press provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for publishers that need dense hierarchy, trust signals, live context, opinion, video, topic routes, and newsletter growth.",
        "screenshots": [
            {
                "path": "docs/screenshots/ink-press-homepage.png",
                "alt": "Ink Press homepage preview",
                "caption": "Ink Press Homepage"
            },
            {
                "path": "docs/screenshots/ink-press-landing.png",
                "alt": "Ink Press landing page preview",
                "caption": "Ink Press Landing page"
            },
            {
                "path": "docs/screenshots/ink-press-listing.png",
                "alt": "Ink Press list page preview",
                "caption": "Ink Press List page"
            },
            {
                "path": "docs/screenshots/ink-press-search.png",
                "alt": "Ink Press search results preview",
                "caption": "Ink Press Search results"
            },
            {
                "path": "docs/screenshots/ink-press-contact.png",
                "alt": "Ink Press contact form preview",
                "caption": "Ink Press Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "ink-press"
}
