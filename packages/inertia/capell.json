{
    "manifest-version": 3,
    "name": "capell-app/inertia",
    "slug": "inertia",
    "displayName": "Capell Inertia",
    "kind": "plugin",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Shared Inertia runtime bridge for Capell public pages, package-owned frontend routes, and adapter-driven themes, with sanitized adapter, root-view, and component configuration.",
    "product": {
        "group": "Capell Frontend",
        "tier": "core",
        "bundle": "frontend"
    },
    "namespace": "Capell\\Inertia",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": [
            "capell-app/core",
            "capell-app/frontend",
            "capell-app/api"
        ],
        "supports": ["capell-app/layout-builder"],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": ["Capell\\Inertia\\Providers\\InertiaServiceProvider"],
        "admin": [],
        "frontend": []
    },
    "contributes": [],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "inertia-runtime",
        "inertia-frontend",
        "sanitized-inertia-config"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["inertia"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "inertia.package-health",
            "label": "Capell Inertia runtime bridge is installed and configured.",
            "class": "Capell\\Inertia\\Health\\InertiaHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "included",
        "requestedCertification": "first-party",
        "supportPolicy": "standard",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Connect Capell public rendering to Inertia adapters with one root view, middleware stack, safe runtime props, and an adapter registry for package-owned Vue or React frontends.",
        "description": "Registers the Inertia renderer, root view, middleware, sanitized public runtime props, sanitized render configuration, and adapter registry for Capell frontend runtimes.",
        "screenshots": [],
        "categories": ["frontend", "developer-tools"]
    }
}
