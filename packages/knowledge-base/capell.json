{
    "manifest-version": 3,
    "name": "capell-app/knowledge-base",
    "slug": "knowledge-base",
    "displayName": "Knowledge Base",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Knowledge Base turns your Capell install into a structured help centre. Authors group articles into public collections, and readers browse a fast, cacheable /docs site and tell you whether each article helped. Public navigation, article, and AI-readable payloads are emitted as typed data objects, so any theme can render them and assistants can consume them without leaking authoring internals. Article HTML is sanitised at the public render boundary, and reader feedback is captured with hashed visitor identifiers.",
    "product": {
        "group": "Capell Content",
        "tier": "premium",
        "bundle": "content-product"
    },
    "namespace": "Capell\\KnowledgeBase",
    "surfaces": ["frontend", "admin"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/search",
            "capell-app/seo-suite",
            "capell-app/site-discovery",
            "capell-app/theme-knowledge"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\KnowledgeBase\\Providers\\KnowledgeBaseServiceProvider"
        ],
        "admin": ["Capell\\KnowledgeBase\\Providers\\AdminServiceProvider"],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-resource",
            "key": "knowledge-base.collections",
            "class": "Capell\\KnowledgeBase\\Manifest\\KnowledgeBaseCollectionResourceContribution",
            "resourceClass": "Capell\\KnowledgeBase\\Filament\\Resources\\Collections\\KnowledgeBaseCollectionResource",
            "group": "KnowledgeBaseCollection"
        },
        {
            "type": "admin-resource",
            "key": "knowledge-base.articles",
            "class": "Capell\\KnowledgeBase\\Manifest\\KnowledgeBaseArticleResourceContribution",
            "resourceClass": "Capell\\KnowledgeBase\\Filament\\Resources\\Articles\\KnowledgeBaseArticleResource",
            "group": "KnowledgeBaseArticle"
        },
        {
            "type": "model",
            "class": "Capell\\KnowledgeBase\\Manifest\\KnowledgeBaseModelsContribution"
        },
        {
            "type": "route",
            "class": "Capell\\KnowledgeBase\\Manifest\\KnowledgeBaseFrontendRoutesContribution"
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": [
            "knowledge_base_collections",
            "knowledge_base_articles",
            "knowledge_base_article_versions",
            "knowledge_base_article_feedback",
            "knowledge_base_related_articles"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "actions": {
        "buildAiReadableKnowledgeBaseOutput": "Capell\\KnowledgeBase\\Actions\\BuildAiReadableKnowledgeBaseOutputAction",
        "buildKnowledgeBaseSearchDocuments": "Capell\\KnowledgeBase\\Actions\\BuildKnowledgeBaseSearchDocumentsAction",
        "buildPublicKnowledgeBaseArticleData": "Capell\\KnowledgeBase\\Actions\\BuildPublicKnowledgeBaseArticleDataAction",
        "buildPublicKnowledgeBaseNavigation": "Capell\\KnowledgeBase\\Actions\\BuildPublicKnowledgeBaseNavigationAction",
        "createKnowledgeBaseArticle": "Capell\\KnowledgeBase\\Actions\\CreateKnowledgeBaseArticleAction",
        "createKnowledgeBaseArticleVersion": "Capell\\KnowledgeBase\\Actions\\CreateKnowledgeBaseArticleVersionAction",
        "publishKnowledgeBaseArticleVersion": "Capell\\KnowledgeBase\\Actions\\PublishKnowledgeBaseArticleVersionAction",
        "recordKnowledgeBaseArticleFeedback": "Capell\\KnowledgeBase\\Actions\\RecordKnowledgeBaseArticleFeedbackAction",
        "relateKnowledgeBaseArticles": "Capell\\KnowledgeBase\\Actions\\RelateKnowledgeBaseArticlesAction"
    },
    "permissions": [],
    "capabilities": [
        "knowledge-base",
        "knowledge-base-articles",
        "knowledge-base-admin-authoring",
        "knowledge-base-feedback",
        "knowledge-base-related-articles",
        "knowledge-base-versioned-articles",
        "knowledge-base-public-routes",
        "knowledge-base-public-navigation",
        "knowledge-base-public-output",
        "knowledge-base-search-documents",
        "knowledge-base-search-weighting",
        "knowledge-base-ai-output"
    ],
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["knowledge-base"],
        "cacheSafety": {
            "cacheable": true,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\KnowledgeBase\\Models\\KnowledgeBaseCollection",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                },
                {
                    "model": "Capell\\KnowledgeBase\\Models\\KnowledgeBaseArticle",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                },
                {
                    "model": "Capell\\KnowledgeBase\\Models\\KnowledgeBaseArticleVersion",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "knowledge-base.package-health",
            "label": "Knowledge Base package models, migrations, and public output actions are discoverable.",
            "class": "Capell\\KnowledgeBase\\Health\\KnowledgeBaseHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A self-hosted help centre for Capell: organise docs into public collections, capture reader feedback, and serve a fast, theme-agnostic /docs site backed by typed public and AI-readable payloads.",
        "screenshots": [
            {
                "path": "docs/screenshots/knowledge-base-articles-index.png",
                "label": "Knowledge Base articles",
                "alt": "Capell admin Knowledge Base Articles table showing published and draft articles, collection, AI readable status, search weight, and publish date.",
                "caption": "Review published and draft help articles with collection, AI-readability, search weight, and publish status."
            },
            {
                "path": "docs/screenshots/knowledge-base-article-edit-version-history.png",
                "label": "Article edit flow",
                "alt": "Capell admin edit form for the Installing Capell article showing collection, status, title, slug, body, version, search weight, and AI readable fields.",
                "caption": "Edit an article through the shipped Capell admin form while preparing the next version for publication."
            }
        ],
        "categories": ["content", "frontend", "search-seo"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
