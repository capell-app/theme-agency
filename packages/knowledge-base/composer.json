{
    "name": "capell-app/knowledge-base",
    "description": "Self-hosted help centre for Capell: public doc collections, reader feedback, and a theme-agnostic /docs site backed by typed public and AI-readable payloads",
    "keywords": [
        "capell",
        "knowledge-base",
        "docs",
        "documentation",
        "laravel",
        "cms"
    ],
    "homepage": "https://github.com/capell-app/knowledge-base",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "capell-app/admin": "^4.0 || 4.x-dev",
        "capell-app/core": "^4.0 || 4.x-dev",
        "capell-app/frontend": "^4.0 || 4.x-dev",
        "filament/filament": "^4.0|^5.0",
        "filament/support": "^4.7|^5.2",
        "laravel/framework": "^11.45.3|^12.41.1|^13.0",
        "lorisleiva/laravel-actions": "^2.8",
        "spatie/laravel-data": "^4.5",
        "spatie/laravel-package-tools": "^1.14.1",
        "symfony/html-sanitizer": "^7.0 || ^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.15|^10.8|^11.0",
        "pestphp/pest": "^3.8|^4.3",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Capell\\KnowledgeBase\\": "src/",
            "Capell\\KnowledgeBase\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\KnowledgeBase\\Providers\\KnowledgeBaseServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true,
    "type": "library",
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/knowledge-base"
    }
}
