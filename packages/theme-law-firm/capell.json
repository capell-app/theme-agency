{
    "manifest-version": 3,
    "name": "capell-app/theme-law-firm",
    "slug": "theme-law-firm",
    "displayName": "Theme Law Firm",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Law Firm extends the default Capell frontend with a law firm visual direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for law firms, barristers' chambers.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\LawFirm",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\LawFirm\\LawFirmThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\LawFirm\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "law-firm"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-law-firm-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-law-firm", "theme-law-firm-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-law-firm"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-law-firm.package-health",
            "label": "Law Firm package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\LawFirm\\Health\\ThemeLawFirmHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for law firms, barristers' chambers.",
        "description": "Law Firm provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for Harlow & Finch LLP.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Law Firm marketplace card preview",
                "caption": "Law Firm premium theme card"
            },
            {
                "path": "docs/screenshots/law-firm-homepage.png",
                "alt": "Law Firm Homepage demo page screenshot",
                "caption": "Law Firm Homepage page"
            },
            {
                "path": "docs/screenshots/law-firm-directory.png",
                "alt": "Law Firm Directory demo page screenshot",
                "caption": "Law Firm Directory page"
            },
            {
                "path": "docs/screenshots/law-firm-detail.png",
                "alt": "Law Firm Detail demo page screenshot",
                "caption": "Law Firm Detail page"
            },
            {
                "path": "docs/screenshots/law-firm-contact.png",
                "alt": "Law Firm Contact demo page screenshot",
                "caption": "Law Firm Contact page"
            },
            {
                "path": "docs/screenshots/law-firm-empty.png",
                "alt": "Law Firm Empty State demo page screenshot",
                "caption": "Law Firm Empty State page"
            },
            {
                "path": "docs/screenshots/law-firm-not-found.png",
                "alt": "Law Firm 404 State demo page screenshot",
                "caption": "Law Firm 404 State page"
            },
            {
                "path": "docs/screenshots/law-firm-cta.png",
                "alt": "Law Firm Conversion CTA demo page screenshot",
                "caption": "Law Firm Conversion CTA page"
            },
            {
                "path": "docs/screenshots/law-firm-practice-areas.png",
                "alt": "Law Firm Practice Areas demo page screenshot",
                "caption": "Law Firm Practice Areas page"
            },
            {
                "path": "docs/screenshots/law-firm-attorneys.png",
                "alt": "Law Firm Attorneys demo page screenshot",
                "caption": "Law Firm Attorneys page"
            },
            {
                "path": "docs/screenshots/law-firm-consultation.png",
                "alt": "Law Firm Consultation demo page screenshot",
                "caption": "Law Firm Consultation page"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "law-firm"
}
