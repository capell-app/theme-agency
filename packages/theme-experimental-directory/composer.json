{
    "name": "capell-app/theme-experimental-directory",
    "description": "Experimental Directory is a first-party Capell theme for creative industry directories with pale neutral pages, tight grid rules, oversized project titles, compact metadata, status badges, featured projects, submissions, winners, collections, profiles, resources, and sponsor modules.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "capell-app/core": "^4.0 || 4.x-dev",
        "capell-app/frontend": "^4.0 || 4.x-dev"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Capell\\ThemeStudio\\ExperimentalDirectory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\ThemeStudio\\ExperimentalDirectory\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\ThemeStudio\\ExperimentalDirectory\\ExperimentalDirectoryThemeServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "homepage": "https://github.com/capell-app/theme-experimental-directory",
    "keywords": [
        "capell",
        "cms",
        "laravel",
        "theme"
    ],
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/theme-experimental-directory"
    }
}
