{
    "manifest-version": 3,
    "name": "capell-app/theme-manufacturing",
    "slug": "theme-manufacturing",
    "displayName": "Theme Manufacturing",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Manufacturing extends the default Capell frontend with a manufacturing visual direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for industrial manufacturers, smart factories.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\Manufacturing",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\Manufacturing\\ManufacturingThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\Manufacturing\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "manufacturing"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-manufacturing-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-manufacturing", "theme-manufacturing-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-manufacturing"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-manufacturing.package-health",
            "label": "Manufacturing package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\Manufacturing\\Health\\ThemeManufacturingHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for industrial manufacturers, smart factories.",
        "description": "Manufacturing provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for Forge Industries.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Manufacturing marketplace card preview",
                "caption": "Manufacturing premium theme card"
            },
            {
                "path": "docs/screenshots/manufacturing-homepage.png",
                "alt": "Manufacturing Homepage demo page screenshot",
                "caption": "Manufacturing Homepage page"
            },
            {
                "path": "docs/screenshots/manufacturing-directory.png",
                "alt": "Manufacturing Directory demo page screenshot",
                "caption": "Manufacturing Directory page"
            },
            {
                "path": "docs/screenshots/manufacturing-detail.png",
                "alt": "Manufacturing Detail demo page screenshot",
                "caption": "Manufacturing Detail page"
            },
            {
                "path": "docs/screenshots/manufacturing-contact.png",
                "alt": "Manufacturing Contact demo page screenshot",
                "caption": "Manufacturing Contact page"
            },
            {
                "path": "docs/screenshots/manufacturing-empty.png",
                "alt": "Manufacturing Empty State demo page screenshot",
                "caption": "Manufacturing Empty State page"
            },
            {
                "path": "docs/screenshots/manufacturing-not-found.png",
                "alt": "Manufacturing 404 State demo page screenshot",
                "caption": "Manufacturing 404 State page"
            },
            {
                "path": "docs/screenshots/manufacturing-cta.png",
                "alt": "Manufacturing Conversion CTA demo page screenshot",
                "caption": "Manufacturing Conversion CTA page"
            },
            {
                "path": "docs/screenshots/manufacturing-capabilities.png",
                "alt": "Manufacturing Capabilities demo page screenshot",
                "caption": "Manufacturing Capabilities page"
            },
            {
                "path": "docs/screenshots/manufacturing-case-studies.png",
                "alt": "Manufacturing Case Studies demo page screenshot",
                "caption": "Manufacturing Case Studies page"
            },
            {
                "path": "docs/screenshots/manufacturing-rfq.png",
                "alt": "Manufacturing RFQ demo page screenshot",
                "caption": "Manufacturing RFQ page"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "manufacturing"
}
