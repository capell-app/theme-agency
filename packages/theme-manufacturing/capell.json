{
    "manifest-version": 3,
    "name": "capell-app/theme-manufacturing",
    "slug": "theme-manufacturing",
    "displayName": "Theme Manufacturing",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Manufacturing extends the default Capell frontend with a manufacturing visual direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for industrial manufacturers, smart factories.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\Manufacturing",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\Manufacturing\\ManufacturingThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\Manufacturing\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "manufacturing"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-manufacturing-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-manufacturing", "theme-manufacturing-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-manufacturing"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-manufacturing.package-health",
            "label": "Manufacturing package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\Manufacturing\\Health\\ThemeManufacturingHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for industrial manufacturers, smart factories.",
        "description": "Manufacturing provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for Forge Industries.",
        "screenshots": [
            {
                "path": "docs/screenshots/manufacturing-homepage.png",
                "alt": "Manufacturing homepage preview",
                "caption": "Manufacturing Homepage"
            },
            {
                "path": "docs/screenshots/manufacturing-landing.png",
                "alt": "Manufacturing landing page preview",
                "caption": "Manufacturing Landing page"
            },
            {
                "path": "docs/screenshots/manufacturing-listing.png",
                "alt": "Manufacturing list page preview",
                "caption": "Manufacturing List page"
            },
            {
                "path": "docs/screenshots/manufacturing-search.png",
                "alt": "Manufacturing search results preview",
                "caption": "Manufacturing Search results"
            },
            {
                "path": "docs/screenshots/manufacturing-contact.png",
                "alt": "Manufacturing contact form preview",
                "caption": "Manufacturing Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "manufacturing"
}
