{
    "manifest-version": 3,
    "name": "capell-app/access-gate",
    "slug": "access-gate",
    "displayName": "Access Gate",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Gate any Capell page, download, or member area behind login, email approval, guest links, schedules, or paid checkout — with full request, grant, and audit management in the admin.",
    "product": {
        "group": "Capell Operations",
        "tier": "premium",
        "bundle": "operations"
    },
    "namespace": "Capell\\AccessGate",
    "surfaces": ["admin", "frontend", "console"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core"],
        "supports": [
            "capell-app/customer-portal",
            "capell-app/diagnostics",
            "capell-app/html-cache",
            "capell-app/payments",
            "capell-app/public-actions"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": ["Capell\\AccessGate\\Providers\\AccessGateServiceProvider"],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\AccessGate\\Manifest\\AccessAreaResourceContribution",
            "resourceClass": "Capell\\AccessGate\\Filament\\Resources\\AccessAreas\\AccessAreaResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\AccessGate\\Manifest\\RegistrationResourceContribution",
            "resourceClass": "Capell\\AccessGate\\Filament\\Resources\\Registrations\\RegistrationResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\AccessGate\\Manifest\\GrantResourceContribution",
            "resourceClass": "Capell\\AccessGate\\Filament\\Resources\\Grants\\GrantResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\AccessGate\\Manifest\\BrowserTokenResourceContribution",
            "resourceClass": "Capell\\AccessGate\\Filament\\Resources\\BrowserTokens\\BrowserTokenResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\AccessGate\\Manifest\\ClaimTokenResourceContribution",
            "resourceClass": "Capell\\AccessGate\\Filament\\Resources\\ClaimTokens\\ClaimTokenResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\AccessGate\\Manifest\\AccessGateEventResourceContribution",
            "resourceClass": "Capell\\AccessGate\\Filament\\Resources\\Events\\AccessGateEventResource"
        },
        {
            "type": "dashboard-widget",
            "class": "Capell\\AccessGate\\Manifest\\PendingAccessRequestsWidgetContribution",
            "widgetClass": "Capell\\AccessGate\\Filament\\Widgets\\PendingAccessRequestsWidget",
            "labelKey": "capell-access-gate::filament.widgets.pending_access_requests"
        },
        {
            "type": "model",
            "class": "Capell\\AccessGate\\Manifest\\AccessGateModelsContribution",
            "modelClasses": [
                "Capell\\AccessGate\\Models\\Area",
                "Capell\\AccessGate\\Models\\Registration",
                "Capell\\AccessGate\\Models\\Grant",
                "Capell\\AccessGate\\Models\\ClaimToken",
                "Capell\\AccessGate\\Models\\BrowserToken",
                "Capell\\AccessGate\\Models\\Event"
            ]
        },
        {
            "type": "route",
            "class": "Capell\\AccessGate\\Manifest\\AccessGateRoutesContribution",
            "routes": [
                "capell-access-gate.request",
                "capell-access-gate.request.store",
                "capell-access-gate.claim",
                "capell-access-gate.logout",
                "capell-access-gate.status"
            ]
        },
        {
            "type": "console-command",
            "class": "Capell\\AccessGate\\Manifest\\AccessGateConsoleCommandsContribution",
            "commands": [
                "capell:access-gate-install",
                "capell:access-gate-setup",
                "capell:access-gate-doctor"
            ],
            "commandClasses": [
                "Capell\\AccessGate\\Console\\Commands\\AccessGateInstallCommand",
                "Capell\\AccessGate\\Console\\Commands\\AccessGateSetupCommand",
                "Capell\\AccessGate\\Console\\Commands\\AccessGateDoctorCommand"
            ]
        },
        {
            "type": "health-check",
            "class": "Capell\\AccessGate\\Manifest\\AccessGateHealthContribution",
            "checkClass": "Capell\\AccessGate\\Health\\AccessGateHealthCheck"
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": [
            "access_gate_areas",
            "access_gate_registrations",
            "access_gate_grants",
            "access_gate_claim_tokens",
            "access_gate_browser_tokens",
            "access_gate_events"
        ]
    },
    "commands": {
        "install": "capell:access-gate-install",
        "setup": "capell:access-gate-setup",
        "demo": null,
        "doctor": "capell:access-gate-doctor"
    },
    "actions": {
        "install": "Capell\\AccessGate\\Actions\\InstallAccessGatePackageAction",
        "paidAccessCheckout": "Capell\\AccessGate\\Actions\\CreatePaidAccessCheckoutForRegistrationAction",
        "paidAccessCheckoutContribution": "Capell\\AccessGate\\Manifest\\PaidAccessCheckoutCreationContribution"
    },
    "settings": [],
    "permissions": [
        "View:Area",
        "Create:Area",
        "Update:Area",
        "Delete:Area",
        "View:Registration",
        "Update:Registration",
        "View:Grant",
        "Update:Grant",
        "View:BrowserToken",
        "Update:BrowserToken",
        "View:ClaimToken",
        "View:Event"
    ],
    "capabilities": [
        "access-gating",
        "registration-approval",
        "claim-token-management",
        "paid-gated-access-checkout-creation",
        "paid-gated-access-fulfillment",
        "access-gate-customer-portal-gated-resource-feed"
    ],
    "security": {
        "riskTier": "sensitive",
        "publicSurface": {
            "routeNames": [
                "capell-access-gate.claim",
                "capell-access-gate.logout",
                "capell-access-gate.request",
                "capell-access-gate.request.store",
                "capell-access-gate.status"
            ],
            "auth": "public",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": ["capell-access-gate.claim"],
            "webhookRoutes": [],
            "throttledRoutes": [
                "capell-access-gate.claim",
                "capell-access-gate.logout",
                "capell-access-gate.request.store",
                "capell-access-gate.status"
            ]
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "View:Area",
                "Create:Area",
                "Update:Area",
                "Delete:Area",
                "View:Registration",
                "Update:Registration",
                "View:Grant",
                "Update:Grant",
                "View:BrowserToken",
                "Update:BrowserToken",
                "View:ClaimToken",
                "View:Event"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": [],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "access-gate.package-health",
            "label": "Access Gate package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\AccessGate\\Health\\AccessGateHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Gate any Capell page, download, or member area behind login, email approval, guest links, schedules, or paid checkout — with full request, grant, and audit management in the admin.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Access Gate extension preview image",
                "caption": "Access Gate extension preview"
            },
            {
                "path": "docs/screenshots/access-areas-admin-index.png",
                "alt": "Access Gate access areas admin index showing protected area status and policies.",
                "caption": "Access areas admin index for reviewing protected areas, route keys, registration policy, and token policy."
            },
            {
                "path": "docs/screenshots/access-area-create-edit-form.png",
                "alt": "Access Gate access area form showing schedule, request, token, allowlist, and metadata settings.",
                "caption": "Access area create and edit form for configuring schedules, request behaviour, claim hosts, limits, and allowlists."
            },
            {
                "path": "docs/screenshots/registrations-admin-index.png",
                "alt": "Access Gate registrations admin index showing pending and approved access requests.",
                "caption": "Registrations admin index for triaging access requests with approve, reject, resend claim, expire, and grant actions."
            },
            {
                "path": "docs/screenshots/grants-admin-index.png",
                "alt": "Access Gate grants admin index showing active, expired, and revoked grants.",
                "caption": "Grants admin index for auditing active, expired, and revoked grants before they unlock protected content."
            },
            {
                "path": "docs/screenshots/claim-tokens-admin-index.png",
                "alt": "Access Gate claim tokens admin index showing issued, consumed, and expired approval links.",
                "caption": "Claim tokens admin index for support review of approval links, claim status, expiry, and related registrations."
            },
            {
                "path": "docs/screenshots/browser-tokens-admin-index.png",
                "alt": "Access Gate browser tokens admin index showing browser-bound access tokens and revoke state.",
                "caption": "Browser tokens admin index for reviewing device-bound access and revoking tokens after device loss or policy change."
            },
            {
                "path": "docs/screenshots/access-events-admin-index.png",
                "alt": "Access Gate access events admin index showing request, approval, claim, grant, revoke, and denied visit history.",
                "caption": "Access events admin index for investigating the history of requests, approvals, claims, grants, revokes, and denied visits."
            },
            {
                "path": "docs/screenshots/public-access-request-form.png",
                "alt": "Access Gate public access request form for an anonymous visitor requesting a protected area.",
                "caption": "Public access request form that lets visitors request access without exposing admin-only state or authoring metadata."
            },
            {
                "path": "docs/screenshots/public-gated-message.png",
                "alt": "Access Gate public message shown when an access link is expired or unavailable.",
                "caption": "Public access message for expired or unavailable links, keeping protected content and cached private HTML out of the response."
            },
            {
                "path": "docs/screenshots/public-request-cta.png",
                "alt": "Access Gate public request CTA component linking a visitor into the access request flow.",
                "caption": "Public request CTA component for routing visitors from protected pages or teaser content into the correct request flow."
            }
        ],
        "categories": ["admin", "operations"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
