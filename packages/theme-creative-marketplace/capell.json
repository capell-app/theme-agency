{
    "manifest-version": 3,
    "name": "capell-app/theme-creative-marketplace",
    "slug": "theme-creative-marketplace",
    "displayName": "Theme Creative Marketplace",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Creative Marketplace extends the default Capell frontend with a bright creative marketplace direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for service heroes, category chips, shot grids, profile avatars, service categories, briefs, agencies, pricing snippets, saves, likes, views, availability, search, and hiring CTAs.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\CreativeMarketplace",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\CreativeMarketplace\\CreativeMarketplaceThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\CreativeMarketplace\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "creative-marketplace"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-creative-marketplace-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-creative-marketplace",
        "theme-creative-marketplace-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-creative-marketplace"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-creative-marketplace.package-health",
            "label": "Creative Marketplace package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\CreativeMarketplace\\Health\\ThemeCreativeMarketplaceHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A bright Capell theme for creative marketplaces, designer hiring, visual work browsing, services, briefs, agencies, and profile availability.",
        "description": "Creative Marketplace provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for web design, product design, motion, branding, UI, illustration, agencies, and creative service marketplaces that need social signals, profile avatars, saves, likes, views, service categories, availability, pricing snippets, briefs, agencies, and hiring paths.",
        "screenshots": [
            {
                "path": "docs/screenshots/creative-marketplace-homepage.png",
                "alt": "Creative Marketplace homepage preview",
                "caption": "Creative Marketplace Homepage"
            },
            {
                "path": "docs/screenshots/creative-marketplace-landing.png",
                "alt": "Creative Marketplace landing page preview",
                "caption": "Creative Marketplace Landing page"
            },
            {
                "path": "docs/screenshots/creative-marketplace-listing.png",
                "alt": "Creative Marketplace list page preview",
                "caption": "Creative Marketplace List page"
            },
            {
                "path": "docs/screenshots/creative-marketplace-search.png",
                "alt": "Creative Marketplace search results preview",
                "caption": "Creative Marketplace Search results"
            },
            {
                "path": "docs/screenshots/creative-marketplace-contact.png",
                "alt": "Creative Marketplace contact form preview",
                "caption": "Creative Marketplace Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "creative-marketplace"
}
