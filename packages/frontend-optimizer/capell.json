{
    "manifest-version": 3,
    "name": "capell-app/frontend-optimizer",
    "slug": "frontend-optimizer",
    "displayName": "Frontend Optimizer",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Frontend Optimizer speeds up your public Capell site by inlining the exact above-the-fold CSS each layout needs and deferring everything else, so visitors see styled content sooner and your Core Web Vitals improve. Unlike source-scanning tools, it generates critical CSS from your pages as a real browser renders them — Layout Builder content, theme markup, render hooks, and responsive styles all included — across mobile and desktop viewports. Generation runs on your queue, never in the public response, and falls back safely to standard stylesheet delivery until critical CSS exists. Per-layout render profiles mean equivalent pages reuse one optimized result, and page types you don't want to optimize can opt out with a single toggle.",
    "product": {
        "group": "Capell Foundation",
        "tier": "premium",
        "bundle": "foundation"
    },
    "namespace": "Capell\\FrontendOptimizer",
    "surfaces": ["admin", "console", "frontend"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend"
        ],
        "supports": ["capell-app/media-library"],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\FrontendOptimizer\\Providers\\FrontendOptimizerServiceProvider"
        ],
        "admin": [
            "Capell\\FrontendOptimizer\\Providers\\FrontendOptimizerServiceProvider"
        ],
        "frontend": []
    },
    "contributes": [
        {
            "type": "configurator",
            "class": "Capell\\FrontendOptimizer\\Manifest\\FrontendOptimizerConfiguratorContribution",
            "configuratorClass": "Capell\\FrontendOptimizer\\Filament\\Configurators\\Types\\FrontendOptimizerPageTypeConfigurator",
            "group": "blueprint"
        },
        {
            "type": "model",
            "class": "Capell\\FrontendOptimizer\\Manifest\\FrontendOptimizerModelsContribution",
            "modelClasses": [
                "Capell\\FrontendOptimizer\\Models\\FrontendRenderProfile",
                "Capell\\FrontendOptimizer\\Models\\FrontendOptimizationRun"
            ]
        },
        {
            "type": "console-command",
            "class": "Capell\\FrontendOptimizer\\Manifest\\FrontendOptimizerConsoleCommandsContribution",
            "commands": ["capell:frontend-optimizer:prune-profiles"],
            "commandClasses": [
                "Capell\\FrontendOptimizer\\Console\\Commands\\PruneRenderProfilesCommand"
            ]
        },
        {
            "type": "setting",
            "class": "Capell\\FrontendOptimizer\\Manifest\\FrontendOptimizerSettingsContribution",
            "settingsClass": "Capell\\FrontendOptimizer\\Settings\\FrontendOptimizerSettings",
            "settingsGroup": "frontend_optimizer"
        },
        {
            "type": "health-check",
            "class": "Capell\\FrontendOptimizer\\Manifest\\FrontendOptimizerHealthContribution",
            "checkClass": "Capell\\FrontendOptimizer\\Health\\FrontendOptimizerHealthCheck"
        }
    ],
    "database": {
        "migrations": true,
        "settings": true,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null,
        "prune": "capell:frontend-optimizer:prune-profiles"
    },
    "settings": [
        "Capell\\FrontendOptimizer\\Settings\\FrontendOptimizerSettings"
    ],
    "permissions": [],
    "capabilities": [
        "frontend-optimizer",
        "frontend-optimizer-frontend",
        "frontend-optimizer-console",
        "frontend-optimizer-images",
        "frontend-assets",
        "cache-blocking"
    ],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": ["frontend_render_profiles.hash"],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "panel-auth",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["frontend-optimizer"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\FrontendOptimizer\\Models\\FrontendRenderProfile",
                    "events": ["updated"]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "frontend-optimizer.package-health",
            "label": "Frontend Optimizer package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\FrontendOptimizer\\Health\\FrontendOptimizerHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Faster first paint for public Capell pages: automatic above-the-fold critical CSS extracted from your real rendered pages, plus smart deferring of non-critical CSS and JavaScript.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Frontend Optimizer extension preview image",
                "caption": "Frontend Optimizer extension preview"
            }
        ],
        "categories": ["foundation", "frontend"]
    },
    "scopes": ["frontend"],
    "contributionTraceability": {
        "deferredContributions": []
    }
}
