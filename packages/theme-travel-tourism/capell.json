{
    "manifest-version": 3,
    "name": "capell-app/theme-travel-tourism",
    "slug": "theme-travel-tourism",
    "displayName": "Theme Travel & Tourism",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Travel & Tourism extends the default Capell frontend with a travel & tourism visual direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for tour operators, travel agencies.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\TravelTourism",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\TravelTourism\\TravelTourismThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\TravelTourism\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "travel-tourism"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-travel-tourism-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-travel-tourism", "theme-travel-tourism-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-travel-tourism"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-travel-tourism.package-health",
            "label": "Travel & Tourism package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\TravelTourism\\Health\\ThemeTravelTourismHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for tour operators, travel agencies.",
        "description": "Travel & Tourism provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for Meridian Travel.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Travel Tourism marketplace card preview",
                "caption": "Travel Tourism premium theme card"
            },
            {
                "path": "docs/screenshots/travel-tourism-homepage.png",
                "alt": "Travel Tourism Homepage demo page screenshot",
                "caption": "Travel Tourism Homepage page"
            },
            {
                "path": "docs/screenshots/travel-tourism-directory.png",
                "alt": "Travel Tourism Directory demo page screenshot",
                "caption": "Travel Tourism Directory page"
            },
            {
                "path": "docs/screenshots/travel-tourism-detail.png",
                "alt": "Travel Tourism Detail demo page screenshot",
                "caption": "Travel Tourism Detail page"
            },
            {
                "path": "docs/screenshots/travel-tourism-contact.png",
                "alt": "Travel Tourism Contact demo page screenshot",
                "caption": "Travel Tourism Contact page"
            },
            {
                "path": "docs/screenshots/travel-tourism-empty.png",
                "alt": "Travel Tourism Empty State demo page screenshot",
                "caption": "Travel Tourism Empty State page"
            },
            {
                "path": "docs/screenshots/travel-tourism-not-found.png",
                "alt": "Travel Tourism 404 State demo page screenshot",
                "caption": "Travel Tourism 404 State page"
            },
            {
                "path": "docs/screenshots/travel-tourism-cta.png",
                "alt": "Travel Tourism Conversion CTA demo page screenshot",
                "caption": "Travel Tourism Conversion CTA page"
            },
            {
                "path": "docs/screenshots/travel-tourism-destinations.png",
                "alt": "Travel Tourism Destinations demo page screenshot",
                "caption": "Travel Tourism Destinations page"
            },
            {
                "path": "docs/screenshots/travel-tourism-itineraries.png",
                "alt": "Travel Tourism Itineraries demo page screenshot",
                "caption": "Travel Tourism Itineraries page"
            },
            {
                "path": "docs/screenshots/travel-tourism-enquiry.png",
                "alt": "Travel Tourism Travel Enquiry demo page screenshot",
                "caption": "Travel Tourism Travel Enquiry page"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "travel-tourism"
}
