{
    "manifest-version": 3,
    "name": "capell-app/theme-construction-trades",
    "slug": "theme-construction-trades",
    "displayName": "Theme Construction Trades",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Construction Trades extends the default Capell frontend with a construction trades visual direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for builders & contractors, construction firms.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\ConstructionTrades",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\ConstructionTrades\\ConstructionTradesThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\ConstructionTrades\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "construction-trades"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-construction-trades-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-construction-trades",
        "theme-construction-trades-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-construction-trades"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-construction-trades.package-health",
            "label": "Construction Trades package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\ConstructionTrades\\Health\\ThemeConstructionTradesHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for builders & contractors, construction firms.",
        "description": "Construction Trades provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for Granite Build Co.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Construction Trades marketplace card preview",
                "caption": "Construction Trades premium theme card"
            },
            {
                "path": "docs/screenshots/construction-trades-homepage.png",
                "alt": "Construction Trades Homepage demo page screenshot",
                "caption": "Construction Trades Homepage"
            },
            {
                "path": "docs/screenshots/construction-trades-directory.png",
                "alt": "Construction Trades Directory demo page screenshot",
                "caption": "Construction Trades Directory page"
            },
            {
                "path": "docs/screenshots/construction-trades-detail.png",
                "alt": "Construction Trades Detail demo page screenshot",
                "caption": "Construction Trades Detail page"
            },
            {
                "path": "docs/screenshots/construction-trades-contact.png",
                "alt": "Construction Trades Contact demo page screenshot",
                "caption": "Construction Trades Contact page"
            },
            {
                "path": "docs/screenshots/construction-trades-empty.png",
                "alt": "Construction Trades Empty State demo page screenshot",
                "caption": "Construction Trades Empty State page"
            },
            {
                "path": "docs/screenshots/construction-trades-not-found.png",
                "alt": "Construction Trades 404 State demo page screenshot",
                "caption": "Construction Trades 404 State page"
            },
            {
                "path": "docs/screenshots/construction-trades-cta.png",
                "alt": "Construction Trades Conversion CTA demo page screenshot",
                "caption": "Construction Trades Conversion CTA page"
            },
            {
                "path": "docs/screenshots/construction-trades-services.png",
                "alt": "Construction Trades Services demo page screenshot",
                "caption": "Construction Trades Services page"
            },
            {
                "path": "docs/screenshots/construction-trades-projects.png",
                "alt": "Construction Trades Projects demo page screenshot",
                "caption": "Construction Trades Projects page"
            },
            {
                "path": "docs/screenshots/construction-trades-quote.png",
                "alt": "Construction Trades Quote Request demo page screenshot",
                "caption": "Construction Trades Quote Request page"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "construction-trades"
}
