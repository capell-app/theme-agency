{
    "name": "capell-app/social-feeds",
    "description": "Premium social feed widgets for Capell with cached rendering, extensible providers, and configurable list, slideshow, carousel, and paginated layouts.",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Capell\\SocialFeeds\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\SocialFeeds\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\SocialFeeds\\Providers\\SocialFeedsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "require": {
        "php": "^8.4",
        "capell-app/admin": "^4.0 || 4.x-dev",
        "capell-app/block-library": "^4.0 || 4.x-dev",
        "capell-app/core": "^4.0 || 4.x-dev",
        "laravel/framework": "^11.45.3|^12.41.1|^13.0",
        "lorisleiva/laravel-actions": "^2.8",
        "spatie/laravel-package-tools": "^1.14.1"
    },
    "require-dev": {
        "orchestra/testbench": "^9.15|^10.8|^11.0",
        "pestphp/pest": "^3.8|^4.3",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "keywords": [
        "capell",
        "cms",
        "social-feeds",
        "layout_widgets"
    ],
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/social-feeds"
    }
}
