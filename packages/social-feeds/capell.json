{
    "manifest-version": 3,
    "name": "capell-app/social-feeds",
    "slug": "social-feeds",
    "displayName": "Social Feeds",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Premium social feed widgets for Capell with cached public rendering, provider extensibility, and configurable list, slideshow, carousel, and paginated layouts.",
    "product": {
        "tier": "premium",
        "bundle": "growth",
        "group": "Capell Growth"
    },
    "namespace": "Capell\\SocialFeeds",
    "surfaces": ["admin", "frontend", "console"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/block-library",
            "capell-app/core"
        ],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\SocialFeeds\\Providers\\SocialFeedsServiceProvider"
        ],
        "admin": ["Capell\\SocialFeeds\\Providers\\AdminServiceProvider"],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\SocialFeeds\\Manifest\\SocialFeedConnectionResourceContribution",
            "resourceClass": "Capell\\SocialFeeds\\Filament\\Resources\\SocialFeedConnections\\SocialFeedConnectionResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\SocialFeeds\\Manifest\\SocialFeedItemResourceContribution",
            "resourceClass": "Capell\\SocialFeeds\\Filament\\Resources\\SocialFeedItems\\SocialFeedItemResource"
        },
        {
            "type": "frontend-component",
            "class": "Capell\\SocialFeeds\\Manifest\\SocialFeedWidgetContribution",
            "blockKey": "social-feed",
            "definitionProviderClass": "Capell\\SocialFeeds\\Blocks\\SocialFeedBlockDefinitionProvider",
            "rendererClass": "Capell\\SocialFeeds\\Blocks\\SocialFeedBlockRenderer",
            "surface": "frontend"
        },
        {
            "type": "model",
            "class": "Capell\\SocialFeeds\\Manifest\\SocialFeedConnectionModelContribution",
            "modelClass": "Capell\\SocialFeeds\\Models\\SocialFeedConnection"
        },
        {
            "type": "model",
            "class": "Capell\\SocialFeeds\\Manifest\\SocialFeedItemModelContribution",
            "modelClass": "Capell\\SocialFeeds\\Models\\SocialFeedItem"
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\SocialFeeds\\Manifest\\SocialFeedsSyncScheduleContribution",
            "command": "capell:social-feeds:sync --all",
            "name": "capell-social-feeds:sync",
            "frequencyConfig": "capell-social-feeds.sync_schedule_enabled",
            "defaultFrequency": "hourly",
            "enabledWhen": "capell-social-feeds.sync_schedule_enabled=true"
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": [
            "social_feed_connections",
            "social_feed_items",
            "social_feed_oauth_states"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null,
        "sync": "capell:social-feeds:sync"
    },
    "actions": {
        "fetchRenderData": "Capell\\SocialFeeds\\Actions\\FetchSocialFeedRenderDataAction",
        "syncConnection": "Capell\\SocialFeeds\\Actions\\SyncSocialFeedConnectionAction",
        "upsertItems": "Capell\\SocialFeeds\\Actions\\UpsertSocialFeedItemsAction"
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "social-feeds",
        "social-feeds-admin",
        "social-feeds-console",
        "social-feeds-frontend",
        "social-feed-provider-registry",
        "social-feed-cached-rendering",
        "social-feed-stale-sync-health",
        "social-feed-render-budget"
    ],
    "security": {
        "riskTier": "sensitive",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [
                "Capell\\SocialFeeds\\Models\\SocialFeedConnection::$credentials"
            ],
            "hashedTokenFields": [],
            "redactedOutputClasses": [
                "Capell\\SocialFeeds\\Actions\\RedactSocialFeedSyncErrorAction",
                "Capell\\SocialFeeds\\Actions\\SyncSocialFeedConnectionAction"
            ],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": true,
            "requiresSecretRedaction": true,
            "clients": [
                "Capell\\SocialFeeds\\Providers\\Drivers\\RssFeedProvider"
            ]
        },
        "adminSurface": {
            "authorization": "panel-auth",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["social-feeds"],
        "cacheSafety": {
            "cacheable": true,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\SocialFeeds\\Models\\SocialFeedConnection",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                },
                {
                    "model": "Capell\\SocialFeeds\\Models\\SocialFeedItem",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "social-feeds.storage-and-widget",
            "label": "Social Feeds storage tables and frontend widget renderer are available",
            "class": "Capell\\SocialFeeds\\Health\\SocialFeedsHealthCheck",
            "severity": "warning",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Place cached RSS-compatible social feeds in Capell pages with a provider registry and clean public rendering.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.svg",
                "alt": "Social Feeds extension marketplace card.",
                "caption": "Social Feeds extension preview for Marketplace cards."
            },
            {
                "path": "docs/screenshots/social-feed-carousel-widget.png",
                "alt": "Social Feeds public carousel widget rendered with seeded cached RSS posts.",
                "caption": "Route-backed carousel widget with cached feed items"
            },
            {
                "path": "docs/screenshots/social-feed-rss-sync.png",
                "alt": "Social Feeds RSS sync state showing cached feed item records ready for public rendering.",
                "caption": "Cached RSS sync state from seeded package records"
            },
            {
                "path": "docs/screenshots/social-feed-provider-registry.png",
                "alt": "Social Feeds provider registry diagnostics showing RSS TikTok YouTube Bluesky and custom providers.",
                "caption": "Provider registry extension surface"
            }
        ],
        "categories": ["admin", "console", "frontend", "growth"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
