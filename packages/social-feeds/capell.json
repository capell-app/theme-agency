{
    "manifest-version": 3,
    "name": "capell-app/social-feeds",
    "slug": "social-feeds",
    "displayName": "Social Feeds",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Premium social feed widgets for Capell with cached public rendering, provider extensibility, and configurable list, slideshow, carousel, and paginated layouts.",
    "product": {
        "tier": "premium",
        "bundle": "growth",
        "group": "Capell Growth"
    },
    "namespace": "Capell\\SocialFeeds",
    "surfaces": ["admin", "frontend"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/block-library",
            "capell-app/core"
        ],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\SocialFeeds\\Providers\\SocialFeedsServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "frontend-component",
            "class": "Capell\\SocialFeeds\\Manifest\\SocialFeedWidgetContribution",
            "blockKey": "social-feed",
            "definitionProviderClass": "Capell\\SocialFeeds\\Blocks\\SocialFeedBlockDefinitionProvider",
            "rendererClass": "Capell\\SocialFeeds\\Blocks\\SocialFeedBlockRenderer",
            "surface": "frontend"
        },
        {
            "type": "model",
            "class": "Capell\\SocialFeeds\\Manifest\\SocialFeedConnectionModelContribution",
            "modelClass": "Capell\\SocialFeeds\\Models\\SocialFeedConnection"
        },
        {
            "type": "model",
            "class": "Capell\\SocialFeeds\\Manifest\\SocialFeedItemModelContribution",
            "modelClass": "Capell\\SocialFeeds\\Models\\SocialFeedItem"
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": [
            "social_feed_connections",
            "social_feed_items",
            "social_feed_oauth_states"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "actions": {
        "fetchRenderData": "Capell\\SocialFeeds\\Actions\\FetchSocialFeedRenderDataAction",
        "syncConnection": "Capell\\SocialFeeds\\Actions\\SyncSocialFeedConnectionAction",
        "upsertItems": "Capell\\SocialFeeds\\Actions\\UpsertSocialFeedItemsAction"
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "social-feeds",
        "social-feeds-admin",
        "social-feeds-frontend",
        "social-feed-provider-registry",
        "social-feed-cached-rendering"
    ],
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["social-feeds"],
        "cacheSafety": {
            "cacheable": true,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\SocialFeeds\\Models\\SocialFeedConnection",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                },
                {
                    "model": "Capell\\SocialFeeds\\Models\\SocialFeedItem",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Place branded, cached social feeds anywhere in Capell with RSS, TikTok, YouTube, Bluesky, and custom provider support.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.svg",
                "alt": "Social Feeds extension card showing cached social posts in a branded carousel.",
                "caption": "Premium social feed widget preview"
            },
            {
                "path": "docs/assets/marketplace/social-feed-carousel-widget.svg",
                "alt": "Social Feeds carousel widget with provider badges captions and media cards.",
                "caption": "Carousel widget with rich display controls"
            },
            {
                "path": "docs/assets/marketplace/social-feed-rss-sync.svg",
                "alt": "RSS sync pipeline showing provider fetch cached feed items and public rendering.",
                "caption": "Cached RSS sync and public-safe rendering"
            },
            {
                "path": "docs/assets/marketplace/social-feed-provider-registry.svg",
                "alt": "Provider registry diagram showing RSS TikTok YouTube Bluesky and custom providers.",
                "caption": "Extendable provider registry"
            }
        ],
        "categories": ["admin", "frontend", "growth"]
    },
    "contributionTraceability": {
        "deferredContributions": [
            "admin-resource",
            "frontend-component",
            "settings"
        ]
    }
}
