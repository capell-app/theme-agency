{
    "manifest-version": 3,
    "name": "capell-app/password-policy",
    "slug": "password-policy",
    "displayName": "Password Policy",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Enforce admin password expiry, forced resets, reuse history, and breach (HIBP) checks across your Capell panels — configured from one settings screen, no code.",
    "product": {
        "group": "Capell Operations",
        "tier": "premium",
        "bundle": "operations"
    },
    "namespace": "Capell\\PasswordPolicy",
    "surfaces": ["admin", "console"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core"],
        "supports": [
            "capell-app/access-gate",
            "capell-app/diagnostics",
            "capell-app/login-audit",
            "capell-app/privacy-center"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [
            "Capell\\PasswordPolicy\\Providers\\PasswordPolicyServiceProvider"
        ],
        "runtime": [],
        "admin": [
            "Capell\\PasswordPolicy\\Providers\\PasswordPolicyServiceProvider"
        ],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\PasswordPolicy\\Manifest\\PasswordPolicyAdminPagesContribution",
            "pageClasses": [
                "Capell\\PasswordPolicy\\Filament\\Pages\\PasswordPolicySettingsPage",
                "Capell\\PasswordPolicy\\Filament\\Pages\\ForcedPasswordChangePage"
            ],
            "extensionManagementSurface": {
                "settingsGroup": "password_policy",
                "label": "capell-password-policy::settings.title"
            }
        },
        {
            "type": "admin-action-extender",
            "class": "Capell\\PasswordPolicy\\Manifest\\PasswordPolicyAdminExtendersContribution",
            "extenderClasses": [
                "Capell\\PasswordPolicy\\Filament\\Extenders\\PasswordPolicyPanelExtender",
                "Capell\\PasswordPolicy\\Filament\\Extenders\\PasswordPolicyUserFormExtender",
                "Capell\\PasswordPolicy\\Filament\\Extenders\\PasswordPolicyUserTableExtender"
            ],
            "tags": [
                "capell.admin.panel_extenders",
                "capell.admin.user-form-extender",
                "capell.admin.user_table_extenders"
            ]
        },
        {
            "type": "setting",
            "class": "Capell\\PasswordPolicy\\Manifest\\PasswordPolicySettingsContribution",
            "settingsClass": "Capell\\PasswordPolicy\\Settings\\PasswordPolicySettings",
            "settingsGroup": "password_policy",
            "settingsSchema": "Capell\\PasswordPolicy\\Filament\\Settings\\PasswordPolicySettingsSchema"
        },
        {
            "type": "console-command",
            "class": "Capell\\PasswordPolicy\\Manifest\\PasswordPolicyConsoleCommandsContribution",
            "commands": [
                "capell:password-policy:expire-stale",
                "capell:password-policy:doctor",
                "capell:password-policy:prune-history",
                "capell:password-policy:require-change",
                "capell:password-policy:send-expiry-warnings"
            ],
            "commandClasses": [
                "Capell\\PasswordPolicy\\Console\\Commands\\ExpireStalePasswordsCommand",
                "Capell\\PasswordPolicy\\Console\\Commands\\PasswordPolicyDoctorCommand",
                "Capell\\PasswordPolicy\\Console\\Commands\\PrunePasswordHistoryCommand",
                "Capell\\PasswordPolicy\\Console\\Commands\\RequirePasswordChangeCommand",
                "Capell\\PasswordPolicy\\Console\\Commands\\SendExpiryWarningsCommand"
            ]
        },
        {
            "type": "health-check",
            "class": "Capell\\PasswordPolicy\\Manifest\\PasswordPolicyHealthContribution",
            "checkClass": "Capell\\PasswordPolicy\\Health\\PasswordPolicyHealthCheck"
        }
    ],
    "database": {
        "migrations": true,
        "settings": true,
        "requiredTables": ["password_policy_password_histories"],
        "requiredUserColumns": ["password_changed_at", "must_change_password"]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": "capell:password-policy:doctor",
        "expireStale": "capell:password-policy:expire-stale",
        "pruneHistory": "capell:password-policy:prune-history",
        "requireChange": "capell:password-policy:require-change",
        "sendExpiryWarnings": "capell:password-policy:send-expiry-warnings"
    },
    "settings": ["Capell\\PasswordPolicy\\Settings\\PasswordPolicySettings"],
    "permissions": [],
    "capabilities": [
        "password-policy",
        "password-policy-admin",
        "password-policy-console"
    ],
    "security": {
        "riskTier": "sensitive",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": [
                "password_policy_password_histories.password: Reviewed package field; not stored as a reusable secret by this package contract."
            ]
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "panel-auth",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": [],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "password-policy.package-health",
            "label": "Password Policy package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\PasswordPolicy\\Health\\PasswordPolicyHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Enforce admin password expiry, forced resets, reuse history, and breach (HIBP) checks across your Capell panels — configured from one settings screen, no code.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Password Policy extension preview image",
                "caption": "Password Policy extension preview"
            },
            {
                "path": "docs/screenshots/password-policy-settings.png",
                "alt": "Password Policy settings page with expiry, forced-change, complexity, compromised-password, and reuse controls",
                "caption": "Configure password expiry, complexity, breach checks, and reuse policy from one admin page"
            },
            {
                "path": "docs/screenshots/password-policy-settings-dark.png",
                "alt": "Password Policy settings page in dark mode",
                "caption": "Password Policy settings in dark mode"
            },
            {
                "path": "docs/screenshots/forced-password-change.png",
                "alt": "Forced password change form for flagged administrators",
                "caption": "Require flagged administrators to change their password before continuing"
            },
            {
                "path": "docs/screenshots/forced-password-change-dark.png",
                "alt": "Forced password change form in dark mode",
                "caption": "Forced password-change flow in dark mode"
            },
            {
                "path": "docs/screenshots/user-password-policy-columns.png",
                "alt": "Users table with Password Policy status column",
                "caption": "Review password policy state directly from the Users table"
            },
            {
                "path": "docs/screenshots/user-password-policy-columns-dark.png",
                "alt": "Users table Password Policy status column in dark mode",
                "caption": "Users table password policy status in dark mode"
            }
        ],
        "categories": ["admin", "operations"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
