{
    "name": "capell-app/inertia-vue-adapter",
    "description": "Vue 3 client adapter for Capell Inertia.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "capell-app/core": "^4.0 || 4.x-dev",
        "capell-app/inertia": "^4.0 || 4.x-dev",
        "spatie/laravel-package-tools": "^1.14.1"
    },
    "autoload": {
        "psr-4": {
            "Capell\\InertiaVueAdapter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\InertiaVueAdapter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\InertiaVueAdapter\\Providers\\InertiaVueAdapterServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true,
    "homepage": "https://github.com/capell-app/inertia-vue-adapter",
    "keywords": [
        "capell",
        "inertia",
        "vue"
    ]
}
