{
    "name": "capell-app/agent-bridge",
    "description": "Scoped MCP access for AI agents to read Capell knowledge, preview site operations, confirm execution, and audit every run.",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Capell\\AgentBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\AgentBridge\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\AgentBridge\\Providers\\AgentBridgeServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.3",
        "capell-app/admin": "^4.0 || 4.x-dev",
        "capell-app/core": "^4.0 || 4.x-dev",
        "laravel/framework": "^11.45.3|^12.41.1|^13.0",
        "laravel/mcp": "^0.6|^0.7",
        "lorisleiva/laravel-actions": "^2.8",
        "spatie/laravel-data": "^4.5",
        "spatie/laravel-package-tools": "^1.14.1"
    },
    "require-dev": {
        "orchestra/testbench": "^9.15|^10.8|^11.0",
        "pestphp/pest": "^3.8|^4.3",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan": "^2.1",
        "laravel/pint": "^1.25"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "lint": "pint",
        "test": "pest --colors=always",
        "analyze": "phpstan analyse --memory-limit=-1"
    },
    "homepage": "https://github.com/capell-app/agent-bridge",
    "keywords": [
        "capell",
        "cms",
        "laravel",
        "agents",
        "mcp",
        "laravel-mcp",
        "model-context-protocol",
        "preview-confirm",
        "audit-log",
        "cms-automation",
        "scoped-access"
    ],
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/agent-bridge"
    }
}
