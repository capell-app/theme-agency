{
    "manifest-version": 3,
    "name": "capell-app/agent-bridge",
    "slug": "agent-bridge",
    "displayName": "Agent Bridge",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Connect AI agents and MCP clients to Capell with read-only package knowledge, scoped site capabilities, preview-then-confirm execution, and audited operations.",
    "product": {
        "group": "Capell Operations",
        "tier": "premium",
        "bundle": "operations"
    },
    "namespace": "Capell\\AgentBridge",
    "surfaces": ["admin", "frontend"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\AgentBridge\\Providers\\AgentBridgeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [],
    "database": {
        "migrations": true,
        "settings": true,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "settings": ["Capell\\AgentBridge\\Settings\\AgentBridgeSettings"],
    "permissions": ["agent-bridge.manage-tokens", "agent-bridge.view-audit"],
    "capabilities": ["agent-bridge", "agent-bridge-admin"],
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": [],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "agent-bridge.package-health",
            "label": "Agent Bridge package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\AgentBridge\\Health\\AgentBridgeHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Let AI agents safely read and operate your Capell site through scoped tokens, preview-then-confirm guardrails, and a full audit trail.",
        "screenshots": [
            {
                "path": "docs/screenshots/agent-bridge-prompt-builder-page.png",
                "alt": "Agent Bridge prompt builder page showing package context, scopes, and operator instructions.",
                "caption": "Build scoped prompts for external AI agents using installed Capell package context."
            },
            {
                "path": "docs/screenshots/agent-bridge-prompt-builder-page-dark.png",
                "alt": "Agent Bridge prompt builder page in dark mode with package context and scoped instructions.",
                "caption": "Build scoped prompts in dark mode while keeping agent instructions tied to installed package context."
            }
        ],
        "categories": ["admin", "operations"]
    },
    "contributionTraceability": {
        "deferredContributions": [
            "admin-page",
            "agent-capability",
            "migration",
            "route"
        ]
    }
}
