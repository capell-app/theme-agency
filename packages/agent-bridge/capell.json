{
    "manifest-version": 3,
    "name": "capell-app/agent-bridge",
    "slug": "agent-bridge",
    "displayName": "Agent Bridge",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Connect AI agents and MCP clients to Capell with read-only package knowledge, scoped site capabilities, preview-then-confirm execution, and audited operations.",
    "product": {
        "group": "Capell Operations",
        "tier": "premium",
        "bundle": "operations"
    },
    "namespace": "Capell\\AgentBridge",
    "surfaces": ["admin", "frontend"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\AgentBridge\\Providers\\AgentBridgeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\AgentBridge\\Manifest\\AgentBridgeAdminPageContribution",
            "pageClass": "Capell\\AgentBridge\\Filament\\Pages\\CapellAgentBridgePromptBuilderPage",
            "labelKey": "capell-agent-bridge::admin.prompt_builder_title"
        },
        {
            "type": "schema-extender",
            "class": "Capell\\AgentBridge\\Manifest\\AgentBridgeUserSchemaExtenderContribution",
            "extenderClass": "Capell\\AgentBridge\\Extenders\\AgentBridgeUserSchemaExtender",
            "tag": "capell-admin:user-schema-extenders"
        },
        {
            "type": "model",
            "class": "Capell\\AgentBridge\\Manifest\\AgentBridgeModelsContribution",
            "modelClasses": [
                "Capell\\AgentBridge\\Models\\CapellAgentBridgeToken",
                "Capell\\AgentBridge\\Models\\CapellAgentBridgeConfirmation",
                "Capell\\AgentBridge\\Models\\CapellAgentBridgeAuditEntry",
                "Capell\\AgentBridge\\Models\\CapellAgentBridgeSavedPrompt"
            ]
        },
        {
            "type": "route",
            "class": "Capell\\AgentBridge\\Manifest\\AgentBridgeRoutesContribution",
            "routes": [
                "capell-agent-bridge.home",
                "agent-bridge/capell/knowledge",
                "agent-bridge/capell"
            ],
            "defaultEnabledRoutes": ["agent-bridge/capell"]
        },
        {
            "type": "setting",
            "class": "Capell\\AgentBridge\\Manifest\\AgentBridgeSettingsContribution",
            "settingsClass": "Capell\\AgentBridge\\Settings\\AgentBridgeSettings",
            "settingsGroup": "agent_bridge",
            "settingsSchema": "Capell\\AgentBridge\\Filament\\Settings\\AgentBridgeSettingsSchema"
        },
        {
            "type": "migration",
            "class": "Capell\\AgentBridge\\Manifest\\AgentBridgeMigrationsContribution",
            "tables": [
                "capell_agent_bridge_tokens",
                "capell_agent_bridge_confirmations",
                "capell_agent_bridge_audit_entries",
                "capell_agent_bridge_saved_prompts"
            ]
        },
        {
            "type": "console-command",
            "class": "Capell\\AgentBridge\\Manifest\\AgentBridgeConsoleCommandsContribution",
            "commands": ["capell:agent-bridge-prune-audit"],
            "commandClasses": [
                "Capell\\AgentBridge\\Console\\Commands\\PruneAgentBridgeAuditEntriesCommand"
            ]
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\AgentBridge\\Manifest\\AgentBridgeAuditPruneScheduleContribution",
            "command": "capell:agent-bridge-prune-audit",
            "name": "capell-agent-bridge-prune-audit",
            "frequency": "daily",
            "retentionDaysConfig": "capell-agent-bridge.audit_retention_days"
        },
        {
            "type": "agent-capability",
            "class": "Capell\\AgentBridge\\Manifest\\AgentBridgeBuiltInCapabilitiesContribution",
            "capabilities": [
                "capell.cache.clear",
                "capell.pages.create_draft",
                "capell.pages.update_draft",
                "capell.pages.disable",
                "capell.pages.inspect_readiness"
            ],
            "requiresPreviewConfirmation": true
        },
        {
            "type": "health-check",
            "class": "Capell\\AgentBridge\\Health\\AgentBridgeHealthCheck"
        }
    ],
    "database": {
        "migrations": true,
        "settings": true,
        "requiredTables": [
            "capell_agent_bridge_tokens",
            "capell_agent_bridge_confirmations",
            "capell_agent_bridge_audit_entries",
            "capell_agent_bridge_saved_prompts"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null,
        "pruneAudit": "capell:agent-bridge-prune-audit"
    },
    "settings": ["Capell\\AgentBridge\\Settings\\AgentBridgeSettings"],
    "permissions": ["agent-bridge.manage-tokens", "agent-bridge.view-audit"],
    "capabilities": ["agent-bridge", "agent-bridge-admin"],
    "security": {
        "riskTier": "critical",
        "publicSurface": {
            "routeNames": ["capell-agent-bridge.home"],
            "auth": "public",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [
                "capell_agent_bridge_confirmations.payload_hash",
                "capell_agent_bridge_tokens.token_hash"
            ],
            "redactedOutputClasses": [],
            "plaintextJustifications": [
                "capell_agent_bridge_confirmations.token: Reviewed package field; not stored as a reusable secret by this package contract."
            ]
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "agent-bridge.manage-tokens",
                "agent-bridge.view-audit"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": [],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "agent-bridge.package-health",
            "label": "Agent Bridge package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\AgentBridge\\Health\\AgentBridgeHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Let AI agents safely read and operate your Capell site through scoped tokens, preview-then-confirm guardrails, and a full audit trail.",
        "screenshots": [
            {
                "path": "docs/screenshots/agent-bridge-prompt-builder-page.png",
                "alt": "Agent Bridge prompt builder page showing package context, scopes, and operator instructions.",
                "caption": "Build scoped prompts for external AI agents using installed Capell package context."
            },
            {
                "path": "docs/screenshots/agent-bridge-prompt-builder-page-dark.png",
                "alt": "Agent Bridge prompt builder page in dark mode with package context and scoped instructions.",
                "caption": "Build scoped prompts in dark mode while keeping agent instructions tied to installed package context."
            }
        ],
        "categories": ["admin", "operations"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
