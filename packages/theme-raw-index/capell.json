{
    "manifest-version": 3,
    "name": "capell-app/theme-raw-index",
    "slug": "theme-raw-index",
    "displayName": "Theme Raw Index",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Raw Index extends the default Capell frontend with a deliberately raw independent archive direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for monospace typography, plain grey surfaces, stark black and blue links, visible focus outlines, controlled irregular media, submission links, interview markers, archive dates, language notes, zine annotations, and fast public output.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\RawIndex",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\RawIndex\\RawIndexThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\RawIndex\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "raw-index"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-raw-index-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-raw-index", "theme-raw-index-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-raw-index"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-raw-index.package-health",
            "label": "Raw Index package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\RawIndex\\Health\\ThemeRawIndexHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A raw Capell theme for independent archives, experimental publishing, art, music, zines, and culture indexes with monospace type, stark links, rough metadata, and fast pages.",
        "description": "Raw Index provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for independent archives that need long irregular indexes, controlled media sizes, blue underlined links, submission routes, interview markers, sponsor and ad labels, archive dates, language notes, correction logs, zine annotations, visible focus outlines, and responsive single-column fallbacks.",
        "screenshots": [
            {
                "path": "docs/screenshots/raw-index-homepage.png",
                "alt": "Raw Index homepage preview",
                "caption": "Raw Index Homepage"
            },
            {
                "path": "docs/screenshots/raw-index-landing.png",
                "alt": "Raw Index landing page preview",
                "caption": "Raw Index Landing page"
            },
            {
                "path": "docs/screenshots/raw-index-listing.png",
                "alt": "Raw Index list page preview",
                "caption": "Raw Index Archive"
            },
            {
                "path": "docs/screenshots/raw-index-search.png",
                "alt": "Raw Index search results preview",
                "caption": "Raw Index Search results"
            },
            {
                "path": "docs/screenshots/raw-index-contact.png",
                "alt": "Raw Index contact form preview",
                "caption": "Raw Index Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "raw-index"
}
