{
    "manifest-version": 3,
    "name": "capell-app/events",
    "slug": "events",
    "displayName": "Events",
    "kind": "plugin",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Events turns Capell into a full event platform: editors create one event with an RRULE recurrence and the package materializes every occurrence, each with its own page, venue, schedule, and capacity. Visitors RSVP with automatic waitlisting and confirmation/reminder emails, while a public `.ics` feed lets them subscribe in Apple/Google/Outlook calendars. Every occurrence emits schema.org `Event` JSON-LD for rich results, and an admin calendar plus dashboard widget keep the programme visible. Built on `php-rrule` and `spatie/icalendar-generator`, with first-class hooks into Publishing Studio, Site Discovery, and the Customer Portal.",
    "product": {
        "group": "Capell Content",
        "tier": "premium",
        "bundle": "content-product"
    },
    "namespace": "Capell\\Events",
    "surfaces": ["admin", "frontend", "console"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/frontend",
            "capell-app/navigation",
            "capell-app/publishing-studio"
        ],
        "supports": [
            "capell-app/address",
            "capell-app/customer-portal",
            "capell-app/form-builder",
            "capell-app/seo-suite",
            "capell-app/site-discovery",
            "capell-app/tags"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": ["Capell\\Events\\Providers\\EventsServiceProvider"],
        "admin": [],
        "frontend": []
    },
    "contributes": [],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": [
            "event_venues",
            "events",
            "event_occurrences",
            "event_registrations",
            "event_notification_logs"
        ]
    },
    "commands": {
        "install": "capell:events-install",
        "setup": null,
        "demo": null,
        "doctor": "capell:events-doctor"
    },
    "actions": {
        "install": "Capell\\Events\\Actions\\InstallEventsPackageAction"
    },
    "settings": [],
    "permissions": [
        "ViewAny:Event",
        "View:Event",
        "Create:Event",
        "Update:Event",
        "Delete:Event",
        "DeleteAny:Event",
        "Restore:Event",
        "RestoreAny:Event",
        "ForceDelete:Event",
        "ForceDeleteAny:Event",
        "Replicate:Event",
        "Reorder:Event",
        "ViewAny:EventVenue",
        "View:EventVenue",
        "Create:EventVenue",
        "Update:EventVenue",
        "Delete:EventVenue",
        "DeleteAny:EventVenue",
        "Restore:EventVenue",
        "RestoreAny:EventVenue",
        "ForceDelete:EventVenue",
        "ForceDeleteAny:EventVenue",
        "Replicate:EventVenue",
        "Reorder:EventVenue",
        "ViewAny:EventOccurrence",
        "View:EventOccurrence",
        "Create:EventOccurrence",
        "Update:EventOccurrence",
        "Delete:EventOccurrence",
        "DeleteAny:EventOccurrence",
        "Restore:EventOccurrence",
        "RestoreAny:EventOccurrence",
        "ForceDelete:EventOccurrence",
        "ForceDeleteAny:EventOccurrence",
        "Replicate:EventOccurrence",
        "Reorder:EventOccurrence",
        "ViewAny:EventRegistration",
        "View:EventRegistration",
        "Create:EventRegistration",
        "Update:EventRegistration",
        "Delete:EventRegistration",
        "DeleteAny:EventRegistration",
        "Restore:EventRegistration",
        "RestoreAny:EventRegistration",
        "ForceDelete:EventRegistration",
        "ForceDeleteAny:EventRegistration",
        "Replicate:EventRegistration",
        "Reorder:EventRegistration"
    ],
    "capabilities": [
        "events",
        "events-admin",
        "events-console",
        "events-frontend",
        "events-registration-created-event",
        "events-customer-portal-registration-feed"
    ],
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["events"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "events.recurrence",
            "label": "Recurring events expand into occurrence records",
            "class": "Capell\\Events\\Health\\EventsHealthCheck",
            "severity": "critical",
            "surface": "console"
        },
        {
            "key": "events.calendar-feed",
            "label": "Public iCal feeds include event occurrence URLs",
            "class": "Capell\\Events\\Health\\EventsHealthCheck",
            "severity": "warning",
            "surface": "frontend"
        },
        {
            "key": "events.event-schema",
            "label": "Event occurrences expose schema.org Event structured data",
            "class": "Capell\\Events\\Health\\EventsHealthCheck",
            "severity": "warning",
            "surface": "frontend"
        },
        {
            "key": "events.registration-capacity",
            "label": "Registrations enforce occurrence capacity and waitlist rules",
            "class": "Capell\\Events\\Health\\EventsHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Publish recurring events with venues, capacity-managed RSVPs, subscribable iCal feeds, and Google-ready Event schema — all inside your Capell admin.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Events extension preview image",
                "caption": "Events extension preview"
            }
        ],
        "categories": ["admin", "console", "content-product", "frontend"]
    },
    "contributionTraceability": {
        "deferredContributions": [
            "admin-page",
            "admin-resource",
            "model",
            "page-type",
            "page-variation",
            "route",
            "scheduled-job"
        ]
    }
}
