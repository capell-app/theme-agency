{
    "manifest-version": 3,
    "name": "capell-app/theme-soft-focus",
    "slug": "theme-soft-focus",
    "displayName": "Theme Soft Focus",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "An understated inspiration gallery — light grey pages, modest type, honest image grids. Web design worth a long, quiet look.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\SoftFocus",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\SoftFocus\\SoftFocusThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\SoftFocus\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "soft-focus"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-soft-focus-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-soft-focus", "theme-soft-focus-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-soft-focus"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-soft-focus.package-health",
            "label": "Soft Focus package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\SoftFocus\\Health\\ThemeSoftFocusHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "An understated inspiration gallery with light grey pages, modest type, and honest image grids — web design worth a long, quiet look.",
        "description": "Soft Focus provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for understated inspiration sites that need browse, follow or subscribe, submit, and blog panels; latest showcase entries; sponsor space; small captions; dates; categories; comments; random picks; best-of lists; category archives; and simple editorial posts.",
        "screenshots": [
            {
                "path": "docs/screenshots/soft-focus-homepage.png",
                "alt": "Soft Focus homepage preview",
                "caption": "Soft Focus Homepage"
            },
            {
                "path": "docs/screenshots/soft-focus-landing.png",
                "alt": "Soft Focus landing page preview",
                "caption": "Soft Focus Landing page"
            },
            {
                "path": "docs/screenshots/soft-focus-listing.png",
                "alt": "Soft Focus list page preview",
                "caption": "Soft Focus Category archive"
            },
            {
                "path": "docs/screenshots/soft-focus-search.png",
                "alt": "Soft Focus search results preview",
                "caption": "Soft Focus Search results"
            },
            {
                "path": "docs/screenshots/soft-focus-contact.png",
                "alt": "Soft Focus contact form preview",
                "caption": "Soft Focus Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "soft-focus"
}
