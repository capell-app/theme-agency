{
    "manifest-version": 3,
    "name": "capell-app/theme-design-studio",
    "slug": "theme-design-studio",
    "displayName": "Theme Design Studio",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Design Studio extends the default Capell frontend with a design studio visual direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for interior design studios, architecture practices.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\DesignStudio",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\DesignStudio\\DesignStudioThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\DesignStudio\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "design-studio"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-design-studio-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-design-studio", "theme-design-studio-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-design-studio"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-design-studio.package-health",
            "label": "Design Studio package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\DesignStudio\\Health\\ThemeDesignStudioHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for interior design studios, architecture practices.",
        "description": "Design Studio provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for Atelier Norð.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Design Studio marketplace card preview",
                "caption": "Design Studio premium theme card"
            },
            {
                "path": "docs/screenshots/design-studio-homepage.png",
                "alt": "Design Studio Homepage demo page screenshot",
                "caption": "Design Studio Homepage page"
            },
            {
                "path": "docs/screenshots/design-studio-directory.png",
                "alt": "Design Studio Directory demo page screenshot",
                "caption": "Design Studio Directory page"
            },
            {
                "path": "docs/screenshots/design-studio-detail.png",
                "alt": "Design Studio Detail demo page screenshot",
                "caption": "Design Studio Detail page"
            },
            {
                "path": "docs/screenshots/design-studio-contact.png",
                "alt": "Design Studio Contact demo page screenshot",
                "caption": "Design Studio Contact page"
            },
            {
                "path": "docs/screenshots/design-studio-empty.png",
                "alt": "Design Studio Empty State demo page screenshot",
                "caption": "Design Studio Empty State page"
            },
            {
                "path": "docs/screenshots/design-studio-not-found.png",
                "alt": "Design Studio 404 State demo page screenshot",
                "caption": "Design Studio 404 State page"
            },
            {
                "path": "docs/screenshots/design-studio-cta.png",
                "alt": "Design Studio Conversion CTA demo page screenshot",
                "caption": "Design Studio Conversion CTA page"
            },
            {
                "path": "docs/screenshots/design-studio-projects.png",
                "alt": "Design Studio Projects demo page screenshot",
                "caption": "Design Studio Projects page"
            },
            {
                "path": "docs/screenshots/design-studio-studio.png",
                "alt": "Design Studio Studio demo page screenshot",
                "caption": "Design Studio Studio page"
            },
            {
                "path": "docs/screenshots/design-studio-case-study.png",
                "alt": "Design Studio Case Study demo page screenshot",
                "caption": "Design Studio Case Study page"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "design-studio"
}
