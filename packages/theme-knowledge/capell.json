{
    "manifest-version": 3,
    "name": "capell-app/theme-knowledge",
    "slug": "theme-knowledge",
    "displayName": "Theme Knowledge",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Editorial and resource-library theme for knowledge bases, publishers, and content-led teams.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\Knowledge",
    "surfaces": [
        "frontend"
    ],
    "dependencies": {
        "requires": [
            "capell-app/core",
            "capell-app/foundation-theme"
        ],
        "supports": [
            "capell-app/layout-builder",
            "capell-app/frontend-authoring",
            "capell-app/publishing-studio",
            "capell-app/seo-suite",
            "capell-app/blog",
            "capell-app/search",
            "capell-app/newsletter"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\Knowledge\\KnowledgeThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\Knowledge\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "knowledge"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-knowledge-demo",
        "demoParams": [
            "url",
            "languages",
            "sites"
        ],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-knowledge",
        "theme-knowledge-frontend"
    ],
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": [
            "theme-knowledge"
        ],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [
                "site",
                "locale"
            ],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "theme-knowledge.package-health",
            "label": "Theme Knowledge package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\Knowledge\\Health\\ThemeKnowledgeHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "marketplace": {
        "summary": "A premium knowledge-base and documentation theme for Capell — sidebar-navigated articles, in-page table of contents, prominent search, and readable long-form layouts out of the box.",
        "description": "Theme Knowledge turns a Capell site into a polished documentation and help centre. It pairs a category sidebar, sticky table of contents, code-friendly prose, and breadcrumb trails with a prominent search experience and readable long-form typography, so visitors find answers fast. Resource libraries, author bios, topic hubs, and newsletter capture round out a full knowledge-marketing surface, with optional Blog, Search, and Newsletter integrations lighting up automatically when those packages are installed. Built on the Capell foundation theme with configurable colour tokens, dark-mode support, and accessible focus states.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Theme Knowledge marketplace card.",
                "caption": "Theme Knowledge theme card."
            },
            {
                "path": "docs/screenshots/knowledge-homepage-layout.png",
                "alt": "Theme Knowledge homepage with dark documentation shell, search console, and expertise-led hero content.",
                "caption": "Route-backed Knowledge homepage rendered through the package theme shell."
            }
        ],
        "categories": [
            "frontend",
            "themes"
        ]
    },
    "extends": "capell-app/foundation-theme",
    "themeKey": "knowledge",
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    }
}
