{
    "manifest-version": 3,
    "name": "capell-app/theme-global-culture-magazine",
    "slug": "theme-global-culture-magazine",
    "displayName": "Theme Global Culture Magazine",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Global Culture Magazine extends the default Capell frontend with a premium global editorial direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for lead dispatches, radio and audio rows, city guides, travel, culture, books, shop cards, columnists, archives, and newsletter conversion.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\GlobalCultureMagazine",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\GlobalCultureMagazine\\GlobalCultureMagazineThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\GlobalCultureMagazine\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "global-culture-magazine"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-global-culture-magazine-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-global-culture-magazine",
        "theme-global-culture-magazine-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-global-culture-magazine"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-global-culture-magazine.package-health",
            "label": "Global Culture Magazine package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\GlobalCultureMagazine\\Health\\ThemeGlobalCultureMagazineHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for global magazines covering affairs, travel, culture, radio, city guides, books, shops, and columnists.",
        "description": "Global Culture Magazine provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for premium publishers that need polished editorial, audio, city guides, books, shop modules, and newsletter growth.",
        "screenshots": [
            {
                "path": "docs/screenshots/global-culture-magazine-homepage.png",
                "alt": "Global Culture Magazine homepage preview",
                "caption": "Global Culture Magazine Homepage"
            },
            {
                "path": "docs/screenshots/global-culture-magazine-landing.png",
                "alt": "Global Culture Magazine landing page preview",
                "caption": "Global Culture Magazine Landing page"
            },
            {
                "path": "docs/screenshots/global-culture-magazine-listing.png",
                "alt": "Global Culture Magazine list page preview",
                "caption": "Global Culture Magazine List page"
            },
            {
                "path": "docs/screenshots/global-culture-magazine-search.png",
                "alt": "Global Culture Magazine search results preview",
                "caption": "Global Culture Magazine Search results"
            },
            {
                "path": "docs/screenshots/global-culture-magazine-contact.png",
                "alt": "Global Culture Magazine contact form preview",
                "caption": "Global Culture Magazine Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "global-culture-magazine"
}
