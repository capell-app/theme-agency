{
    "name": "capell-app/equestrian-clinics",
    "description": "Full equestrian operations for Capell: tour days, clinics, riders, horses, waivers, facility resources, credits, host requests, and coach-ready reporting.",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Capell\\EquestrianClinics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\EquestrianClinics\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\EquestrianClinics\\Providers\\EquestrianClinicsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "require": {
        "php": "^8.4",
        "capell-app/address": "^4.0 || 4.x-dev",
        "capell-app/bookings": "^4.0 || 4.x-dev",
        "capell-app/core": "^4.0 || 4.x-dev",
        "capell-app/customer-portal": "^4.0 || 4.x-dev",
        "capell-app/events": "^4.0 || 4.x-dev",
        "capell-app/media-library": "^4.0 || 4.x-dev",
        "capell-app/payments": "^4.0 || 4.x-dev",
        "laravel/framework": "^11.45.3|^12.41.1|^13.0",
        "lorisleiva/laravel-actions": "^2.8",
        "spatie/laravel-data": "^4.5",
        "spatie/laravel-package-tools": "^1.14.1"
    },
    "require-dev": {
        "orchestra/testbench": "^9.15|^10.8|^11.0",
        "pestphp/pest": "^3.8|^4.3",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "keywords": [
        "capell",
        "bookings",
        "equestrian",
        "clinics",
        "tour-days"
    ],
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/equestrian-clinics"
    }
}
