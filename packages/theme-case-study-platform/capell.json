{
    "manifest-version": 3,
    "name": "capell-app/theme-case-study-platform",
    "slug": "theme-case-study-platform",
    "displayName": "Theme Case Study Platform",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Case Study Platform extends the default Capell frontend with a professional creative case-study direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for creator heroes, discipline filters, project feeds, appreciations, media stacks, credits, tools, process notes, related projects, and hiring CTAs.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\CaseStudyPlatform",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [
            "capell-app/blog",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\CaseStudyPlatform\\CaseStudyPlatformThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\CaseStudyPlatform\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "case-study-platform"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-case-study-platform-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-case-study-platform",
        "theme-case-study-platform-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "criticalCss": {
            "required": true,
            "parityViewports": ["mobile", "tablet", "desktop"]
        },
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-case-study-platform"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-case-study-platform.package-health",
            "label": "Case Study Platform package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\CaseStudyPlatform\\Health\\ThemeCaseStudyPlatformHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A professional Capell theme for creative case-study platforms, broad project feeds, discipline filters, rich detail pages, and talent discovery.",
        "description": "Case Study Platform provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for graphic design, photography, 3D, UI/UX, motion, architecture, fashion, and multidisciplinary project platforms that need appreciations, views, save state, ownership, media type, credits, tools, process notes, related projects, and hiring paths.",
        "screenshots": [
            {
                "path": "docs/screenshots/case-study-platform-homepage.png",
                "alt": "Case Study Platform homepage preview",
                "caption": "Case Study Platform Homepage"
            },
            {
                "path": "docs/screenshots/case-study-platform-landing.png",
                "alt": "Case Study Platform landing page preview",
                "caption": "Case Study Platform Landing page"
            },
            {
                "path": "docs/screenshots/case-study-platform-listing.png",
                "alt": "Case Study Platform list page preview",
                "caption": "Case Study Platform List page"
            },
            {
                "path": "docs/screenshots/case-study-platform-search.png",
                "alt": "Case Study Platform search results preview",
                "caption": "Case Study Platform Search results"
            },
            {
                "path": "docs/screenshots/case-study-platform-contact.png",
                "alt": "Case Study Platform contact form preview",
                "caption": "Case Study Platform Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "case-study-platform"
}
