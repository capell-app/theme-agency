{
    "manifest-version": 3,
    "name": "capell-app/theme-robotics-hardware",
    "slug": "theme-robotics-hardware",
    "displayName": "Theme Robotics Hardware",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Robotics Hardware extends the default Capell frontend with a robotics hardware visual direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for robotics products, hardware and deep-tech devices.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\RoboticsHardware",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\RoboticsHardware\\RoboticsHardwareThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\RoboticsHardware\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "robotics-hardware"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-robotics-hardware-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "theme-robotics-hardware",
        "theme-robotics-hardware-frontend"
    ],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-robotics-hardware"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-robotics-hardware.package-health",
            "label": "Robotics Hardware package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\RoboticsHardware\\Health\\ThemeRoboticsHardwareHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for robotics products, hardware and deep-tech devices.",
        "description": "Robotics Hardware provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for Atelier One.",
        "screenshots": [
            {
                "path": "docs/screenshots/robotics-hardware-homepage.png",
                "alt": "Robotics Hardware homepage preview",
                "caption": "Robotics Hardware Homepage"
            },
            {
                "path": "docs/screenshots/robotics-hardware-landing.png",
                "alt": "Robotics Hardware landing page preview",
                "caption": "Robotics Hardware Landing page"
            },
            {
                "path": "docs/screenshots/robotics-hardware-listing.png",
                "alt": "Robotics Hardware list page preview",
                "caption": "Robotics Hardware List page"
            },
            {
                "path": "docs/screenshots/robotics-hardware-search.png",
                "alt": "Robotics Hardware search results preview",
                "caption": "Robotics Hardware Search results"
            },
            {
                "path": "docs/screenshots/robotics-hardware-contact.png",
                "alt": "Robotics Hardware contact form preview",
                "caption": "Robotics Hardware Contact form"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "robotics-hardware"
}
