{
    "manifest-version": 3,
    "name": "capell-app/contacts",
    "slug": "contacts",
    "displayName": "Contacts",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Contacts gives your Capell site a single, GDPR-aware customer record that fills itself. Every form submission, newsletter signup, event registration, comment, campaign conversion, and Shopify customer is matched to one encrypted contact by email, phone, or source identity, and enriched with a timeline of leads and activity. Admins get read-through CRM resources and an at-a-glance dashboard, while privacy export and anonymization actions support subject-access and erasure requests out of the box. Built as the shared data spine for the Capell content suite, it powers smarter segmentation across Newsletter, Campaign Studio, and Form Builder.",
    "product": {
        "group": "Capell Content",
        "tier": "premium",
        "bundle": "content-product"
    },
    "namespace": "Capell\\Contacts",
    "surfaces": ["admin"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core"],
        "supports": [
            "capell-app/access-gate",
            "capell-app/campaign-studio",
            "capell-app/comments",
            "capell-app/events",
            "capell-app/form-builder",
            "capell-app/newsletter",
            "capell-app/shopify-commerce"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": ["Capell\\Contacts\\Providers\\ContactsServiceProvider"],
        "admin": ["Capell\\Contacts\\Providers\\AdminServiceProvider"],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\Contacts\\Manifest\\ContactsAdminResourcesContribution",
            "resourceClasses": [
                "Capell\\Contacts\\Filament\\Resources\\Contacts\\ContactResource",
                "Capell\\Contacts\\Filament\\Resources\\Organisations\\OrganisationResource",
                "Capell\\Contacts\\Filament\\Resources\\Leads\\LeadResource",
                "Capell\\Contacts\\Filament\\Resources\\Activities\\ContactActivityResource"
            ]
        },
        {
            "type": "model",
            "class": "Capell\\Contacts\\Manifest\\ContactsModelsContribution",
            "modelClasses": [
                "Capell\\Contacts\\Models\\Contact",
                "Capell\\Contacts\\Models\\ContactTag",
                "Capell\\Contacts\\Models\\Organisation",
                "Capell\\Contacts\\Models\\Lead",
                "Capell\\Contacts\\Models\\ContactActivity"
            ]
        },
        {
            "type": "dashboard-widget",
            "class": "Capell\\Contacts\\Manifest\\ContactsOverviewFilamentWidgetContribution",
            "widgetClass": "Capell\\Contacts\\Filament\\Widgets\\ContactsOverviewStatsFilamentWidget"
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": [
            "contacts",
            "contact_tag_memberships",
            "contact_tags",
            "contact_organisations",
            "contact_organisation_memberships",
            "contact_leads",
            "contact_activities"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null,
        "privacy": "capell-contacts:privacy"
    },
    "settings": [],
    "actions": {
        "anonymizeContact": "Capell\\Contacts\\Actions\\AnonymizeContactAction",
        "anonymizeContactWithAudit": "Capell\\Contacts\\Actions\\AnonymizeContactWithAuditAction",
        "auditContactPrivacyExport": "Capell\\Contacts\\Actions\\AuditContactPrivacyExportAction",
        "buildContactPrivacyExport": "Capell\\Contacts\\Actions\\BuildContactPrivacyExportAction",
        "buildContactsOverviewStats": "Capell\\Contacts\\Actions\\BuildContactsOverviewStatsAction",
        "findOrCreateContact": "Capell\\Contacts\\Actions\\FindOrCreateContactAction",
        "recordContactActivity": "Capell\\Contacts\\Actions\\RecordContactActivityAction",
        "syncAccessGateRegistrationContact": "Capell\\Contacts\\Actions\\SyncAccessGateRegistrationContactAction",
        "syncCampaignConversionContact": "Capell\\Contacts\\Actions\\SyncCampaignConversionContactAction",
        "syncCommentContact": "Capell\\Contacts\\Actions\\SyncCommentContactAction",
        "syncEventRegistrationContact": "Capell\\Contacts\\Actions\\SyncEventRegistrationContactAction",
        "syncFormSubmissionContact": "Capell\\Contacts\\Actions\\SyncFormSubmissionContactAction",
        "syncShopifyCustomerContact": "Capell\\Contacts\\Actions\\SyncShopifyCustomerContactAction",
        "syncContactSourceRecord": "Capell\\Contacts\\Actions\\SyncContactSourceRecordAction",
        "tagContact": "Capell\\Contacts\\Actions\\TagContactAction"
    },
    "permissions": [
        "ExportPrivacy:Contact",
        "AnonymizePrivacy:Contact",
        "View:Contact",
        "View:Organisation",
        "View:Lead",
        "View:ContactActivity"
    ],
    "capabilities": [
        "contacts",
        "contacts-identity",
        "contacts-source-identity",
        "contacts-source-sync",
        "contacts-access-gate-source-adapter",
        "contacts-campaign-studio-source-adapter",
        "contacts-comments-source-adapter",
        "contacts-events-source-adapter",
        "contacts-form-builder-source-adapter",
        "contacts-newsletter-source-adapter",
        "contacts-shopify-commerce-source-adapter",
        "contacts-activity",
        "contacts-dashboard-widget",
        "contacts-privacy-export",
        "contacts-privacy-anonymization",
        "contacts-tags"
    ],
    "security": {
        "riskTier": "sensitive",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [
                "Capell\\Contacts\\Models\\Contact::$display_name",
                "Capell\\Contacts\\Models\\Contact::$email",
                "Capell\\Contacts\\Models\\Contact::$first_name",
                "Capell\\Contacts\\Models\\Contact::$last_name",
                "Capell\\Contacts\\Models\\Contact::$phone",
                "Capell\\Contacts\\Models\\Contact::$profile",
                "Capell\\Contacts\\Models\\Contact::$source_identifier",
                "Capell\\Contacts\\Models\\ContactActivity::$payload",
                "Capell\\Contacts\\Models\\ContactActivity::$summary",
                "Capell\\Contacts\\Models\\Lead::$context",
                "Capell\\Contacts\\Models\\Organisation::$profile"
            ],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": false,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "ExportPrivacy:Contact",
                "AnonymizePrivacy:Contact",
                "View:Contact",
                "View:Organisation",
                "View:Lead",
                "View:ContactActivity"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": ["contacts"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site"],
            "sensitiveOutput": true,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "contacts.package-health",
            "label": "Contacts models, migrations, and privacy-sensitive storage are discoverable.",
            "class": "Capell\\Contacts\\Health\\ContactsHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "The unified CRM layer for Capell — automatically captures contacts, organisations, leads, and activity from your forms, newsletter, events, comments, and Shopify store into one privacy-safe, encrypted record.",
        "screenshots": [
            {
                "path": "docs/screenshots/contacts-contact-index.png",
                "label": "Contacts admin index",
                "alt": "Capell admin Contacts table showing Ava Morgan with email, phone, active status, and privacy export actions.",
                "caption": "Review encrypted customer records and privacy-safe export or anonymization actions from the Capell admin."
            },
            {
                "path": "docs/screenshots/contacts-activity-index.png",
                "label": "Contact activities",
                "alt": "Capell admin Contact Activities table showing form submission and newsletter subscription activity for Ava Morgan and Northstar Studio.",
                "caption": "Trace CRM activity across contacts, organisations, and leads from package source adapters."
            }
        ],
        "categories": ["admin", "crm", "contacts"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
