{
    "manifest-version": 3,
    "name": "capell-app/privacy-center",
    "slug": "privacy-center",
    "displayName": "Privacy Center",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Privacy Center gives every Capell site a single, queryable system of record for privacy obligations: granular cookie-category consent, versioned policy acceptances, retention rules, and access/export/delete subject requests. Consent and subject data are recorded through stable Actions that other Capell packages can call. Hashed request evidence (IP, user-agent) and consent records give you defensible proof, while retention rules keep data minimised. Admin operators get resources and an at-a-glance compliance dashboard; nothing sensitive ever leaks to public output.",
    "product": {
        "group": "Capell Operations",
        "tier": "premium",
        "bundle": "operations"
    },
    "namespace": "Capell\\PrivacyCenter",
    "surfaces": ["admin", "console", "frontend"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core"],
        "supports": [
            "capell-app/access-gate",
            "capell-app/contacts",
            "capell-app/insights",
            "capell-app/newsletter"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\PrivacyCenter\\Providers\\PrivacyCenterServiceProvider"
        ],
        "admin": ["Capell\\PrivacyCenter\\Providers\\AdminServiceProvider"],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\PrivacyCenter\\Manifest\\ConsentPolicyResourceContribution",
            "resourceClass": "Capell\\PrivacyCenter\\Filament\\Resources\\ConsentPolicies\\ConsentPolicyResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\PrivacyCenter\\Manifest\\ConsentRecordResourceContribution",
            "resourceClass": "Capell\\PrivacyCenter\\Filament\\Resources\\ConsentRecords\\ConsentRecordResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\PrivacyCenter\\Manifest\\PolicyAcceptanceResourceContribution",
            "resourceClass": "Capell\\PrivacyCenter\\Filament\\Resources\\PolicyAcceptances\\PolicyAcceptanceResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\PrivacyCenter\\Manifest\\PrivacyRequestResourceContribution",
            "resourceClass": "Capell\\PrivacyCenter\\Filament\\Resources\\PrivacyRequests\\PrivacyRequestResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\PrivacyCenter\\Manifest\\RetentionRuleResourceContribution",
            "resourceClass": "Capell\\PrivacyCenter\\Filament\\Resources\\RetentionRules\\RetentionRuleResource"
        },
        {
            "type": "dashboard-widget",
            "class": "Capell\\PrivacyCenter\\Manifest\\PrivacyCenterOverviewWidgetContribution",
            "widgetClass": "Capell\\PrivacyCenter\\Filament\\Widgets\\PrivacyCenterOverviewWidget"
        },
        {
            "type": "model",
            "class": "Capell\\PrivacyCenter\\Manifest\\PrivacyCenterModelsContribution",
            "modelClasses": [
                "Capell\\PrivacyCenter\\Models\\ConsentPolicy",
                "Capell\\PrivacyCenter\\Models\\ConsentRecord",
                "Capell\\PrivacyCenter\\Models\\PolicyAcceptance",
                "Capell\\PrivacyCenter\\Models\\PrivacyRequest",
                "Capell\\PrivacyCenter\\Models\\RetentionRule"
            ]
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\PrivacyCenter\\Manifest\\PrivacyRetentionScheduleContribution",
            "command": "privacy:apply-retention",
            "frequency": "daily"
        },
        {
            "type": "route",
            "class": "Capell\\PrivacyCenter\\Manifest\\PrivacyCenterRoutesContribution",
            "routes": [
                "capell-privacy-center.consent.show",
                "capell-privacy-center.consent.store"
            ]
        },
        {
            "type": "console-command",
            "class": "Capell\\PrivacyCenter\\Manifest\\PrivacyCenterConsoleCommandsContribution",
            "commands": ["privacy:apply-retention"],
            "commandClasses": [
                "Capell\\PrivacyCenter\\Console\\Commands\\ApplyRetentionRulesCommand"
            ]
        },
        {
            "type": "health-check",
            "class": "Capell\\PrivacyCenter\\Manifest\\PrivacyCenterHealthContribution",
            "checkClass": "Capell\\PrivacyCenter\\Health\\PrivacyCenterHealthCheck"
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": [
            "privacy_consent_policies",
            "privacy_consent_records",
            "privacy_policy_acceptances",
            "privacy_retention_rules",
            "privacy_requests"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null,
        "retention": "privacy:apply-retention"
    },
    "settings": [],
    "actions": {
        "buildPrivacyCenterOverviewStats": "Capell\\PrivacyCenter\\Actions\\BuildPrivacyCenterOverviewStatsAction",
        "applyRetentionRule": "Capell\\PrivacyCenter\\Actions\\ApplyRetentionRuleAction",
        "applyRetentionRules": "Capell\\PrivacyCenter\\Actions\\ApplyRetentionRulesAction",
        "anonymizePrivacySubject": "Capell\\PrivacyCenter\\Actions\\AnonymizePrivacySubjectAction",
        "buildPrivacyExport": "Capell\\PrivacyCenter\\Actions\\BuildPrivacyExportAction",
        "createRetentionRule": "Capell\\PrivacyCenter\\Actions\\CreateRetentionRuleAction",
        "markPrivacyRequestFulfilled": "Capell\\PrivacyCenter\\Actions\\MarkPrivacyRequestFulfilledAction",
        "openPrivacyRequest": "Capell\\PrivacyCenter\\Actions\\OpenPrivacyRequestAction",
        "recordConsent": "Capell\\PrivacyCenter\\Actions\\RecordConsentAction",
        "recordPolicyAcceptance": "Capell\\PrivacyCenter\\Actions\\RecordPolicyAcceptanceAction",
        "registerConsentPolicy": "Capell\\PrivacyCenter\\Actions\\RegisterConsentPolicyAction"
    },
    "permissions": [
        "ViewAny:ConsentPolicy",
        "View:ConsentPolicy",
        "Create:ConsentPolicy",
        "Update:ConsentPolicy",
        "Delete:ConsentPolicy",
        "ViewAny:ConsentRecord",
        "View:ConsentRecord",
        "ViewAny:PolicyAcceptance",
        "View:PolicyAcceptance",
        "ViewAny:PrivacyRequest",
        "View:PrivacyRequest",
        "Update:PrivacyRequest",
        "ViewAny:RetentionRule",
        "View:RetentionRule",
        "Create:RetentionRule",
        "Update:RetentionRule",
        "Delete:RetentionRule"
    ],
    "capabilities": [
        "privacy-center",
        "privacy-center-consent",
        "privacy-center-cookie-categories",
        "privacy-center-insights-consent-mirror",
        "privacy-center-retention",
        "privacy-center-retention-execution",
        "privacy-center-retention-admin-run",
        "privacy-center-privacy-exports",
        "privacy-center-delete-workflows",
        "privacy-center-policy-acceptance",
        "privacy-center-subject-requests"
    ],
    "security": {
        "riskTier": "sensitive",
        "publicSurface": {
            "routeNames": [
                "capell-privacy-center.consent.show",
                "capell-privacy-center.consent.store"
            ],
            "auth": "public",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": ["capell-privacy-center.consent.store"]
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": false,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "ViewAny:ConsentPolicy",
                "View:ConsentPolicy",
                "Create:ConsentPolicy",
                "Update:ConsentPolicy",
                "Delete:ConsentPolicy",
                "ViewAny:ConsentRecord",
                "View:ConsentRecord",
                "ViewAny:PolicyAcceptance",
                "View:PolicyAcceptance",
                "ViewAny:PrivacyRequest",
                "View:PrivacyRequest",
                "Update:PrivacyRequest",
                "ViewAny:RetentionRule",
                "View:RetentionRule",
                "Create:RetentionRule",
                "Update:RetentionRule",
                "Delete:RetentionRule"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 40,
        "adminQueryBudget": 40,
        "cacheTags": ["privacy-center"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "subject"],
            "sensitiveOutput": true,
            "invalidationSources": [
                {
                    "model": "Capell\\PrivacyCenter\\Models\\ConsentPolicy",
                    "events": ["created", "updated", "deleted"]
                },
                {
                    "model": "Capell\\PrivacyCenter\\Models\\ConsentRecord",
                    "events": ["created", "updated", "deleted"]
                },
                {
                    "model": "Capell\\PrivacyCenter\\Models\\PrivacyRequest",
                    "events": ["created", "updated", "deleted"]
                },
                {
                    "model": "Capell\\PrivacyCenter\\Models\\RetentionRule",
                    "events": ["created", "updated", "deleted"]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "privacy-center.package-health",
            "label": "Privacy Center package models, migrations, and service provider are discoverable.",
            "class": "Capell\\PrivacyCenter\\Health\\PrivacyCenterHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "The compliance backbone for Capell — one auditable ledger for cookie consent, policy acceptances, retention rules, and GDPR/CCPA subject requests, with Actions your other packages plug straight into.",
        "screenshots": [
            {
                "path": "docs/screenshots/privacy-requests-index.png",
                "alt": "Privacy Center request queue showing a submitted data-subject access request.",
                "caption": "Triage access, export, rectification, and deletion requests from a single compliance queue."
            },
            {
                "path": "docs/screenshots/privacy-request-edit-actions.png",
                "alt": "Privacy Center request edit screen with verification and rejection workflow actions.",
                "caption": "Verify, fulfil, or reject data-subject requests with audited workflow payload and metadata."
            },
            {
                "path": "docs/screenshots/retention-rules-index.png",
                "alt": "Privacy Center retention rules table showing an active marketing consent ledger rule.",
                "caption": "Review active data retention rules, retention windows, and minimisation actions in Capell admin."
            }
        ],
        "categories": ["admin", "compliance", "operations"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
