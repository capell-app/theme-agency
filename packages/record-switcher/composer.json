{
    "name": "capell-app/record-switcher",
    "description": "Admin record switcher for Capell edit pages, with fast search and keyboard selection.",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Capell\\RecordSwitcher\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\RecordSwitcher\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\RecordSwitcher\\Providers\\RecordSwitcherServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "require": {
        "php": "^8.3",
        "capell-app/admin": "^4.0 || 4.x-dev",
        "filament/filament": "^4.7|^5.2",
        "laravel/framework": "^11.44.2|^12.0|^13.0",
        "livewire/livewire": "^3.0|^4.0",
        "spatie/laravel-package-tools": "^1.15"
    },
    "require-dev": {
        "orchestra/testbench": "^9.15|^10.8|^11.0",
        "pestphp/pest": "^3.8|^4.3",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "bin/pest --colors=always"
    },
    "homepage": "https://github.com/capell-app/record-switcher",
    "keywords": [
        "capell",
        "cms",
        "laravel",
        "filament",
        "admin",
        "record-switcher",
        "keyboard-navigation",
        "editor-productivity"
    ],
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/record-switcher"
    }
}
