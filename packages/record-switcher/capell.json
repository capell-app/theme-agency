{
    "manifest-version": 3,
    "name": "capell-app/record-switcher",
    "slug": "record-switcher",
    "displayName": "Record Switcher",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Fast Filament edit-page record switching for Capell admins, with searchable suggestions and keyboard selection.",
    "product": {
        "group": "Capell Foundation",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\RecordSwitcher",
    "surfaces": ["admin"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core"],
        "supports": [],
        "conflicts": ["howdu/filament-record-switcher"]
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [],
        "admin": [
            "Capell\\RecordSwitcher\\Providers\\RecordSwitcherServiceProvider"
        ],
        "frontend": []
    },
    "contributes": [
        {
            "type": "asset",
            "class": "Capell\\RecordSwitcher\\Manifest\\RecordSwitcherAssetsContribution",
            "surface": "admin",
            "assets": ["record-switcher"]
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "actions": [],
    "settings": [],
    "permissions": [],
    "capabilities": [
        "admin-record-switching",
        "edit-page-searchable-record-navigation",
        "keyboard-tab-suggestion-acceptance",
        "filament-heading-switcher",
        "first-party-admin-assets"
    ],
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 10,
        "cacheTags": [],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Jump between editable Capell records directly from the page heading with fast suggestions and Tab-to-accept keyboard flow.",
        "description": "Record Switcher keeps editors moving across pages, layouts, widgets, sections, and navigation records without returning to table views. It ships first-party admin assets, a Livewire heading component, and Capell-owned styling that matches the admin surface.",
        "screenshots": [
            {
                "path": "docs/screenshots/admin-heading-switcher.png",
                "alt": "Capell admin edit page with Record Switcher suggestions open",
                "caption": "Searchable heading switcher for moving between editable records in the Capell admin."
            },
            {
                "path": "docs/screenshots/admin-heading-switcher-dark.png",
                "alt": "Dark mode Capell admin edit page with Record Switcher suggestions open",
                "caption": "Dark mode capture of the same Record Switcher heading workflow."
            }
        ],
        "categories": ["admin", "foundation", "editor-productivity"]
    }
}
