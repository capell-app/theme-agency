{
    "manifest-version": 3,
    "name": "capell-app/theme-fintech-trust",
    "slug": "theme-fintech-trust",
    "displayName": "Theme Fintech Trust",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Fintech Trust extends the default Capell frontend with a fintech trust visual direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for fintech infrastructure, identity verification / kyb.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\FintechTrust",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\FintechTrust\\FintechTrustThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\FintechTrust\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "fintech-trust"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-fintech-trust-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-fintech-trust", "theme-fintech-trust-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-fintech-trust"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-fintech-trust.package-health",
            "label": "Fintech Trust package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\FintechTrust\\Health\\ThemeFintechTrustHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for fintech infrastructure, identity verification / kyb.",
        "description": "Fintech Trust provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for Tessera Verify.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Fintech Trust marketplace card preview",
                "caption": "Fintech Trust premium theme card"
            },
            {
                "path": "docs/screenshots/fintech-trust-homepage.png",
                "alt": "Fintech Trust Homepage demo page screenshot",
                "caption": "Fintech Trust Homepage page"
            },
            {
                "path": "docs/screenshots/fintech-trust-directory.png",
                "alt": "Fintech Trust Directory demo page screenshot",
                "caption": "Fintech Trust Directory page"
            },
            {
                "path": "docs/screenshots/fintech-trust-detail.png",
                "alt": "Fintech Trust Detail demo page screenshot",
                "caption": "Fintech Trust Detail page"
            },
            {
                "path": "docs/screenshots/fintech-trust-contact.png",
                "alt": "Fintech Trust Contact demo page screenshot",
                "caption": "Fintech Trust Contact page"
            },
            {
                "path": "docs/screenshots/fintech-trust-empty.png",
                "alt": "Fintech Trust Empty State demo page screenshot",
                "caption": "Fintech Trust Empty State page"
            },
            {
                "path": "docs/screenshots/fintech-trust-not-found.png",
                "alt": "Fintech Trust 404 State demo page screenshot",
                "caption": "Fintech Trust 404 State page"
            },
            {
                "path": "docs/screenshots/fintech-trust-cta.png",
                "alt": "Fintech Trust Conversion CTA demo page screenshot",
                "caption": "Fintech Trust Conversion CTA page"
            },
            {
                "path": "docs/screenshots/fintech-trust-verification-flow.png",
                "alt": "Fintech Trust Verification Flow demo page screenshot",
                "caption": "Fintech Trust Verification Flow page"
            },
            {
                "path": "docs/screenshots/fintech-trust-security.png",
                "alt": "Fintech Trust Security Architecture demo page screenshot",
                "caption": "Fintech Trust Security Architecture page"
            },
            {
                "path": "docs/screenshots/fintech-trust-compliance.png",
                "alt": "Fintech Trust Compliance Hub demo page screenshot",
                "caption": "Fintech Trust Compliance Hub page"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "fintech-trust"
}
