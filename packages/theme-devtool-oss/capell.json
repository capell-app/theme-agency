{
    "manifest-version": 3,
    "name": "capell-app/theme-devtool-oss",
    "slug": "theme-devtool-oss",
    "displayName": "Theme Devtool OSS",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Devtool OSS extends the default Capell frontend with a devtool oss visual direction, portable demo content, cache-safe public Blade rendering, and theme tokens tuned for open-source developer tools, self-host + cloud products.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\DevtoolOss",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/frontend"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ThemeStudio\\DevtoolOss\\DevtoolOssThemeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\DevtoolOss\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "devtool-oss"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-devtool-oss-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-devtool-oss", "theme-devtool-oss-frontend"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-devtool-oss"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "theme-devtool-oss.package-health",
            "label": "Devtool OSS package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\DevtoolOss\\Health\\ThemeDevtoolOssHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "A premium Capell theme for open-source developer tools, self-host + cloud products.",
        "description": "Devtool OSS provides a distinct theme definition, demo command, marketplace metadata, and public-safe Blade views for Scheduler OSS.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Devtool OSS marketplace card preview",
                "caption": "Devtool OSS premium theme card"
            },
            {
                "path": "docs/screenshots/devtool-oss-homepage.png",
                "alt": "Devtool OSS Homepage demo page screenshot",
                "caption": "Devtool OSS Homepage page"
            },
            {
                "path": "docs/screenshots/devtool-oss-directory.png",
                "alt": "Devtool OSS Directory demo page screenshot",
                "caption": "Devtool OSS Directory page"
            },
            {
                "path": "docs/screenshots/devtool-oss-detail.png",
                "alt": "Devtool OSS Detail demo page screenshot",
                "caption": "Devtool OSS Detail page"
            },
            {
                "path": "docs/screenshots/devtool-oss-contact.png",
                "alt": "Devtool OSS Contact demo page screenshot",
                "caption": "Devtool OSS Contact page"
            },
            {
                "path": "docs/screenshots/devtool-oss-empty.png",
                "alt": "Devtool OSS Empty State demo page screenshot",
                "caption": "Devtool OSS Empty State page"
            },
            {
                "path": "docs/screenshots/devtool-oss-not-found.png",
                "alt": "Devtool OSS 404 State demo page screenshot",
                "caption": "Devtool OSS 404 State page"
            },
            {
                "path": "docs/screenshots/devtool-oss-cta.png",
                "alt": "Devtool OSS Conversion CTA demo page screenshot",
                "caption": "Devtool OSS Conversion CTA page"
            },
            {
                "path": "docs/screenshots/devtool-oss-install.png",
                "alt": "Devtool OSS Install demo page screenshot",
                "caption": "Devtool OSS Install page"
            },
            {
                "path": "docs/screenshots/devtool-oss-community.png",
                "alt": "Devtool OSS Community demo page screenshot",
                "caption": "Devtool OSS Community page"
            },
            {
                "path": "docs/screenshots/devtool-oss-cloud.png",
                "alt": "Devtool OSS Cloud vs Self-host demo page screenshot",
                "caption": "Devtool OSS Cloud vs Self-host page"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "default",
    "themeKey": "devtool-oss"
}
