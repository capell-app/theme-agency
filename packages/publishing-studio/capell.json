{
    "manifest-version": 3,
    "name": "capell-app/publishing-studio",
    "slug": "publishing-studio",
    "displayName": "Publishing Studio",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Publishing Studio provides preview, compare, approve, editorial calendar, schedule, publish, restore, and rollback workflows for Capell content.",
    "product": {
        "group": "Capell Publishing Pro",
        "tier": "premium",
        "bundle": "publishing-pro"
    },
    "namespace": "Capell\\PublishingStudio",
    "surfaces": ["admin", "console"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/html-cache",
            "capell-app/migration-assistant",
            "capell-app/navigation"
        ],
        "supports": [
            "capell-app/blog",
            "capell-app/campaign-studio",
            "capell-app/events",
            "capell-app/newsletter"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [
            "Capell\\PublishingStudio\\Providers\\ConsoleServiceProvider"
        ],
        "runtime": [
            "Capell\\PublishingStudio\\Providers\\PublishingStudioServiceProvider"
        ],
        "admin": ["Capell\\PublishingStudio\\Providers\\AdminServiceProvider"],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\PublishingStudio\\Manifest\\PublishingWorkflowPageContribution",
            "pageClass": "Capell\\PublishingStudio\\Filament\\Pages\\PublishingWorkflowPage",
            "labelKey": "capell-publishing-studio::workflow.navigation.label",
            "permission": "View:PublishingWorkflowPage"
        },
        {
            "type": "admin-page",
            "class": "Capell\\PublishingStudio\\Manifest\\ActivityTrailPageContribution",
            "pageClass": "Capell\\PublishingStudio\\Filament\\Pages\\ActivityTrailPage",
            "labelKey": "capell-publishing-studio::workspace.activity.title",
            "permission": "View:ActivityTrailPage"
        },
        {
            "type": "admin-page",
            "class": "Capell\\PublishingStudio\\Manifest\\ScheduledPublishingPageContribution",
            "pageClass": "Capell\\PublishingStudio\\Filament\\Pages\\ScheduledPublishingPage",
            "labelKey": "capell-publishing-studio::scheduler.navigation.label",
            "permission": "View:ScheduledPublishingPage"
        },
        {
            "type": "admin-page",
            "class": "Capell\\PublishingStudio\\Manifest\\StaleDraftsPageContribution",
            "pageClass": "Capell\\PublishingStudio\\Filament\\Pages\\StaleDraftsPage",
            "labelKey": "capell-publishing-studio::workspace.stale_drafts.title",
            "permission": "View:StaleDraftsPage"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\PublishingStudio\\Manifest\\PublishingStudioAdminResourcesContribution",
            "resourceClasses": [
                "Capell\\PublishingStudio\\Filament\\Resources\\PreviewLinks\\PreviewLinkResource",
                "Capell\\PublishingStudio\\Filament\\Resources\\PublishingStudio\\WorkspaceResource"
            ]
        },
        {
            "type": "dashboard-widget",
            "class": "Capell\\PublishingStudio\\Manifest\\PublishingStudioDashboardWidgetsContribution",
            "widgetClasses": [
                "Capell\\PublishingStudio\\Filament\\Widgets\\ContentSchedulerCalendarWidget",
                "Capell\\PublishingStudio\\Filament\\Widgets\\ContentSchedulerOverviewWidget",
                "Capell\\PublishingStudio\\Filament\\Widgets\\WorkspaceActivityWidgetAbstract",
                "Capell\\PublishingStudio\\Filament\\Widgets\\WorkspaceMergeHistoryWidgetAbstract"
            ]
        },
        {
            "type": "overview-stat",
            "class": "Capell\\PublishingStudio\\Manifest\\ContentSchedulerOverviewStatsContribution",
            "keys": [
                "content_scheduler.publish",
                "content_scheduler.unpublish",
                "content_scheduler.embargo",
                "content_scheduler.review_reminder"
            ]
        },
        {
            "type": "model",
            "class": "Capell\\PublishingStudio\\Manifest\\PublishingStudioModelsContribution",
            "modelClasses": [
                "Capell\\PublishingStudio\\Models\\PreviewLink",
                "Capell\\PublishingStudio\\Models\\PublishingRevision",
                "Capell\\PublishingStudio\\Models\\SchedulerDelivery",
                "Capell\\PublishingStudio\\Models\\SchedulerEvent",
                "Capell\\PublishingStudio\\Models\\SchedulerIcalToken",
                "Capell\\PublishingStudio\\Models\\Version",
                "Capell\\PublishingStudio\\Models\\Workspace",
                "Capell\\PublishingStudio\\Models\\WorkspaceApproval",
                "Capell\\PublishingStudio\\Models\\WorkspaceFieldComment",
                "Capell\\PublishingStudio\\Models\\WorkspaceReviewAssignment"
            ]
        },
        {
            "type": "route",
            "class": "Capell\\PublishingStudio\\Manifest\\PublishingStudioRoutesContribution",
            "routes": [
                "capell-frontend.preview.exit",
                "capell-publishing-studio.scheduler.ical"
            ]
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\PublishingStudio\\Manifest\\ScheduledPublishingJobContribution",
            "jobClass": "Capell\\PublishingStudio\\PublishScheduledPublishingStudioJob",
            "name": "capell-publishing-studio-scheduled-publish",
            "frequency": "everyMinute"
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\PublishingStudio\\Manifest\\PublishingStudioPruneScheduleContribution",
            "command": "capell:publishing-studio:prune",
            "name": "capell-publishing-studio-prune",
            "frequencyConfig": "capell.publishing-studio.prune_schedule_cron"
        },
        {
            "type": "workflow-attention",
            "class": "Capell\\PublishingStudio\\Actions\\Workflow\\BuildPublishingWorkflowAttentionItemsAction",
            "pageClass": "Capell\\PublishingStudio\\Filament\\Pages\\PublishingWorkflowPage",
            "labelKey": "capell-publishing-studio::workflow.dashboard.label",
            "descriptionKey": "capell-publishing-studio::workflow.dashboard.description",
            "actionLabelKey": "capell-publishing-studio::workflow.dashboard.action",
            "permission": "View:PublishingWorkflowPage"
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": ["workspaces", "publishing_revisions"]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "actions": {
        "buildContentSchedulerEvents": "Capell\\PublishingStudio\\Actions\\DashboardReports\\BuildContentSchedulerEventsAction",
        "buildEditorialCalendarEvents": "Capell\\PublishingStudio\\Actions\\BuildEditorialCalendarEventsAction",
        "buildSchedulerIcalFeed": "Capell\\PublishingStudio\\Actions\\BuildSchedulerIcalFeedAction",
        "buildVisibleContentSchedulerEvents": "Capell\\PublishingStudio\\Actions\\DashboardReports\\BuildVisibleContentSchedulerEventsAction",
        "buildVisibleEditorialCalendarEvents": "Capell\\PublishingStudio\\Actions\\DashboardReports\\BuildVisibleEditorialCalendarEventsAction",
        "cancelSchedulerEvent": "Capell\\PublishingStudio\\Actions\\CancelSchedulerEventAction",
        "createSchedulerIcalToken": "Capell\\PublishingStudio\\Actions\\CreateSchedulerIcalTokenAction",
        "executeSchedulerEvent": "Capell\\PublishingStudio\\Actions\\ExecuteSchedulerEventAction",
        "install": "Capell\\PublishingStudio\\Actions\\InstallPublishingStudioPackageAction",
        "runDueSchedulerEvents": "Capell\\PublishingStudio\\Actions\\RunDueSchedulerEventsAction",
        "setWorkspaceSchedulerMetadata": "Capell\\PublishingStudio\\Actions\\SetWorkspaceSchedulerMetadataAction",
        "syncWorkspaceSchedulerEvents": "Capell\\PublishingStudio\\Actions\\SyncWorkspaceSchedulerEventsAction",
        "validateWorkspaceSchedulerMetadata": "Capell\\PublishingStudio\\Actions\\ValidateWorkspaceSchedulerMetadataAction"
    },
    "settings": [],
    "permissions": [
        "submit_workspace_for_approval",
        "approve_workspace",
        "publish_workspace",
        "rollback_workspace",
        "publish_outside_release_window",
        "View:ActivityTrailPage",
        "View:PublishingWorkflowPage",
        "View:ScheduledPublishingPage",
        "View:StaleDraftsPage"
    ],
    "capabilities": [
        "activity-history",
        "approval-history",
        "content-compare",
        "dry-run-validation",
        "editorial-calendar-aggregation",
        "editorial-calendar-contributors",
        "editorial-calendar-view",
        "editorial-timeline",
        "embargo-windows",
        "entity-restore",
        "field-comments",
        "live-preview",
        "load-testing",
        "preview-link-management",
        "publish-readiness",
        "recovery-imports",
        "release-window-guards",
        "review-assignments",
        "review-reminders",
        "revision-history",
        "rollback-restore",
        "scheduled-publishing",
        "stale-draft-management",
        "url-collision-checks",
        "version-history",
        "workspace-pruning"
    ],
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": [],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "publishing-studio.package-health",
            "label": "Publishing Studio package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\PublishingStudio\\Health\\PublishingStudioHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Publishing Studio provides preview, compare, approve, editorial calendar, schedule, publish, restore, and rollback workflows for Capell content.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Publishing Studio extension preview image",
                "caption": "Publishing Studio extension preview"
            }
        ],
        "categories": ["admin", "console", "publishing-pro"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
