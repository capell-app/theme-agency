{
    "manifest-version": 3,
    "name": "capell-app/live-chat",
    "slug": "live-chat",
    "displayName": "Live Chat",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Live Chat adds an AI first website chat widget with message-first and details-first flows, office-hours routing, human handoff, contact capture, and Contacts CRM sync.",
    "product": {
        "group": "Capell Growth",
        "tier": "premium",
        "bundle": "growth-product"
    },
    "namespace": "Capell\\LiveChat",
    "surfaces": ["admin", "frontend"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/contacts",
            "capell-app/core",
            "capell-app/frontend"
        ],
        "supports": [
            "capell-app/agent-bridge",
            "capell-app/ai-orchestrator",
            "capell-app/email-studio",
            "capell-app/knowledge-base",
            "capell-app/privacy-center"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": ["Capell\\LiveChat\\Providers\\LiveChatServiceProvider"],
        "admin": ["Capell\\LiveChat\\Providers\\LiveChatServiceProvider"],
        "frontend": ["Capell\\LiveChat\\Providers\\LiveChatServiceProvider"]
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\LiveChat\\Manifest\\LiveChatAdminResourcesContribution",
            "resourceClasses": [
                "Capell\\LiveChat\\Filament\\Resources\\Installations\\InstallationResource",
                "Capell\\LiveChat\\Filament\\Resources\\Conversations\\ConversationResource",
                "Capell\\LiveChat\\Filament\\Resources\\AvailabilityWindows\\AvailabilityWindowResource",
                "Capell\\LiveChat\\Filament\\Resources\\EscalationRules\\EscalationRuleResource",
                "Capell\\LiveChat\\Filament\\Resources\\KnowledgeSources\\KnowledgeSourceResource"
            ]
        },
        {
            "type": "model",
            "class": "Capell\\LiveChat\\Manifest\\LiveChatModelsContribution",
            "modelClasses": [
                "Capell\\LiveChat\\Models\\LiveChatInstallation",
                "Capell\\LiveChat\\Models\\LiveChatConversation",
                "Capell\\LiveChat\\Models\\LiveChatMessage",
                "Capell\\LiveChat\\Models\\LiveChatAIRun",
                "Capell\\LiveChat\\Models\\LiveChatAvailabilityWindow",
                "Capell\\LiveChat\\Models\\LiveChatAvailabilityException",
                "Capell\\LiveChat\\Models\\LiveChatEscalationRule",
                "Capell\\LiveChat\\Models\\LiveChatKnowledgeDocument",
                "Capell\\LiveChat\\Models\\LiveChatKnowledgeGap",
                "Capell\\LiveChat\\Models\\LiveChatKnowledgeSource"
            ]
        },
        {
            "type": "route",
            "class": "Capell\\LiveChat\\Manifest\\LiveChatFrontendRoutesContribution",
            "routeNames": [
                "capell-live-chat.widget",
                "capell-live-chat.widget.script",
                "capell-live-chat.api.preflight",
                "capell-live-chat.api.conversations.store",
                "capell-live-chat.api.messages.store",
                "capell-live-chat.api.handoff.store",
                "capell-live-chat.conversations.store",
                "capell-live-chat.messages.store",
                "capell-live-chat.handoff.store"
            ]
        },
        {
            "type": "frontend-component",
            "class": "Capell\\LiveChat\\Manifest\\LiveChatWidgetContribution",
            "view": "capell-live-chat::widget"
        },
        {
            "type": "health-check",
            "class": "Capell\\LiveChat\\Manifest\\LiveChatHealthContribution",
            "checkClass": "Capell\\LiveChat\\Health\\LiveChatHealthCheck"
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": [
            "live_chat_conversations",
            "live_chat_installations",
            "live_chat_messages",
            "live_chat_ai_runs",
            "live_chat_availability_windows",
            "live_chat_availability_exceptions",
            "live_chat_escalation_rules",
            "live_chat_knowledge_documents",
            "live_chat_knowledge_gaps",
            "live_chat_knowledge_sources"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "actions": {
        "buildLiveChatAnalytics": "Capell\\LiveChat\\Actions\\BuildLiveChatAnalyticsAction",
        "buildLiveChatOperatorState": "Capell\\LiveChat\\Actions\\BuildLiveChatOperatorStateAction",
        "buildLiveChatSuggestedReply": "Capell\\LiveChat\\Actions\\BuildLiveChatSuggestedReplyAction",
        "buildLiveChatTranscript": "Capell\\LiveChat\\Actions\\BuildLiveChatTranscriptAction",
        "buildLiveChatWidgetConfig": "Capell\\LiveChat\\Actions\\BuildLiveChatWidgetConfigAction",
        "closeLiveChatConversation": "Capell\\LiveChat\\Actions\\CloseLiveChatConversationAction",
        "determineLiveChatEscalation": "Capell\\LiveChat\\Actions\\DetermineLiveChatEscalationAction",
        "detectLiveChatIntent": "Capell\\LiveChat\\Actions\\DetectLiveChatIntentAction",
        "generateLiveChatSummary": "Capell\\LiveChat\\Actions\\GenerateLiveChatSummaryAction",
        "guardLiveChatInstallationOrigin": "Capell\\LiveChat\\Actions\\GuardLiveChatInstallationOriginAction",
        "indexLiveChatKnowledgeDocument": "Capell\\LiveChat\\Actions\\IndexLiveChatKnowledgeDocumentAction",
        "indexLiveChatKnowledgeSource": "Capell\\LiveChat\\Actions\\IndexLiveChatKnowledgeSourceAction",
        "recordLiveChatAIRun": "Capell\\LiveChat\\Actions\\RecordLiveChatAIRunAction",
        "recordLiveChatKnowledgeGap": "Capell\\LiveChat\\Actions\\RecordLiveChatKnowledgeGapAction",
        "replyToLiveChatMessage": "Capell\\LiveChat\\Actions\\ReplyToLiveChatMessageAction",
        "requestLiveChatHandoff": "Capell\\LiveChat\\Actions\\RequestLiveChatHandoffAction",
        "searchLiveChatKnowledgeDocuments": "Capell\\LiveChat\\Actions\\SearchLiveChatKnowledgeDocumentsAction",
        "resolveLiveChatConversationForInstallation": "Capell\\LiveChat\\Actions\\ResolveLiveChatConversationForInstallationAction",
        "resolveLiveChatInstallation": "Capell\\LiveChat\\Actions\\ResolveLiveChatInstallationAction",
        "resolveLiveChatAvailability": "Capell\\LiveChat\\Actions\\ResolveLiveChatAvailabilityAction",
        "startLiveChatConversation": "Capell\\LiveChat\\Actions\\StartLiveChatConversationAction",
        "storeLiveChatMessage": "Capell\\LiveChat\\Actions\\StoreLiveChatMessageAction",
        "suggestLiveChatHumanReply": "Capell\\LiveChat\\Actions\\SuggestLiveChatHumanReplyAction",
        "syncLiveChatConversationContact": "Capell\\LiveChat\\Actions\\SyncLiveChatConversationContactAction"
    },
    "permissions": [
        "View:LiveChatInstallation",
        "Create:LiveChatInstallation",
        "Update:LiveChatInstallation",
        "Delete:LiveChatInstallation",
        "View:LiveChatAIRun",
        "View:LiveChatKnowledgeDocument",
        "Create:LiveChatKnowledgeDocument",
        "Update:LiveChatKnowledgeDocument",
        "Delete:LiveChatKnowledgeDocument",
        "View:LiveChatKnowledgeGap",
        "Update:LiveChatKnowledgeGap",
        "View:LiveChatConversation",
        "Update:LiveChatConversation",
        "View:LiveChatAvailabilityWindow",
        "Create:LiveChatAvailabilityWindow",
        "Update:LiveChatAvailabilityWindow",
        "Delete:LiveChatAvailabilityWindow",
        "View:LiveChatEscalationRule",
        "Create:LiveChatEscalationRule",
        "Update:LiveChatEscalationRule",
        "Delete:LiveChatEscalationRule",
        "View:LiveChatKnowledgeSource",
        "Create:LiveChatKnowledgeSource",
        "Update:LiveChatKnowledgeSource",
        "Delete:LiveChatKnowledgeSource"
    ],
    "capabilities": [
        "live-chat",
        "live-chat-widget",
        "live-chat-external-embeds",
        "live-chat-domain-allowlist",
        "live-chat-message-first",
        "live-chat-details-first",
        "live-chat-ai-responder-contract",
        "live-chat-contact-capture",
        "live-chat-contacts-sync",
        "live-chat-office-hours",
        "live-chat-after-hours-response",
        "live-chat-human-handoff",
        "live-chat-escalation-rules",
        "live-chat-proactive-prompts",
        "live-chat-file-uploads",
        "live-chat-transcripts",
        "live-chat-basic-analytics",
        "live-chat-knowledge-sources",
        "live-chat-ai-orchestrator-module",
        "live-chat-agent-bridge-capabilities",
        "live-chat-operator-summary",
        "live-chat-suggested-human-replies",
        "live-chat-ai-run-audit",
        "live-chat-knowledge-gaps",
        "live-chat-knowledge-documents"
    ],
    "security": {
        "riskTier": "sensitive",
        "publicSurface": {
            "routeNames": [
                "capell-live-chat.widget",
                "capell-live-chat.widget.script",
                "capell-live-chat.api.preflight",
                "capell-live-chat.api.conversations.store",
                "capell-live-chat.api.messages.store",
                "capell-live-chat.api.handoff.store",
                "capell-live-chat.conversations.store",
                "capell-live-chat.messages.store",
                "capell-live-chat.handoff.store"
            ],
            "auth": "public",
            "csrfExemptRoutes": [
                "capell-live-chat.api.conversations.store",
                "capell-live-chat.api.messages.store",
                "capell-live-chat.api.handoff.store",
                "capell-live-chat.conversations.store",
                "capell-live-chat.messages.store",
                "capell-live-chat.handoff.store"
            ],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": [
                "capell-live-chat.api.conversations.store",
                "capell-live-chat.api.messages.store",
                "capell-live-chat.api.handoff.store",
                "capell-live-chat.conversations.store",
                "capell-live-chat.messages.store",
                "capell-live-chat.handoff.store"
            ]
        },
        "sensitiveData": {
            "encryptedFields": [
                "Capell\\LiveChat\\Models\\LiveChatInstallation::$allowed_domains",
                "Capell\\LiveChat\\Models\\LiveChatInstallation::$metadata",
                "Capell\\LiveChat\\Models\\LiveChatInstallation::$widget_settings",
                "Capell\\LiveChat\\Models\\LiveChatAIRun::$error_message",
                "Capell\\LiveChat\\Models\\LiveChatAIRun::$input_payload",
                "Capell\\LiveChat\\Models\\LiveChatAIRun::$output_payload",
                "Capell\\LiveChat\\Models\\LiveChatAIRun::$refusal_reason",
                "Capell\\LiveChat\\Models\\LiveChatAIRun::$source_document_ids",
                "Capell\\LiveChat\\Models\\LiveChatConversation::$metadata",
                "Capell\\LiveChat\\Models\\LiveChatConversation::$visitor_company",
                "Capell\\LiveChat\\Models\\LiveChatConversation::$visitor_email",
                "Capell\\LiveChat\\Models\\LiveChatConversation::$visitor_name",
                "Capell\\LiveChat\\Models\\LiveChatConversation::$visitor_phone",
                "Capell\\LiveChat\\Models\\LiveChatMessage::$attachments",
                "Capell\\LiveChat\\Models\\LiveChatMessage::$body",
                "Capell\\LiveChat\\Models\\LiveChatMessage::$metadata",
                "Capell\\LiveChat\\Models\\LiveChatEscalationRule::$metadata",
                "Capell\\LiveChat\\Models\\LiveChatKnowledgeDocument::$metadata",
                "Capell\\LiveChat\\Models\\LiveChatKnowledgeGap::$metadata",
                "Capell\\LiveChat\\Models\\LiveChatKnowledgeGap::$question",
                "Capell\\LiveChat\\Models\\LiveChatKnowledgeSource::$content",
                "Capell\\LiveChat\\Models\\LiveChatKnowledgeSource::$metadata"
            ],
            "hashedTokenFields": [
                "live_chat_conversations.visitor_token_hash",
                "live_chat_conversations.visitor_email_hash",
                "live_chat_conversations.visitor_phone_hash",
                "live_chat_conversations.user_agent_hash",
                "live_chat_conversations.ip_hash"
            ],
            "redactedOutputClasses": [],
            "plaintextJustifications": [
                "live_chat_conversations.uuid: Public opaque conversation identifier used by the browser widget.",
                "live_chat_knowledge_documents.content: Normalized public/support knowledge text must remain searchable for lexical retrieval.",
                "live_chat_messages.role: Non-sensitive routing metadata for transcript ordering.",
                "live_chat_messages.intent: Non-sensitive classification metadata for reporting."
            ]
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "View:LiveChatInstallation",
                "Create:LiveChatInstallation",
                "Update:LiveChatInstallation",
                "Delete:LiveChatInstallation",
                "View:LiveChatAIRun",
                "View:LiveChatKnowledgeDocument",
                "Create:LiveChatKnowledgeDocument",
                "Update:LiveChatKnowledgeDocument",
                "Delete:LiveChatKnowledgeDocument",
                "View:LiveChatKnowledgeGap",
                "Update:LiveChatKnowledgeGap",
                "View:LiveChatConversation",
                "Update:LiveChatConversation",
                "View:LiveChatAvailabilityWindow",
                "Create:LiveChatAvailabilityWindow",
                "Update:LiveChatAvailabilityWindow",
                "Delete:LiveChatAvailabilityWindow",
                "View:LiveChatEscalationRule",
                "Create:LiveChatEscalationRule",
                "Update:LiveChatEscalationRule",
                "Delete:LiveChatEscalationRule",
                "View:LiveChatKnowledgeSource",
                "Create:LiveChatKnowledgeSource",
                "Update:LiveChatKnowledgeSource",
                "Delete:LiveChatKnowledgeSource"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 5,
        "adminQueryBudget": 25,
        "cacheTags": ["live-chat"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site"],
            "sensitiveOutput": true,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "live-chat.package-health",
            "label": "Live Chat tables, morph aliases, routes, and actions are discoverable.",
            "class": "Capell\\LiveChat\\Health\\LiveChatHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "AI first website chat for Capell with message-first capture, details-first enquiries, after-hours replies, human handoff, and Contacts CRM sync.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.svg",
                "label": "Live Chat extension card",
                "alt": "Live Chat extension preview showing Lara answering a pricing question and syncing the conversation to Contacts.",
                "caption": "Add an AI first chat widget that captures leads, escalates sensitive requests, and keeps Contacts as the CRM record of truth."
            }
        ],
        "categories": ["frontend", "crm", "support", "ai"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
