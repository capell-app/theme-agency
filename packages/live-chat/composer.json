{
    "name": "capell-app/live-chat",
    "description": "AI first live chat for Capell with message-first capture, details-first enquiries, office-hours handoff, and Contacts CRM sync.",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://github.com/capell-app/live-chat",
    "require": {
        "php": "^8.4",
        "capell-app/admin": "^4.0 || 4.x-dev",
        "capell-app/contacts": "^4.0 || 4.x-dev",
        "capell-app/core": "^4.0 || 4.x-dev",
        "capell-app/frontend": "^4.0 || 4.x-dev",
        "filament/filament": "^4.0|^5.0",
        "filament/support": "^4.7|^5.2",
        "laravel/framework": "^11.44.2|^12.0|^13.0",
        "lorisleiva/laravel-actions": "^2.8",
        "spatie/laravel-data": "^4.5",
        "spatie/laravel-package-tools": "^1.14.1"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^3.0|^4.1",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Capell\\LiveChat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\LiveChat\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\LiveChat\\Providers\\LiveChatServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "pest"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/live-chat"
    }
}
