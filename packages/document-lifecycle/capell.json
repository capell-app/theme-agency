{
    "manifest-version": 3,
    "name": "capell-app/document-lifecycle",
    "slug": "document-lifecycle",
    "displayName": "Document Lifecycle",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Document Lifecycle turns terms, privacy, and policy documents into auditable records: every publication is version-pinned and content-hashed, and every acceptance captures the exact version, hash, actor, and timestamp. It hooks into Publishing Studio so a published revision automatically becomes an immutable document publication — no custom audit layer required. Acceptance evidence surfaces in the admin and (with Customer Portal) in each account's self-service history, and the tables are registered as protected so the audit trail can't be casually deleted. Built for compliance-sensitive Capell sites that must answer \"which version did this user agree to, and when?\"",
    "product": {
        "group": "Capell Operations",
        "tier": "premium",
        "bundle": "operations"
    },
    "namespace": "Capell\\DocumentLifecycle",
    "surfaces": ["admin", "console", "frontend"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/publishing-studio"
        ],
        "supports": ["capell-app/customer-portal"],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [
            "Capell\\DocumentLifecycle\\Providers\\DocumentLifecycleServiceProvider"
        ],
        "runtime": [],
        "admin": [
            "Capell\\DocumentLifecycle\\Providers\\DocumentLifecycleServiceProvider"
        ],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\DocumentLifecycle\\Manifest\\DocumentResourceContribution",
            "resourceClass": "Capell\\DocumentLifecycle\\Filament\\Resources\\Documents\\DocumentResource",
            "group": "Document"
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": [
            "document_lifecycle_documents",
            "document_lifecycle_publications",
            "legal_acceptances"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [
        "ViewAny:Document",
        "View:Document",
        "Create:Document",
        "Update:Document",
        "Delete:Document",
        "DeleteAny:Document",
        "Restore:Document",
        "ForceDelete:Document",
        "Replicate:Document",
        "Reorder:Document"
    ],
    "capabilities": [
        "document-lifecycle",
        "document-lifecycle-admin",
        "document-lifecycle-acceptance",
        "document-lifecycle-customer-portal-document-feed"
    ],
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": [],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": true,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "document-lifecycle.package-health",
            "label": "Document Lifecycle package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\DocumentLifecycle\\Health\\DocumentLifecycleHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Tamper-evident proof of which document version was published and who accepted it — controlled documents, immutable hashed versions, and a court-ready acceptance ledger for Capell.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Document Lifecycle extension preview image",
                "caption": "Document Lifecycle extension preview"
            }
        ],
        "categories": ["admin", "console", "operations"]
    },
    "contributionTraceability": {
        "deferredContributions": ["model", "migration"]
    }
}
