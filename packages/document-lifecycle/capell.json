{
    "manifest-version": 3,
    "name": "capell-app/document-lifecycle",
    "slug": "document-lifecycle",
    "displayName": "Document Lifecycle",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Document Lifecycle tracks controlled documents as admin-managed records with version-labelled, content-hashed publications and acceptance history. Admin users can publish manual versions, matching Publishing Studio revisions can create publication records automatically, and acceptance records show which actor accepted which document version and when. The package also registers protected audit tables, a health diagnostic, and an authenticated Customer Portal feed for account self-service history.",
    "product": {
        "group": "Capell Operations",
        "tier": "premium",
        "bundle": "operations"
    },
    "namespace": "Capell\\DocumentLifecycle",
    "surfaces": ["admin", "console"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/publishing-studio"
        ],
        "supports": ["capell-app/customer-portal"],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [
            "Capell\\DocumentLifecycle\\Providers\\DocumentLifecycleServiceProvider"
        ],
        "runtime": [],
        "admin": [
            "Capell\\DocumentLifecycle\\Providers\\DocumentLifecycleServiceProvider"
        ],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\DocumentLifecycle\\Manifest\\DocumentResourceContribution",
            "resourceClass": "Capell\\DocumentLifecycle\\Filament\\Resources\\Documents\\DocumentResource",
            "group": "Document"
        },
        {
            "type": "scheduled-job",
            "command": "capell:document-lifecycle:archive-expired",
            "frequency": "daily"
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": [
            "document_lifecycle_documents",
            "document_lifecycle_publications",
            "legal_acceptances"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null,
        "retention": "capell:document-lifecycle:archive-expired"
    },
    "settings": [],
    "permissions": [
        "ViewAny:Document",
        "View:Document",
        "Create:Document",
        "Update:Document",
        "Delete:Document",
        "DeleteAny:Document",
        "Restore:Document",
        "ForceDelete:Document",
        "Replicate:Document",
        "Reorder:Document"
    ],
    "capabilities": [
        "document-lifecycle",
        "document-lifecycle-admin",
        "document-lifecycle-acceptance",
        "document-lifecycle-evidence-export",
        "document-lifecycle-signed-evidence",
        "document-lifecycle-reacceptance-report",
        "document-lifecycle-retention",
        "document-lifecycle-publication-diff",
        "document-lifecycle-customer-portal-document-feed"
    ],
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": [],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": true,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "document-lifecycle.package-health",
            "label": "Document Lifecycle package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\DocumentLifecycle\\Health\\DocumentLifecycleHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Version-pinned acceptance evidence for controlled documents in Capell: register documents, publish hashed versions from admin or Publishing Studio, and record who accepted which version and when.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Document Lifecycle extension preview image",
                "caption": "Document Lifecycle extension preview"
            },
            {
                "path": "docs/screenshots/controlled-documents-index.png",
                "alt": "Document Lifecycle controlled documents index in Capell admin",
                "caption": "Controlled documents index"
            },
            {
                "path": "docs/screenshots/controlled-document-edit.png",
                "alt": "Document Lifecycle controlled document edit form in Capell admin",
                "caption": "Controlled document edit form"
            },
            {
                "path": "docs/screenshots/controlled-document-publications.png",
                "alt": "Document Lifecycle publications relation manager with version and hash evidence",
                "caption": "Document publications"
            },
            {
                "path": "docs/screenshots/controlled-document-acceptances.png",
                "alt": "Document Lifecycle acceptances relation manager with actor and version evidence",
                "caption": "Document acceptances"
            }
        ],
        "categories": ["admin", "console", "operations"]
    },
    "contributionTraceability": {
        "deferredContributions": ["model", "migration"]
    }
}
