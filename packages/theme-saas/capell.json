{
    "manifest-version": 3,
    "name": "capell-app/theme-saas",
    "slug": "theme-saas",
    "displayName": "Theme Saas",
    "kind": "theme",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Theme SaaS registers the saas theme key and product-focused renderer views for software and subscription sites.",
    "product": {
        "group": "Capell Themes",
        "tier": "premium",
        "bundle": "themes"
    },
    "namespace": "Capell\\ThemeStudio\\Saas",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/foundation-theme"],
        "supports": ["capell-app/blog"],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": ["Capell\\ThemeStudio\\Saas\\SaasThemeServiceProvider"],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\ThemeStudio\\Saas\\Manifest\\ThemeManagementPageContribution",
            "pageClass": "Capell\\Marketplace\\Filament\\Pages\\ThemeExtensionPage",
            "pageParameters": {
                "themeKey": "saas"
            },
            "labelKey": "capell-marketplace::marketplace.theme_extension.management_entry_label"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:theme-saas-demo",
        "demoParams": ["url", "languages", "sites"],
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["theme-saas", "theme-saas-frontend"],
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["theme-saas"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "theme-saas.package-health",
            "label": "Theme Saas package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ThemeStudio\\Saas\\Health\\ThemeSaasHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Product workflow and activation theme screenshots from route-backed demo layouts.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Theme Saas extension preview image",
                "caption": "Theme Saas extension preview"
            },
            {
                "path": "docs/assets/marketplace/saas-blog-layout.svg",
                "alt": "Theme Saas Blog Layout image",
                "caption": "Theme Saas Blog Layout"
            },
            {
                "path": "docs/assets/marketplace/saas-campaign-layout.svg",
                "alt": "Theme Saas Campaign Layout image",
                "caption": "Theme Saas Campaign Layout"
            },
            {
                "path": "docs/assets/marketplace/saas-demo-request-layout.svg",
                "alt": "Theme Saas Demo Request Layout image",
                "caption": "Theme Saas Demo Request Layout"
            },
            {
                "path": "docs/assets/marketplace/saas-docs-layout.svg",
                "alt": "Theme Saas Docs Layout image",
                "caption": "Theme Saas Docs Layout"
            },
            {
                "path": "docs/assets/marketplace/saas-feature-layout.svg",
                "alt": "Theme Saas Feature Layout image",
                "caption": "Theme Saas Feature Layout"
            }
        ],
        "categories": ["frontend", "themes"]
    },
    "extends": "capell-app/foundation-theme",
    "themeKey": "saas"
}
